<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Query\InternalsViewer.Query.FullTrace\InternalsViewer.Query.FullTrace.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Guides\*.md" />
        <EmbeddedResource Include="..\..\docs\internalsviewer.com\docs\deep-dives\*.md"
                          LogicalName="InternalsViewer.Mcp.Guides.deep-dive-%(Filename).md"
                          Link="Guides\DeepDives\%(Filename).md" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>

</Project>
