<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
        <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.37.3" />
        <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InternalsViewer.Internals\InternalsViewer.Internals.csproj" />
        <ProjectReference Include="..\InternalsViewer.TransactionLog\InternalsViewer.TransactionLog.csproj" />
        <ProjectReference Include="..\InternalsViewer.Execution\InternalsViewer.Execution.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>


    <ItemGroup>
        <!-- Callstack category mappings: the core file ships embedded with the app (a downloadable update file may
             override it from the user's app-data folder later). Matched by file name at load, not by resource path. -->
        <EmbeddedResource Include="Mappings\*.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\runtimes\win-x64\native\*.*">
            <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Locks\**" />
      <EmbeddedResource Remove="Locks\**" />
      <None Remove="Locks\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Events\Columnstore\" />
    </ItemGroup>

</Project>
