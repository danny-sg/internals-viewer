                                       FontSize="12"
                                       Padding="0,2,0,0"
                                       Foreground="#C42B1C"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsFalsePositive,
                                               Converter={StaticResource StepsBoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>

