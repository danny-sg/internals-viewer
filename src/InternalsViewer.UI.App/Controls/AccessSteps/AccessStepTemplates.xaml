<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    xmlns:predicates="using:InternalsViewer.UI.App.Controls.Predicates"
    xmlns:accessSteps="using:InternalsViewer.UI.App.Controls.AccessSteps"
    xmlns:trace="using:InternalsViewer.UI.App.Helpers.Converters.Trace">

    <trace:AccessStepToPredicateTextConverter x:Key="AccessStepToPredicateTextConverter" />
    <trace:ProbeDirectionToTextConverter x:Key="ProbeDirectionToTextConverter" />
    <trace:SeekRuleToTextConverter x:Key="SeekRuleToTextConverter" />
    <converters:EnumToTextConverter x:Key="EnumToTextConverter" />
    <trace:ProbeStartToTextConverter x:Key="ProbeStartToTextConverter" />
    <trace:RangeEndToTextConverter x:Key="RangeEndToTextConverter" />
    <trace:ReadPageToTextConverter x:Key="ReadPageToTextConverter" />
    <trace:RowOutcomeToTextConverter x:Key="RowOutcomeToTextConverter" />
    <trace:RowEmitToVisibilityConverter x:Key="RowEmitToVisibilityConverter" />
    <trace:RowEmitTextConverter x:Key="RowEmitTextConverter" />
    <trace:LeafLinkToTextConverter x:Key="LeafLinkToTextConverter" />
    <converters:PfsAllocatedToTextConverter x:Key="PfsAllocatedToTextConverter" />
    <converters:PfsAllocatedToBrushConverter x:Key="PfsAllocatedToBrushConverter" />
    <converters:BoolToVisibilityConverter x:Key="StepsBoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="StepsInverseBoolToVisibilityConverter" IsInverse="True" />
    <trace:MergeCompareRunToTextConverter x:Key="MergeCompareRunToTextConverter" />
    <trace:HashValueToTextConverter x:Key="HashValueToTextConverter" />
    <converters:NullToVisibilityConverter x:Key="StepsNullToInverseVisibilityConverter" IsInverse="True" />

    <Style x:Key="StepLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Width" Value="80" />
    </Style>

    <Style x:Key="StepValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0,4,0" />
    </Style>

    <Style x:Key="StepPropertyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
        <Setter Property="Padding" Value="0,0,4,0" />
    </Style>

    <Style x:Key="StepDetailStyle" TargetType="predicates:PredicateTextBox">
        <Setter Property="TextPadding" Value="0,2,0,0" />
        <Setter Property="HasBackground" Value="False" />
    </Style>

    <Style x:Key="StepRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="158,4,8,4" />
    </Style>

    <!-- Drawn in the gutter the row's left padding reserves, so it lines up as a column whatever the step lays out beside it -->
    <Style x:Key="StepNodeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="126" />
    </Style>

    <DataTemplate x:Key="ReadPageTemplate" >
        <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Read Page" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="{Binding PageAddress}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="{Binding Converter={StaticResource ReadPageToTextConverter}}"
                           Style="{StaticResource StepPropertyStyle}"
                           Margin="4,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProbeStartTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Slot Count" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding SlotCount}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Rule, Converter={StaticResource SeekRuleToTextConverter}}"
                                   Style="{StaticResource StepValueStyle}" />
                        <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                     Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                        <TextBlock Text="{Binding Converter={StaticResource ProbeStartToTextConverter}}"
                                   Style="{StaticResource StepPropertyStyle}"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProbeTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <TextBlock Text="Probe" Style="{StaticResource StepLabelStyle}" />
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Slot (Mid)" Style="{StaticResource StepPropertyStyle}" />
                    <TextBlock Text="{Binding Middle}" Style="{StaticResource StepValueStyle}" />

                    <TextBlock Text="Low" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Low}" Style="{StaticResource StepValueStyle}" />

                    <TextBlock Text="High (Exclusive)" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding High}" Style="{StaticResource StepValueStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                 Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                    <TextBlock Text="{Binding SearchRight, Converter={StaticResource ProbeDirectionToTextConverter}}"
                               Style="{StaticResource StepValueStyle}"
                               Margin="8,0,0,0" />
                </StackPanel>
                <accessSteps:ProbeRangeBar Probe="{Binding}" Margin="0,4,4,1" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProbeRunTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <TextBlock Text="Probe" Style="{StaticResource StepLabelStyle}" />
            <ToggleButton x:Name="ProbeExpandToggle"
                          Grid.Column="1"
                          Padding="2"
                          Margin="0,0,6,0"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          BorderThickness="0">
                <FontIcon Glyph="&#xE70D;" FontSize="10" />
            </ToggleButton>
            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding Probes}"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsChecked, ElementName=ProbeExpandToggle,
                                  Converter={StaticResource StepsInverseBoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <accessSteps:ProbeRangeBar Probe="{Binding}" Margin="0,1,4,0" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding Probes}"
                          Visibility="{Binding IsChecked, ElementName=ProbeExpandToggle,
                                  Converter={StaticResource StepsBoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Slot (Mid)" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding Middle}" Style="{StaticResource StepValueStyle}" />

                                <TextBlock Text="Low" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Low}" Style="{StaticResource StepValueStyle}" />

                                <TextBlock Text="High (Exclusive)" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding High}" Style="{StaticResource StepValueStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <predicates:PredicateTextBox 
                                    Style="{StaticResource StepDetailStyle}"
                                    Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                                <TextBlock Text="{Binding SearchRight, Converter={StaticResource ProbeDirectionToTextConverter}}"
                                           Style="{StaticResource StepValueStyle}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <accessSteps:ProbeRangeBar Probe="{Binding}" Margin="0,4,4,1" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DescendTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Descend" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}" Width="34" />
                <TextBlock Text="{Binding Slot}" Style="{StaticResource StepValueStyle}" Width="80"/>
                <TextBlock Text="Down Page Pointer" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding ChildPage}" Style="{StaticResource StepValueStyle}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProbeResultTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Position" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Slot" Width="34" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding Slot}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Rule, Converter={StaticResource SeekRuleToTextConverter}}"
                                   Style="{StaticResource StepValueStyle}" />
                        <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                     Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RowTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Get Row" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}"/>
                <TextBlock Text="{Binding Slot}" Width="34" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Outcome" Style="{StaticResource StepPropertyStyle}" />
                <TextBlock Text="{Binding Converter={StaticResource RowOutcomeToTextConverter}}"
                           Style="{StaticResource StepValueStyle}" />
                <Border x:Name="EmitBadge"
                        Visibility="{Binding Converter={StaticResource RowEmitToVisibilityConverter}}"
                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                        CornerRadius="4"
                        Padding="6,0,6,1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="→ Emit"
                                   Foreground="White"
                                   FontSize="11" />
                        <TextBlock x:Name="EmitSideText"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RowRunTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Get Row" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="Slots" Style="{StaticResource StepPropertyStyle}" />
                <StackPanel Width="50" Orientation="Horizontal">
                    <TextBlock Text="{Binding FromSlot}" Style="{StaticResource StepValueStyle}" />
                    <TextBlock Text="-" Style="{StaticResource StepPropertyStyle}" />
                    <TextBlock Text="{Binding ToSlot}" Style="{StaticResource StepValueStyle}" />
                </StackPanel>
                <TextBlock Text="Outcome" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Converter={StaticResource RowOutcomeToTextConverter}}"
                           Style="{StaticResource StepValueStyle}" />
                <Border x:Name="EmitBadge"
                        Visibility="{Binding Converter={StaticResource RowEmitToVisibilityConverter}}"
                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                        CornerRadius="4"
                        Padding="6,0,6,1"
                        MinWidth="110"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Converter={StaticResource RowEmitTextConverter}}"
                                   Foreground="White"
                                   FontSize="11" />
                        <TextBlock x:Name="EmitSideText"
                                   Foreground="White"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RangeEndTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal"
                        Grid.ColumnSpan="9"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="5" Width="140"
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range End" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding Slot}" Width="34" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                     Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                        <TextBlock Text="{Binding Converter={StaticResource RangeEndToTextConverter}}"
                                   Style="{StaticResource StepPropertyStyle}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LeafLinkTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Next Page" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="From" Style="{StaticResource StepPropertyStyle}" />
                <TextBlock Text="{Binding FromPage}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="{Binding Converter={StaticResource LeafLinkToTextConverter}}"
                           Style="{StaticResource StepPropertyStyle}"
                           Margin="8,0,0,0" />
                <TextBlock Text="{Binding ToPage}" Style="{StaticResource StepValueStyle}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ReseekTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Reseek" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Range" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding RangeNumber}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="of" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding RangeCount}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                    <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                 Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RebindTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rebind" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Outer Row" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding RebindNumber}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="RID" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0"
                                   Visibility="{Binding RowIdentifier, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding RowIdentifier}" Style="{StaticResource StepValueStyle}"
                                   Visibility="{Binding RowIdentifier, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                 Visibility="{Binding RowIdentifier, 
                                                              Converter={StaticResource StepsNullToInverseVisibilityConverter}}"
                                                 Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="JoinStartTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal"
                        Grid.ColumnSpan="9"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="5" Width="140"
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Padding="0,8,0,8">
                <TextBlock Text="Phase" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource StepValueStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MergeCompareTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Compare" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Outer" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding OuterKey}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="Inner" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding InnerKey}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                    <accessSteps:JoinDecisionBadge Decision="{Binding Decision}" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Action}"
                                   Style="{StaticResource StepValueStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompareArrow"
                                   Text="→"
                                   Visibility="Collapsed"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="2,0,6,0"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CompareBadge"
                                Visibility="Collapsed"
                                CornerRadius="4"
                                Padding="6,0,6,1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CompareBadgeText" Foreground="White" FontSize="11" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MergeCompareRunTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <StackPanel Orientation="Horizontal" 
                        Grid.ColumnSpan="9" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top" 
                        Spacing="5" Width="140" 
                        Margin="-150,0,0,0">
                <Border x:Name="SourceBlob" Width="9" Height="9" CornerRadius="2" Margin="0,4,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="SourceName" Style="{StaticResource StepNodeStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Compare" Style="{StaticResource StepLabelStyle}" />
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Converter={StaticResource MergeCompareRunToTextConverter}}"
                               Style="{StaticResource StepValueStyle}"
                               TextWrapping="Wrap" />

                    <accessSteps:JoinDecisionBadge Decision="{Binding Decision}" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Action}"
                                   Style="{StaticResource StepValueStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompareArrow"
                                   Text="→"
                                   Visibility="Collapsed"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="2,0,6,0"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CompareBadge"
                                Visibility="Collapsed"
                                CornerRadius="4"
                                Padding="6,0,6,1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CompareBadgeText" Foreground="White" FontSize="11" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
