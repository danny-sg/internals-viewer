                                Visibility="{Binding ShowsResidual,
                                        Converter={StaticResource StepsBoolToVisibilityConverter}}">
                        <TextBlock Text="Residual" Style="{StaticResource StepPropertyStyle}" Margin="10,0,0,0" />
                        <Grid Width="16">
                            <TextBlock Text="&#xE73E;"
