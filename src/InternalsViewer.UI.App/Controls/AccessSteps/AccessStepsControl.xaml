<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.AccessSteps.AccessStepsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    xmlns:predicates="using:InternalsViewer.UI.App.Controls.Predicates"
    xmlns:accessSteps="using:InternalsViewer.UI.App.Controls.AccessSteps"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:AccessStepToPredicateTextConverter x:Key="AccessStepToPredicateTextConverter" />
            <converters:ProbeDirectionToTextConverter x:Key="ProbeDirectionToTextConverter" />
            <converters:SeekRuleToTextConverter x:Key="SeekRuleToTextConverter" />
            <converters:EnumToTextConverter x:Key="EnumToTextConverter" />
            <converters:ProbeStartToTextConverter x:Key="ProbeStartToTextConverter" />
            <converters:RangeEndToTextConverter x:Key="RangeEndToTextConverter" />
            <converters:ReadPageToTextConverter x:Key="ReadPageToTextConverter" />
            <converters:RowOutcomeToTextConverter x:Key="RowOutcomeToTextConverter" />
            <converters:RowEmitToVisibilityConverter x:Key="RowEmitToVisibilityConverter" />
            <converters:LeafLinkToTextConverter x:Key="LeafLinkToTextConverter" />

            <Style x:Key="StepLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Width" Value="80" />

            </Style>

            <Style x:Key="StepValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,0,4,0" />
            </Style>

            <Style x:Key="StepPropertyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                <Setter Property="Padding" Value="0,0,4,0" />
            </Style>

            <Style x:Key="StepDetailStyle" TargetType="predicates:PredicateTextBox">
                <Setter Property="TextPadding" Value="0,2,0,0" />
                <Setter Property="HasBackground" Value="False" />
            </Style>

            <Style x:Key="StepRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="8,4,8,4" />
            </Style>

            <DataTemplate x:Key="ReadPageTemplate" >
                <Grid Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal" Padding="0,8,0,8">
                        <TextBlock Text="Read Page" Style="{StaticResource StepLabelStyle}" Foreground="Navy" />
                        <TextBlock Text="{Binding PageAddress}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="{Binding Converter={StaticResource ReadPageToTextConverter}}"
                                   Style="{StaticResource StepPropertyStyle}"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProbeStartTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Probe Start" Style="{StaticResource StepLabelStyle}" />
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Slot Count" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding SlotCount}" Style="{StaticResource StepValueStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Rule, Converter={StaticResource SeekRuleToTextConverter}}"
                                           Style="{StaticResource StepValueStyle}" />
                                <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                             Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                                <TextBlock Text="{Binding Converter={StaticResource ProbeStartToTextConverter}}"
                                           Style="{StaticResource StepPropertyStyle}"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProbeTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Probe" Style="{StaticResource StepLabelStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Slot (Mid)" Style="{StaticResource StepPropertyStyle}" />
                            <TextBlock Text="{Binding Middle}" Style="{StaticResource StepValueStyle}" />

                            <TextBlock Text="Low" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Low}" Style="{StaticResource StepValueStyle}" />

                            <TextBlock Text="High (Exclusive)" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding High}" Style="{StaticResource StepValueStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                         Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                            <TextBlock Text="{Binding SearchRight, Converter={StaticResource ProbeDirectionToTextConverter}}"
                                       Style="{StaticResource StepValueStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <accessSteps:ProbeRangeBar Probe="{Binding}" Margin="0,4,4,1" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DescendTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Descend" Style="{StaticResource StepLabelStyle}" />
                        <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}" Width="34" />
                        <TextBlock Text="{Binding Slot}" Style="{StaticResource StepValueStyle}" Width="80"/>
                        <TextBlock Text="Down Page Pointer" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding ChildPage}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ProbeResultTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Probe Result" Style="{StaticResource StepLabelStyle}" />
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Slot" Width="34" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding Slot}" Style="{StaticResource StepValueStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Rule, Converter={StaticResource SeekRuleToTextConverter}}"
                                           Style="{StaticResource StepValueStyle}" />
                                <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                             Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RowTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Row" Style="{StaticResource StepLabelStyle}" />
                        <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}"/>
                        <TextBlock Text="{Binding Slot}" Width="34" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="Outcome" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding Converter={StaticResource RowOutcomeToTextConverter}}"
                                   Style="{StaticResource StepValueStyle}" />
                        <Border Visibility="{Binding Converter={StaticResource RowEmitToVisibilityConverter}}"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderBrush="#0B5D0B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,0,6,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="→ Emit"
                                       Foreground="White"
                                       FontSize="11" />
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RangeEndTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Range End" Style="{StaticResource StepLabelStyle}" />
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Slot" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding Slot}" Width="34" Style="{StaticResource StepValueStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                             Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                                <TextBlock Text="{Binding Converter={StaticResource RangeEndToTextConverter}}"
                                           Style="{StaticResource StepPropertyStyle}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LeafLinkTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Leaf Link" Style="{StaticResource StepLabelStyle}" />
                        <TextBlock Text="From" Style="{StaticResource StepPropertyStyle}" />
                        <TextBlock Text="{Binding FromPage}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="{Binding Converter={StaticResource LeafLinkToTextConverter}}"
                                   Style="{StaticResource StepPropertyStyle}"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding ToPage}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ReseekTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Reseek" Style="{StaticResource StepLabelStyle}" Foreground="Navy" />
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Range" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding RangeNumber}" Style="{StaticResource StepValueStyle}" />
                                <TextBlock Text="of" Style="{StaticResource StepPropertyStyle}" />
                                <TextBlock Text="{Binding RangeCount}" Style="{StaticResource StepValueStyle}" />
                            </StackPanel>
                            <predicates:PredicateTextBox Style="{StaticResource StepDetailStyle}"
                                                         Text="{Binding Converter={StaticResource AccessStepToPredicateTextConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="StoppedTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Stopped" Style="{StaticResource StepLabelStyle}" />
                        <TextBlock Text="{Binding Reason, Converter={StaticResource EnumToTextConverter}}"
                                   Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TruncatedTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.6">
                        <TextBlock Text="{Binding Count}" FontSize="12" />
                        <TextBlock Text=" steps omitted" FontSize="12" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DefaultTemplate" >
                <Grid Style="{StaticResource StepRowStyle}">
                    <TextBlock Text="{Binding}" Style="{StaticResource StepValueStyle}" />
                </Grid>
            </DataTemplate>

            <selectors:AccessStepTemplateSelector
                x:Key="AccessStepTemplateSelector"
                ReadPageTemplate="{StaticResource ReadPageTemplate}"
                ProbeStartTemplate="{StaticResource ProbeStartTemplate}"
                ProbeTemplate="{StaticResource ProbeTemplate}"
                DescendTemplate="{StaticResource DescendTemplate}"
                ProbeResultTemplate="{StaticResource ProbeResultTemplate}"
                RowTemplate="{StaticResource RowTemplate}"
                RangeEndTemplate="{StaticResource RangeEndTemplate}"
                LeafLinkTemplate="{StaticResource LeafLinkTemplate}"
                ReseekTemplate="{StaticResource ReseekTemplate}"
                StoppedTemplate="{StaticResource StoppedTemplate}"
                TruncatedTemplate="{StaticResource TruncatedTemplate}"
                DefaultTemplate="{StaticResource DefaultTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="StepsScroller"
                  Background="{x:Bind Background, Mode=OneWay}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ItemsRepeater x:Name="StepsList"
                       ItemsSource="{x:Bind StepHistory, Mode=OneWay}"
                       ItemTemplate="{StaticResource AccessStepTemplateSelector}" />
    </ScrollViewer>
</UserControl>
