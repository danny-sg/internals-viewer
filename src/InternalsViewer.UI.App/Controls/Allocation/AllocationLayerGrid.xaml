<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Allocation.AllocationLayerGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:InternalsViewer.UI.App.Models"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:system="using:System"
    x:Name="Root"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0"
                    Margin="0"
                    IsOpen="True"
                    IsSticky="True"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
            <AppBarElementContainer>
                <TextBox Width="200" Margin="0 8 10 0"
                         PlaceholderText="Filter"
                         Text="{x:Bind ViewModel.Filter, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </AppBarElementContainer>
        </CommandBar>
        <Grid Grid.Row="1">
            <tableView:TableView x:Name="LayerTable"
                                 AutoGenerateColumns="False"
                                 CanSortColumns="True"
                                 CanFilterColumns="False"
                                 CornerButtonMode="None"
                                 HeadersVisibility="Columns"
                                 ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                                 CellStyle="{StaticResource TableViewCellStyle}"
                                 ItemContainerStyle="{StaticResource TableViewRowStyle}"
                                 RowHeight="32"
                                 SelectionMode="Extended"
                                 SelectionUnit="Row"
                                 IsReadOnly="True"
                                 GridLinesVisibility="Vertical"
                                 PointerPressed="LayerTable_OnPointerPressed"
                                 Sorting="LayerTable_OnSorting"
                                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                                 ItemsSource="{x:Bind ViewModel.DataSource, Mode=OneWay}">

                <tableView:TableView.Resources>
                    <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
                </tableView:TableView.Resources>

                <tableView:TableView.ItemContainerTransitions>
                    <TransitionCollection />
                </tableView:TableView.ItemContainerTransitions>

                <tableView:TableView.Columns>
                    <tableView:TableViewTemplateColumn Header="Key"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid>
                                    <Rectangle Width="16"
                                               Height="16"
                                               Fill="{x:Bind Colour, Mode=OneWay, Converter={StaticResource ColorToSolidColorBrushValueConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>

                    <tableView:TableViewTextColumn Header="Object Name"
                                                   Tag="ObjectName"
                                                   Binding="{Binding ObjectName}"/>
                    <tableView:TableViewTextColumn Header="Index Name"
                                                   Tag="IndexName"
                                                   Binding="{Binding IndexName}"/>
                    <tableView:TableViewTextColumn Header="Index Type"
                                                   Tag="IndexTypeDescription"
                                                   Binding="{Binding IndexTypeDescription}"/>
                    <tableView:TableViewTemplateColumn Header="Page Count"
                                                       Tag="TotalPages">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid>
                                    <TextBlock Text="{x:Bind TotalPages, Mode=OneWay}"
                                               Margin="0,0,10,0"
                                               TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Root Page"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid>
                                    <HyperlinkButton Content="{x:Bind RootPage, Mode=OneWay}"
                                                     Click="HyperlinkButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind RootPage}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="First Page"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid>
                                    <HyperlinkButton Content="{x:Bind FirstPage, Mode=OneWay}"
                                                     Click="HyperlinkButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind FirstPage}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="First IAM Page"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid>
                                    <HyperlinkButton Content="{x:Bind FirstIamPage, Mode=OneWay}"
                                                     Click="HyperlinkButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind FirstIamPage}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>

                    <tableView:TableViewTemplateColumn Header="Index"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:AllocationLayer">
                                <Grid HorizontalAlignment="Center">
                                    <HyperlinkButton Content="View"
                                                     Visibility="{x:Bind IsIndex, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Click="ViewIndexButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind RootPage}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                </tableView:TableView.Columns>
            </tableView:TableView>
        </Grid>
    </Grid>
</UserControl>
