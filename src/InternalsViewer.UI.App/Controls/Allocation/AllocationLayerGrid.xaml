<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Allocation.AllocationLayerGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:system="using:System"
    x:Name="Root"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Border BorderThickness="0,1,0,1"   
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <AutoSuggestBox x:Name="SearchBox"
                            Margin="0"
                            PlaceholderText="Search"
                            QueryIcon="Find"
                            BorderThickness="0"
                            FontSize="12"
                            Padding="0,4,0,0"
                            Height="32"
                            Text="{x:Bind ViewModel.Filter, Mode=TwoWay}"/>
            </Border>
        </StackPanel>
       
        <Grid Grid.Row="1">
            <tableView:TableView x:Name="LayerTable"
                                 AutoGenerateColumns="False"
                                 CanSortColumns="True"
                                 CanFilterColumns="False"
                                 CornerButtonMode="None"
                                 HeadersVisibility="Columns"
                                 ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                                 CellStyle="{StaticResource TableViewCellStyle}"
                                 ItemContainerStyle="{StaticResource TableViewRowStyle}"
                                 RowHeight="32"
                                 SelectionMode="Extended"
                                 SelectionUnit="Row"
                                 IsReadOnly="True"
                                 AllowLiveShaping="False"
                                 GridLinesVisibility="Vertical"
                                 BorderThickness="0"
                                 Sorting="LayerTable_OnSorting"
                                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                                 ItemsSource="{x:Bind ViewModel.DataSource, Mode=OneWay}">

                <tableView:TableView.Resources>
                    <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
                </tableView:TableView.Resources>


                <tableView:TableView.Columns>
                    <tableView:TableViewTemplateColumn Header="Key"
                                                       Width="48"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <Rectangle Width="16"
                                           Height="16"
                                           Visibility="{x:Bind KeyVisibility}"
                                           Fill="{x:Bind Layer.Colour, Mode=OneWay, Converter={StaticResource ColorToSolidColorBrushValueConverter}}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>

                    <tableView:TableViewTemplateColumn Header="Object Name"
                                                       Width="220"
                                                       Tag="ObjectName">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <StackPanel Orientation="Horizontal"
                                            Margin="{x:Bind Indent}"
                                            VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Button Click="ExpanderButton_Click"
                                                Visibility="{x:Bind ExpanderVisibility}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                MinWidth="16" Width="16" MinHeight="16" Height="16">
                                            <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ObjectName}"
                                               Margin="4,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Index Name"
                                                       Width="240"
                                                       Tag="IndexName">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <TextBlock Text="{x:Bind IndexName}"
                                           Margin="{x:Bind TextMargin}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Type"
                                                       Width="160"
                                                       Tag="IndexTypeDescription">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <TextBlock Text="{x:Bind TypeDescription}"
                                           Margin="{x:Bind TextMargin}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Page Count"
                                                       Width="100"
                                                       Tag="TotalPages"
                                                       SortMemberPath="TotalPages">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <TextBlock Text="{x:Bind TotalPages}"
                                           Margin="0,0,10,0"
                                           TextAlignment="Right"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Root Page"
                                                       Width="100"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <HyperlinkButton Content="{x:Bind RootPage}"
                                                 Visibility="{x:Bind HasEntryPoints, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Click="HyperlinkButton_Click"
                                                 Style="{StaticResource CellPageAddressStyle}"
                                                 Tag="{x:Bind RootPage}"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="First Page"
                                                       Width="100"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <HyperlinkButton Content="{x:Bind FirstPage}"
                                                 Visibility="{x:Bind HasEntryPoints, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Click="HyperlinkButton_Click"
                                                 Style="{StaticResource CellPageAddressStyle}"
                                                 Tag="{x:Bind FirstPage}"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="First IAM Page"
                                                       Width="120"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <HyperlinkButton Content="{x:Bind FirstIamPage}"
                                                 Visibility="{x:Bind HasEntryPoints, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Click="HyperlinkButton_Click"
                                                 Style="{StaticResource CellPageAddressStyle}"
                                                 Tag="{x:Bind FirstIamPage}"/>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>

                    <tableView:TableViewTemplateColumn Header="Index"
                                                       Width="100"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <Grid HorizontalAlignment="Center">
                                    <HyperlinkButton Content="View"
                                                     Visibility="{x:Bind IsIndex, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Click="ViewIndexButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind RootPage}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>

                    <tableView:TableViewTemplateColumn Header="Columnstore"
                                                       Width="100"
                                                       CanSort="False">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="allocation:AllocationLayerRow">
                                <Grid HorizontalAlignment="Center">
                                    <HyperlinkButton Content="View"
                                                     Visibility="{x:Bind IsColumnstore, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Click="ViewColumnstoreButton_Click"
                                                     Style="{StaticResource CellPageAddressStyle}"
                                                     Tag="{x:Bind AllocationUnitId}"/>
                                </Grid>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                </tableView:TableView.Columns>
            </tableView:TableView>
        </Grid>
    </Grid>
</UserControl>
