<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Allocation.AllocationUnitSummaryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    mc:Ignorable="d">
    <Grid Margin="8" Padding="2" RowSpacing="4" ColumnSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <TextBlock x:Name="ObjectNameTextBlock"
                       FontWeight="{x:Bind ObjectNameFontWeight, Mode=OneWay}"
                       Margin="0,0,10,0"
                       Text="{x:Bind ObjectName, Mode=OneWay}" />
            <Grid
                Margin="0"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
                <TextBlock x:Name="ObjectIndexTypeTextBlock"
                           Margin="0"
                           Foreground="BlueViolet"
                           Text="{x:Bind ObjectIndexType, Mode=OneWay}" />
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0">
            <TextBlock x:Name="IndexNameTextBlock"
                       FontWeight="{x:Bind IndexNameFontWeight, Mode=OneWay}"
                       Margin="0,0,10,0"
                       Text="{x:Bind IndexName, Mode=OneWay}" />
            <Grid Margin="0"
                  Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
                <TextBlock x:Name="IndexTypeTextBlock"
                           Margin="0"
                           Foreground="DarkGreen"
                           Text="{x:Bind IndexType, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ObjectIdNameTextBlock"
                   Margin="14,0,0,0"
                   Grid.Row="0"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="Object Id" />

        <TextBlock x:Name="IndexIdNameTextBlock"
                   Margin="14,0,0,0"
                   Grid.Row="1"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="Index Id" />

        <TextBlock Margin="14,0,0,0"
                   Grid.Row="2"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="Allocation Unit Id" />

        <TextBlock Margin="14,0,0,0"
                   Grid.Row="3"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="Partition Id" />

        <TextBlock Margin="14,0,0,0"
                   Grid.Row="4"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="Root Page" />

        <TextBlock Margin="14,0,0,0"
                   Grid.Row="5"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="First Page" />

        <TextBlock Margin="14,0,0,0"
                   Grid.Row="6"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Grid.Column="1"
                   Text="First IAM Page" />

        <controls:CopyTextBlock
                       x:Name="ObjectIdTextBlock"
                       Margin="14,0,0,0"
                       Grid.Row="0"
                       Grid.Column="2"
                       Value="{x:Bind ObjectId, Mode=OneWay}" />

        <controls:CopyTextBlock
                       Margin="14,0,0,0"
                       Grid.Row="1"
                       Grid.Column="2"
                       Value="{x:Bind IndexId, Mode=OneWay}" />

        <controls:CopyTextBlock Margin="14,0,0,0"
                                Grid.Row="2"
                                Grid.Column="2"
                                Value="{x:Bind AllocationUnit.AllocationUnitId, Mode=OneWay}" />

        <controls:CopyTextBlock Margin="14,0,0,0"
                                Grid.Row="3"
                                Grid.Column="2"
                                Value="{x:Bind AllocationUnit.PartitionId, Mode=OneWay}" />

        <HyperlinkButton Grid.Row="4"
                         HorizontalAlignment="Left"
                         Grid.Column="2"
                         Padding="0"
                         Margin="18,0,0,0"
                         Style="{StaticResource PageAddressStyle}"
                         Content="{x:Bind AllocationUnit.RootPage, Mode=OneWay}" />
        <HyperlinkButton Grid.Row="5"
                         Padding="0"
                         Margin="18,0,0,0"
                         HorizontalAlignment="Left"
                         Grid.Column="2"
                         Style="{StaticResource PageAddressStyle}"
                         Content="{x:Bind AllocationUnit.FirstPage, Mode=OneWay}" />
        <HyperlinkButton Grid.Row="6"
                         Padding="0"
                         Margin="18,0,0,0"
                         HorizontalAlignment="Left"
                         Grid.Column="2"
                         Style="{StaticResource PageAddressStyle}"
                         Content="{x:Bind AllocationUnit.FirstIamPage, Mode=OneWay}" />
    </Grid>
</UserControl>
