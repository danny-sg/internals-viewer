<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.CallStack.CallSearchBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="0,0,8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Column="0"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                        BorderThickness="0"
                        FontSize="12"
                        Height="28"
                        TextChanged="OnSearchTextChanged"
                        QuerySubmitted="OnSearchQuerySubmitted"/>

        <TextBlock Grid.Column="1"
                   Margin="8,2,0,0"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="{x:Bind GetMatchCountText(MatchCount), Mode=OneWay}"
                   Visibility="{x:Bind GetMatchCountVisibility(MatchCount), Mode=OneWay}"/>

        <ContentPresenter Grid.Column="2"
                          Margin="4,2,0,0"
                          VerticalAlignment="Center"
                          Content="{x:Bind Commands, Mode=OneWay}"
                          Visibility="{x:Bind GetCommandsVisibility(Commands), Mode=OneWay}"/>
    </Grid>
</UserControl>
