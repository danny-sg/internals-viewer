<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.CallStack.CallStackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:signatures="using:InternalsViewer.UI.App.Models.Query.CallStack.Signatures"
    xmlns:stack="using:InternalsViewer.UI.App.Models.Query.CallStack.Stack"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors">

    <UserControl.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>

        <Style x:Key="ValueCopyButtonStyle" TargetType="controls:CopyButton" BasedOn="{StaticResource DefaultCopyButtonStyle}">
            <Setter Property="Content" Value="&#xE8C8;"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="MemoryButtonStyle" TargetType="Button" BasedOn="{StaticResource TabCommandButtonStyle}">
            <Setter Property="Padding" Value="6,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="ToolTipService.ToolTip" Value="Show Memory"/>
        </Style>

        <MenuFlyout x:Key="CallMenu">
            <MenuFlyoutItem Text="Open In Call Tree" Click="OnOpenInCallTreeClick"/>
            <MenuFlyoutItem Text="Zoom" Click="OnZoomClick"/>
            <MenuFlyoutItem Text="Scope" Click="OnScopeClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutSubItem Text="Copy">
                <MenuFlyoutItem Text="Copy Signature" Click="OnCopySignatureClick"/>
                <MenuFlyoutItem Text="Copy Symbol" Click="OnCopySymbolClick"/>
                <MenuFlyoutItem Text="Copy Address" Click="OnCopyAddressClick"/>
            </MenuFlyoutSubItem>
        </MenuFlyout>

        <DataTemplate x:Key="ThreadTemplate" x:DataType="muxc:TreeViewNode">
            <TextBlock Text="{x:Bind ((stack:PlayheadThreadRow)Content).Label}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="CallTemplate" x:DataType="muxc:TreeViewNode">
            <Grid Padding="0,3,0,3"
                  RightTapped="OnCallRowRightTapped"
                  ContextFlyout="{StaticResource CallMenu}"
                  Background="{x:Bind callStack:CallStackControl.RowBackground(((stack:PlayheadCallRow)Content).IsCurrent)}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#x2192;"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind ((stack:PlayheadCallRow)Content).CurrentText}"
                           Visibility="{x:Bind ((stack:PlayheadCallRow)Content).IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Ellipse Grid.Column="1"
                         Width="8"
                         Height="8"
                         Margin="0,6,6,6"
                         VerticalAlignment="Center"
                         Fill="{x:Bind ((stack:PlayheadCallRow)Content).Node.CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                         ToolTipService.ToolTip="{x:Bind ((stack:PlayheadCallRow)Content).Node.Category}"/>

                <callStack:CallSignatureLine Grid.Column="2"
                                             TextSize="12"
                                             Parts="{x:Bind ((stack:PlayheadCallRow)Content).Signature}"
                                             HighlightedPart="{x:Bind ((stack:PlayheadCallRow)Content).Highlighted, Mode=OneWay}"
                                             ValueSelected="OnValueSelected"
                                             MemorySelected="OnSignatureMemorySelected"/>

                <controls:CopyButton Grid.Column="3"
                                     Style="{StaticResource ValueCopyButtonStyle}"
                                     VerticalAlignment="Center"
                                     Tapped="OnCopyTapped"
                                     Click="OnCopyRowSignatureClick"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArgumentTemplate" x:DataType="signatures:CallSignaturePart">
            <Grid ColumnSpacing="8"
                  Padding="0,1,0,1"
                  Background="Transparent"
                  Tapped="OnArgumentTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind callStack:CallStackControl.ArgumentLabel(Label, Location)}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Grid Grid.Column="1" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               callStack:SignatureRuns.Argument="{x:Bind}"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource MemoryButtonStyle}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsMemoryTracked, Converter={StaticResource BoolToVisibilityConverter}}"
                            Tapped="OnMemoryTapped"
                            Click="OnMemoryClick">
                        <FontIcon Glyph="&#xE950;" FontSize="12"/>
                    </Button>
                </Grid>

                <controls:CopyButton Grid.Column="2"
                                     Style="{StaticResource ValueCopyButtonStyle}"
                                     Tapped="OnCopyTapped"
                                     Click="OnCopyArgumentClick"/>
            </Grid>
        </DataTemplate>

        <MenuFlyout x:Key="SourceStepMenu">
            <MenuFlyoutItem Text="Go To" Click="OnSourceGoToClick"/>
        </MenuFlyout>

        <MenuFlyout x:Key="SourceFrameMenu">
            <MenuFlyoutItem Text="Go To" Click="OnSourceFrameGoToClick"/>
        </MenuFlyout>

        <DataTemplate x:Key="SourceStepTemplate" x:DataType="stack:SourceStep">
            <StackPanel Margin="{x:Bind Indent}">
                <Grid MinHeight="22"
                      Background="Transparent"
                      Tapped="{x:Bind Toggle}"
                      PointerEntered="OnSourceStepPointerEntered"
                      PointerExited="OnSourcePointerExited"
                      RightTapped="OnSourceStepRightTapped"
                      ContextFlyout="{StaticResource SourceStepMenu}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind ExpanderVisibility}"/>

                    <Border Grid.Column="1"
                            Width="14"
                            Height="14"
                            CornerRadius="7"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                            ToolTipService.ToolTip="{x:Bind CreationText}"
                            Visibility="{x:Bind IsCreation, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="8"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Margin="4,0,0,0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               callStack:SignatureRuns.Step="{x:Bind}"/>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind VisibleStack, Mode=OneWay}" Margin="20,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="stack:SourceFrame">
                            <Grid Background="Transparent"
                                  PointerEntered="OnSourceFramePointerEntered"
                                  PointerExited="OnSourcePointerExited"
                                  RightTapped="OnSourceFrameRightTapped"
                                  ContextFlyout="{StaticResource SourceFrameMenu}">
                                <TextBlock FontSize="12"
                                           Margin="0,1,0,1"
                                           TextTrimming="CharacterEllipsis"
                                           callStack:SignatureRuns.Function="{x:Bind Symbol}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="StackItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="muxc:TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Margin="{ThemeResource TreeViewItemPresenterMargin}"
                              Padding="{ThemeResource TreeViewItemPresenterPadding}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Width="3"
                                       Height="16"
                                       Fill="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                                       Opacity="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       RadiusX="2"
                                       RadiusY="2"/>

                            <Grid x:Name="MultiSelectGrid"
                                  Grid.Column="1"
                                  Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ExpandCollapseChevron"
                                      Grid.Column="0"
                                      Opacity="{TemplateBinding GlyphOpacity}"
                                      Background="Transparent">
                                    <TextBlock x:Name="CollapsedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Height="12"
                                               Padding="6,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding CollapsedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ExpandedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Height="12"
                                               Padding="6,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding ExpandedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <selectors:PlayheadStackTemplateSelector x:Key="StackTemplateSelector"
                                                 ThreadTemplate="{StaticResource ThreadTemplate}"
                                                 CallTemplate="{StaticResource CallTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StackColumn" Width="*"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <muxc:TreeView x:Name="StackTree"
                       Grid.Column="0"
                       ItemTemplateSelector="{StaticResource StackTemplateSelector}"
                       SelectionMode="Single"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Expanding="OnStackTreeExpanding"
                       Collapsed="OnStackTreeCollapsed"
                       ItemInvoked="OnStackTreeItemInvoked"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollMode="Enabled"
                       ItemContainerStyle="{StaticResource StackItemStyle}"/>

        <TextBlock Grid.Column="0"
                   Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind IsEmpty(ViewModel.Threads), Mode=OneWay}"/>

        <toolkit:GridSplitter x:Name="DetailsSplitter"
                              Grid.Column="1"
                              Width="4"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed"/>

        <Grid x:Name="DetailsPane"
              Grid.Column="2"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Padding="12,6,4,6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <TextBlock x:Name="DetailsTitle"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="12"
                           Margin="0,0,28,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource TabCommandButtonStyle}"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Close"
                        Click="OnCloseDetailsClick">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="12,8,12,8" Spacing="4" VerticalAlignment="Top">
                    <Grid ColumnSpacing="12"
                          RowSpacing="4"
                          Visibility="{x:Bind IsFunctionVisible(ViewModel.SelectedCall, ViewModel.SelectedValue), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Category" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Center"/>
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Padding="5,2,5,3"
                                Background="{x:Bind CategoryBrush(ViewModel.SelectedCall), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCall.Node.Category, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <controls:CopyButton Grid.Row="0"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind ViewModel.SelectedCall.Node.Category, Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="1" Text="Module" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind ViewModel.SelectedCall.Node.Frame.Module, Mode=OneWay}"/>
                        <controls:CopyButton Grid.Row="1"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind ViewModel.SelectedCall.Node.Frame.Module, Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="2"
                                   Text="This"
                                   Style="{StaticResource DetailLabelStyle}"
                                   Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}"/>
                        <Grid Grid.Row="2"
                              Grid.Column="1"
                              ColumnSpacing="4"
                              Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       controls:HexText.Text="{x:Bind ThisText(ViewModel.SelectedCall), Mode=OneWay}"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource MemoryButtonStyle}"
                                    Tag="{x:Bind ViewModel.SelectedCall.This, Mode=OneWay}"
                                    Visibility="{x:Bind IsMemoryVisible(ViewModel.SelectedCall.This), Mode=OneWay}"
                                    Click="OnMemoryClick">
                                <FontIcon Glyph="&#xE950;" FontSize="12"/>
                            </Button>
                        </Grid>
                        <controls:CopyButton Grid.Row="2"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind ThisText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="3" Text="Returns" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   controls:HexText.Text="{x:Bind ReturnText(ViewModel.SelectedCall), Mode=OneWay}"
                                   ToolTipService.ToolTip="Returned after the playhead"/>
                        <controls:CopyButton Grid.Row="3"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind ReturnText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="4" Text="Position" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind PositionText(ViewModel.SelectedCall), Mode=OneWay}"/>
                        <controls:CopyButton Grid.Row="4"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind PositionText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="5" Text="Start" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind StartText(ViewModel.SelectedCall), Mode=OneWay}"/>
                        <controls:CopyButton Grid.Row="5"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind StartText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="6" Text="End" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="6"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind EndText(ViewModel.SelectedCall), Mode=OneWay}"/>
                        <controls:CopyButton Grid.Row="6"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind EndText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="7" Text="Instructions" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="7"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind InstructionsText(ViewModel.SelectedCall), Mode=OneWay}"/>
                        <controls:CopyButton Grid.Row="7"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind InstructionsText(ViewModel.SelectedCall), Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="8"
                                   Text="Arguments"
                                   Style="{StaticResource DetailLabelStyle}"
                                   Margin="0,1,0,0"
                                   VerticalAlignment="Top"
                                   Visibility="{x:Bind AreArgumentsVisible(ViewModel.SelectedCall), Mode=OneWay}"/>
                        <ItemsControl Grid.Row="8"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      ItemsSource="{x:Bind ViewModel.SelectedCall.Arguments, Mode=OneWay}"
                                      ItemTemplate="{StaticResource ArgumentTemplate}"
                                      Visibility="{x:Bind AreArgumentsVisible(ViewModel.SelectedCall), Mode=OneWay}"/>
                    </Grid>

                    <Grid ColumnSpacing="12"
                          RowSpacing="4"
                          Visibility="{x:Bind IsVisible(ViewModel.SelectedValue), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock x:Name="ValueTypeText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"/>
                        <controls:CopyButton x:Name="ValueTypeCopyButton"
                                             Grid.Row="0"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="1" Text="Value" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"
                                   Text="{x:Bind ViewModel.SelectedValue.Text, Mode=OneWay}"
                                   FontFamily="{StaticResource MonospaceFontFamily}"/>
                        <controls:CopyButton Grid.Row="1"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Tag="{x:Bind ViewModel.SelectedValue.Text, Mode=OneWay}"
                                             Click="OnCopyValueClick"/>

                        <TextBlock Grid.Row="2" Text="Decoded" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock x:Name="ValueDecodedText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Style="{StaticResource DetailValueStyle}"/>
                        <controls:CopyButton x:Name="ValueDecodedCopyButton"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Style="{StaticResource ValueCopyButtonStyle}"
                                             Click="OnCopyValueClick"/>
                    </Grid>

                    <TextBlock Text="Source"
                               Style="{StaticResource DetailLabelStyle}"
                               Margin="0,8,0,0"
                               Visibility="{x:Bind IsSourceVisible(ViewModel.Source), Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Source, Mode=OneWay}"
                                  ItemTemplate="{StaticResource SourceStepTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
