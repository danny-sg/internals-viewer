<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Columnstore.BitPackDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skiaSharp="using:SkiaSharp.Views.Windows"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="0"
                   Grid.RowSpan="3"
                   Margin="12"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="Select a unit to see the values packed into it"/>

        <StackPanel Grid.Row="0" Grid.RowSpan="3"  Visibility="Collapsed">
            <TextBlock x:Name="UnitText"
                       Margin="12,8,12,4"
                      />
        </StackPanel>

        <skiaSharp:SKXamlCanvas x:Name="RulerCanvas"
                                Grid.Row="1"
                                Height="82"
                                Visibility="Collapsed"
                                IgnorePixelScaling="True"
                                HorizontalAlignment="Stretch"/>

        <Popup x:Name="BitTooltip"
               Grid.Row="1"
               ShouldConstrainToRootBounds="False">
            <Border CornerRadius="1"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.95"/>
                </Border.Background>
                <TextBlock x:Name="BitTooltipText"
                           Padding="6,3"
                           Style="{StaticResource TooltipValueStyle}"/>
            </Border>
        </Popup>

        <tableView:TableView x:Name="ValueTable"
                             Grid.Row="2"
                             Visibility="Collapsed"
                             AutoGenerateColumns="False"
                             CanSortColumns="False"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="28"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             BorderThickness="1"
                             CornerRadius="0"
                             Margin="8"
                             SelectionChanged="ValueTable_OnSelectionChanged"
                             Background="{ThemeResource LayerFillColorDefaultBrush}">
            <tableView:TableView.ItemContainerTransitions>
                <TransitionCollection />
            </tableView:TableView.ItemContainerTransitions>
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Index" Width="90"
                                               Binding="{Binding Index}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Bits" Width="80"
                                               Binding="{Binding BitRange}"/>
                <tableView:TableViewTextColumn Header="Packed Value" Width="110"
                                               Binding="{Binding Packed}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTemplateColumn Header="Data Id" Width="340">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:ValueDerivationControl Derivation="{Binding Derivation}"
                                                             ShowSteps="{Binding ShowDerivation}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTemplateColumn Header="Value" Width="340">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:ValueDerivationControl Derivation="{Binding ValueDerivation}"
                                                             ShowSteps="{Binding ShowDerivation}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
            </tableView:TableView.Columns>
        </tableView:TableView>
    </Grid>
</UserControl>
