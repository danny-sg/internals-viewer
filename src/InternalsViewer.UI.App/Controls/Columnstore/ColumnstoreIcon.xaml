<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Columnstore.ColumnstoreIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="32"
    Height="32"
    mc:Ignorable="d">
    <Border Padding="2">
        <Viewbox>
            <Canvas Width="32" Height="32">
                <Rectangle x:Name="LeftBar" Canvas.Left="0" Canvas.Top="0" Width="8" Height="16"/>
                <Rectangle x:Name="MiddleBar" Canvas.Left="12" Canvas.Top="0" Width="8" Height="32"/>
                <Rectangle x:Name="RightBar" Canvas.Left="24" Canvas.Top="0" Width="8" Height="22"/>
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
