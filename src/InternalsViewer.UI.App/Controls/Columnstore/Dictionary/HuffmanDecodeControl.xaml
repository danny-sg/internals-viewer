<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Columnstore.Dictionary.HuffmanDecodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skiaSharp="using:SkiaSharp.Views.Windows"
    SizeChanged="UserControl_SizeChanged"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <skiaSharp:SKXamlCanvas x:Name="WalkCanvas"
                                Grid.Row="0"
                                IgnorePixelScaling="True"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"/>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="0"
                   Margin="12"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="Select an entry to see the data is decoded"/>

        <ScrollBar x:Name="HorizontalScrollBar"
                   Grid.Row="1"
                   Orientation="Horizontal"
                   Minimum="0"
                   Maximum="0"
                   Value="0"
                   IndicatorMode="MouseIndicator"
                   Scroll="ScrollBar_OnScroll"/>
    </Grid>
</UserControl>
