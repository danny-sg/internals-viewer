<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Columnstore.SegmentRegionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="using:InternalsViewer.UI.App.Controls.Page"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{x:Bind DetailHeight, Mode=OneWay}" MinHeight="0"/>
        </Grid.RowDefinitions>

        <page:MarkerTreeView Grid.Row="0"
                             Opacity="{x:Bind MarkerOpacity, Mode=OneWay}"
                             Markers="{x:Bind Markers, Mode=OneWay}"
                             SelectedMarker="{x:Bind SelectedMarker, Mode=TwoWay}"/>

        <controls:GridSplitter Grid.Row="1"
                               Height="8"
                               HorizontalAlignment="Stretch"
                               ResizeBehavior="BasedOnAlignment"
                               Visibility="{x:Bind HasDetail, Mode=OneWay}"/>

        <ContentPresenter Grid.Row="2"
                          Content="{x:Bind Detail, Mode=OneWay}"/>
    </Grid>
</UserControl>
