<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Columnstore.Structure.ColumnstoreStructureControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skiaSharp="using:SkiaSharp.Views.Windows"
    xmlns:columnstore="using:InternalsViewer.UI.App.Controls.Columnstore"
    SizeChanged="UserControl_SizeChanged"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel IsHitTestVisible="False">
            <Border x:Name="PanelProbe"
                    Width="0"
                    Height="0"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
            <Border x:Name="BandProbe" Width="0" Height="0" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"/>
            <Border x:Name="HoverBandProbe" Width="0" Height="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
            <Border x:Name="KeywordProbe" Width="0" Height="0" Background="{ThemeResource SqlKeywordBrush}"/>
            <Border x:Name="NumberProbe" Width="0" Height="0" Background="{ThemeResource SqlNumberBrush}"/>
            <Border x:Name="PunctuationProbe" Width="0" Height="0" Background="{ThemeResource SqlPunctuationBrush}"/>
        </StackPanel>

        <skiaSharp:SKXamlCanvas x:Name="StructureCanvas"
                                Grid.Column="0"
                                IgnorePixelScaling="True"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"/>
        <columnstore:ColumnstoreTooltip x:Name="Tooltip" Grid.Column="0"/>

        <ScrollBar x:Name="VerticalScrollBar"
                   Grid.Column="1"
                   Orientation="Vertical"
                   Maximum="0"
                   Minimum="0"
                   Value="0"
                   IndicatorMode="MouseIndicator"
                   Scroll="ScrollBar_OnScroll"/>
    </Grid>
</UserControl>
