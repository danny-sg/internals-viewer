<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.EventGrid.EventGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"

    xmlns:eventGrid="using:InternalsViewer.UI.App.Controls.EventGrid"
    x:Name="Root"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        FontSize="12"
                        Height="28"
                        BorderThickness="0"
                        TextChanged="OnSearchTextChanged"/>

        <toolkit:DataGrid x:Name="DataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          Sorting="OnSorting"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          GridLinesVisibility="Vertical"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
            <toolkit:DataGrid.Columns>

                <toolkit:DataGridTemplateColumn Header="Event" Tag="Event">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <StackPanel Orientation="Horizontal" Margin="{x:Bind Indent, Mode=OneTime}" VerticalAlignment="Center">
                                <Button Click="OnExpanderClick"
                                        Visibility="{x:Bind ExpanderVisibility, Mode=OneTime}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        MinWidth="16" Width="16" MinHeight="16" Height="16"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10"/>
                                </Button>
                                <TextBlock Text="{x:Bind Event.Name, Mode=OneTime}"
                                           Margin="4,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

                <toolkit:DataGridTemplateColumn Header="Type" Tag="Type">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind Event.Description, Mode=OneTime}"
                                       Margin="4,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

                <toolkit:DataGridTemplateColumn Header="Time (ms)" Tag="TimeUs">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind eventGrid:EventGridFormat.TimeMs(Event.TimeUs), Mode=OneTime}"
                                       Margin="4,0,10,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

                <toolkit:DataGridTemplateColumn Header="Duration (ms)" Tag="DurationUs">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind eventGrid:EventGridFormat.TimeMs(Event.DurationUs), Mode=OneTime}"
                                       Margin="4,0,10,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

                <toolkit:DataGridTemplateColumn Header="Page" Tag="PageAddress">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <Grid>
                                <HyperlinkButton Content="{Binding PageAddress}"
                                                 Style="{StaticResource PageAddressStyle}"
                                                 Tag="{Binding PageAddress}"
                                                 Click="HyperlinkButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

                <toolkit:DataGridTemplateColumn Header="Object" Tag="Object">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind Event.ObjectName, Mode=OneTime}"
                                       Margin="4,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                </toolkit:DataGridTemplateColumn>

            </toolkit:DataGrid.Columns>
        </toolkit:DataGrid>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <ScrollViewer HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusBarText"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
