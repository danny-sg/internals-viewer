<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.EventGrid.EventGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"

    xmlns:eventGrid="using:InternalsViewer.UI.App.Controls.EventGrid"
    x:Name="Root"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        FontSize="12"
                        Height="28"
                        BorderThickness="0"
                        TextChanged="OnSearchTextChanged"/>

        <tableView:TableView x:Name="EventTable"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanSortColumns="True"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="32"
                             Sorting="OnSorting"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="Vertical"
                             Background="{ThemeResource LayerFillColorDefaultBrush}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.ItemContainerTransitions>
                <TransitionCollection />
            </tableView:TableView.ItemContainerTransitions>
            <tableView:TableView.Columns>

                <tableView:TableViewTemplateColumn Header="Event" Tag="Event" Width="180">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <StackPanel Orientation="Horizontal" Margin="{x:Bind Indent, Mode=OneTime}" VerticalAlignment="Center">
                                <Button Click="OnExpanderClick"
                                        Visibility="{x:Bind ExpanderVisibility, Mode=OneTime}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        MinWidth="16" Width="16" MinHeight="16" Height="16"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ExpanderGlyph, Mode=OneWay}" FontSize="10"/>
                                </Button>
                                <TextBlock Text="{x:Bind Event.Name, Mode=OneTime}"
                                           Margin="4,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

                <tableView:TableViewTemplateColumn Header="Type" Tag="Type" Width="320">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind Event.Description, Mode=OneTime}"
                                       Margin="4,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

                <tableView:TableViewTemplateColumn Header="Time (ms)" Tag="TimeUs" Width="100">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind eventGrid:EventGridFormat.TimeMs(Event.TimeUs), Mode=OneTime}"
                                       Margin="4,0,10,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

                <tableView:TableViewTemplateColumn Header="Duration (ms)" Tag="DurationUs" Width="110">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind eventGrid:EventGridFormat.TimeMs(Event.DurationUs), Mode=OneTime}"
                                       Margin="4,0,10,0"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

                <tableView:TableViewTemplateColumn Header="Page" Tag="PageAddress" Width="90">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <HyperlinkButton Content="{x:Bind PageAddress, Mode=OneTime}"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             Tag="{x:Bind PageAddress, Mode=OneTime}"
                                             Click="HyperlinkButton_Click"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

                <tableView:TableViewTemplateColumn Header="Object" Tag="Object" Width="220">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="eventGrid:EventGridRow">
                            <TextBlock Text="{x:Bind Event.ObjectName, Mode=OneTime}"
                                       Margin="4,0"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>

            </tableView:TableView.Columns>
        </tableView:TableView>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <ScrollViewer HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusBarText"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
