<?xml version="1.0" encoding="utf-8"?>
<viewModels:CursorUserControl
    x:Class="InternalsViewer.UI.App.Controls.HexView.HexViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:viewModels="using:InternalsViewer.UI.App.Controls.HexView"
    mc:Ignorable="d">
    <Control.Resources>
        <converters:StringFormatConverter x:Key="StringFormatConverter" />

        <x:Double x:Key="ScrollBarSize">16</x:Double>

        <Style x:Key="AddressStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <Style x:Key="HexRichTextBlockStyle" TargetType="RichTextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="Margin" Value="-1,-3,-1,-5"/>
        </Style>

        <Style TargetType="RichTextBlock">
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollBar x:Name="VirtualScrollBar"
                   Grid.Row="0"
                   Grid.Column="1"
                   Orientation="Vertical"
                   Minimum="0"
                   Maximum="0"
                   Visibility="Collapsed"
                   IndicatorMode="MouseIndicator"
                   Scroll="VirtualScrollBar_OnScroll"/>
        <ScrollViewer Name="ScrollViewer"
                      Grid.Column="0"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Grid.Row="0"
                      Background="{x:Bind Background}"
                      VerticalScrollBarVisibility="Visible"
                      VerticalAlignment="Stretch"
                      HorizontalScrollBarVisibility="Hidden">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"  
                           x:Name="AddressTextBlock" 
                           Style="{StaticResource AddressStyle}" 
                           Margin="8,0,8,0"
                           VerticalAlignment="Stretch"/>
                <Grid Grid.Column="1" Grid.Row="0">
                    <RichTextBlock  
                           x:Name="HexRichTextBlock" 
                           VerticalAlignment="Stretch"
                           LineHeight="16"
                           PointerMoved="HexRichTextBlock_PointerMoved"
                           PointerEntered="HexRichTextBlock_PointerEntered"
                           PointerExited="HexRichTextBlock_PointerExited"
                           SelectionChanged="HexRichTextBlock_SelectionChanged"
                           LostFocus="HexRichTextBlock_LostFocus"
                           Style="{StaticResource HexRichTextBlockStyle}">
                        <RichTextBlock.ContextFlyout>
                            <MenuFlyout Opening="HexMenu_Opening">
                                <MenuFlyoutItem x:Name="OpenLinkMenuItem"
                                                KeyboardAcceleratorTextOverride="Ctrl+Click"
                                                Click="OpenLinkMenuItem_Click" />
                                <MenuFlyoutSeparator x:Name="OpenLinkSeparator" />
                                <MenuFlyoutItem x:Name="NextChangeMenuItem"
                                                Text="Next Change"
                                                KeyboardAcceleratorTextOverride="Double-Click"
                                                Click="NextChangeMenuItem_Click" />
                                <MenuFlyoutItem x:Name="PreviousChangeMenuItem"
                                                Text="Previous Change"
                                                KeyboardAcceleratorTextOverride="Shift+Double-Click"
                                                Click="PreviousChangeMenuItem_Click" />
                                <MenuFlyoutSeparator x:Name="ChangeMenuSeparator" />
                                <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy" Click="CopyMenuItem_Click" />
                                <MenuFlyoutItem Text="Select All" Click="SelectAllMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ClearPinsMenuItem" Text="Clear Pins" Click="ClearPinsMenuItem_Click" />
                            </MenuFlyout>
                        </RichTextBlock.ContextFlyout>
                    </RichTextBlock>
                    <Canvas x:Name="HexOverlayCanvas"
                            IsHitTestVisible="False"
                            Canvas.ZIndex="10" />
                    <Canvas x:Name="LinkCanvas"
                            IsHitTestVisible="False"
                            Canvas.ZIndex="11" />
                    <Canvas x:Name="PinOutlineCanvas"
                            IsHitTestVisible="False"
                            Canvas.ZIndex="12" />
                    <Canvas x:Name="SelectionMaskCanvas"
                            IsHitTestVisible="False"
                            Canvas.ZIndex="15" />
                    <Grid x:Name="AreaOverlay"
                          IsHitTestVisible="False"
                          Canvas.ZIndex="20"
                          Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid x:Name="TipLayer"
              Grid.Row="0"
              Grid.Column="0" />
        <Popup x:Name="LinkTipPopup"
               Grid.Row="0"
               Grid.Column="0"
               IsHitTestVisible="False"
               ShouldConstrainToRootBounds="False">
            <Border CornerRadius="1"
                    Padding="6"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.95"/>
                </Border.Background>
                <TextBlock x:Name="LinkTipText" Style="{StaticResource TooltipValueStyle}"/>
            </Border>
        </Popup>
        <Canvas x:Name="MarkerMapCanvas"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="{StaticResource ScrollBarSize}"
                Margin="0,1,1,1"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"/>
        <Grid Grid.Row="1" Grid.ColumnSpan="2"       
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderThickness="1,0,1,1"
              VerticalAlignment="Top"
              Height="30"
              Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="70*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Padding="4,0,0,0"
                       VerticalAlignment="Center"
                       Text="Offset" FontSize="12"/>
            <TextBlock Grid.Column="1" 
                       Padding="4,0,0,0"
                       Margin="0,1,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       Text="{x:Bind MouseOver.Offset, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:0000}'}"
                      />
            <Border Grid.Column="3" Background="{x:Bind MouseOver.Marker.BackColour,Mode=OneWay,Converter={StaticResource ColorToSolidColorBrushValueConverter}}"
                    Visibility="{x:Bind MouseOver.HasMarker, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="0"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{x:Bind MouseOver.Marker.Name, Mode=OneWay}" 
                           TextAlignment="Center"
                           Padding="4"
                           Foreground="{x:Bind MouseOver.Marker.ForeColour, Mode=OneWay, Converter={StaticResource ColorToSolidColorBrushValueConverter}}"/>
            </Border>
        </Grid>

    </Grid>
</viewModels:CursorUserControl>
