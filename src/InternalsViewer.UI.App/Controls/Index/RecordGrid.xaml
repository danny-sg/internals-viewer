<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Index.RecordGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SlotCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <tableView:TableView x:Name="RecordTable"
                             AutoGenerateColumns="False"
                             CanSortColumns="True"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="32"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             AllowLiveShaping="False"
                             GridLinesVisibility="All"
                             HeaderGridLinesVisibility="All"
                             HorizontalGridLinesStroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                             HorizontalGridLinesStrokeThickness="1"
                             VerticalGridLinesStroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                             VerticalGridLinesStrokeThickness="1"
                             Background="{ThemeResource LayerFillColorDefaultBrush}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.ItemContainerTransitions>
                <TransitionCollection />
            </tableView:TableView.ItemContainerTransitions>
        </tableView:TableView>
    </Grid>
</UserControl>
