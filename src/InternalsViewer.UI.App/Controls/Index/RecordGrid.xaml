<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Index.RecordGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SlotCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <toolkit:DataGrid x:Name="DataGrid"                       
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          VerticalGridLinesBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
            <toolkit:DataGrid.ColumnHeaderStyle>
                <Style TargetType="primitives:DataGridColumnHeader">
                    <Setter Property="SeparatorBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="SeparatorVisibility" Value="Visible" />
                    <Setter Property="Padding" Value="6,0,0,0" />
                </Style>
            </toolkit:DataGrid.ColumnHeaderStyle>
            <toolkit:DataGrid.Resources>
                <!-- Fills the header and rows separator, a rectangle of the grid's own template rather than anything the header owns -->
                <StaticResource x:Key="GridLinesBrush" ResourceKey="ControlStrokeColorDefaultBrush" />

                <StaticResource x:Key="DataGridFillerColumnGridLinesBrush" ResourceKey="ControlStrokeColorDefaultBrush" />

                <StaticResource
                        x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundColor"
                        ResourceKey="SystemListAccentMediumColor" />
                <StaticResource
                        x:Key="DataGridRowSelectedUnfocusedBackgroundColor"
                        ResourceKey="SystemListAccentLowColor" />

                <StaticResource
                        x:Key="DataGridRowSelectedHoveredBackgroundColor"
                        ResourceKey="SystemListAccentMediumColor" />
            </toolkit:DataGrid.Resources>
        </toolkit:DataGrid>

    </Grid>
</UserControl>
