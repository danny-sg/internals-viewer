<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Page.PageIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="32"
    Height="32"
    mc:Ignorable="d">
    <Border Padding="2">
        <Viewbox>
            <Canvas Width="30" Height="30">

                <Rectangle x:Name="HeaderBand" Canvas.Left="7" Canvas.Top="4" Width="18" Height="8"/>
               
                <Rectangle x:Name="PageOutline"
                           Canvas.Left="5"
                           Canvas.Top="2"
                           Width="22"
                           Height="30"
                           Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                           StrokeThickness="0.5"/>

            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
