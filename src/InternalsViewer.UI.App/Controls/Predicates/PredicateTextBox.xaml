<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Predicates.PredicateTextBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontSize="12"
    Margin="0">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="PredicateTextBoxBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="{ThemeResource TextControlBorderThemeThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="BackgroundBorder"
            Style="{StaticResource PredicateTextBoxBorder}"
            Margin="{Binding Margin, ElementName=Root}">
        <RichTextBlock x:Name="TextHost"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       FontSize="{Binding FontSize, ElementName=Root}"
                       Padding="{Binding TextPadding, ElementName=Root}"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch" />
    </Border>
</UserControl>
