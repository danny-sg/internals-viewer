<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Query.Plan.GuideStepLabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Button Style="{StaticResource TabCommandButtonStyle}"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            MaxWidth="480"
            IsTabStop="False"
            Click="OnClick"
            ToolTipService.ToolTip="Move to the next step. Shift + Click moves to the previous step">
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="LightGray" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="LightGray" />
        </Button.Resources>
        <StackPanel Spacing="2" IsHitTestVisible="False">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas" />
                </Style>
            </StackPanel.Resources>
            <controls:MarkdownTextBlock x:Name="NameText" FontSize="12" FontWeight="Bold" />
            <controls:MarkdownTextBlock x:Name="DescriptionText" FontSize="12" />
        </StackPanel>
    </Button>
</UserControl>
