<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Query.Plan.PlanNodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plan="using:InternalsViewer.UI.App.Models.Query.Plan"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border x:Name="NodeBorder"
            BorderThickness="0"
            Padding="0,4,0,0"
            CornerRadius="4"
            ToolTipService.ToolTip="{x:Bind ToolTipText}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AnnotationColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Spacing="2">
                <Grid HorizontalAlignment="Center">
                    <Border x:Name="NodeImageBorder"
                            BorderThickness="2"
                            CornerRadius="2"
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center" >
                        <Grid x:Name="IconLayers">
                            <Image Source="{x:Bind IconSource}"
                                   Name="NodeImage"
                                   Width="32"
                                   Height="32"
                                   HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="CounterBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-14,0"
                            MinWidth="16"
                            Padding="4,0,4,1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="CounterText"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Bind OperatorName}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind DetailText}"
                           FontSize="10"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind DetailVisibility}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind CostText}"
                           FontSize="10"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind CostVisibility}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ItemsControl x:Name="AnnotationBadges"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="4,0,0,0"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="plan:PlanNodeAnnotation">
                        <Border CornerRadius="3"
                                Padding="5,1,5,2"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Bind Colour}" />
                            </Border.Background>
                            <TextBlock Text="{x:Bind Text}"
                                       FontSize="9"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
