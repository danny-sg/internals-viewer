<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Query.Trace.CallStack.CategoryFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:InternalsViewer.UI.App.Controls"
    Visibility="Collapsed"
    mc:Ignorable="d">
    <Grid Padding="8,4,8,6"
          ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <app:WrapPanel x:Name="CategoryBadges"
                       Grid.Column="0"
                       HorizontalSpacing="4"
                       VerticalSpacing="4"/>

        <Button Grid.Column="1"
                Content="Defaults"
                Style="{StaticResource TabCommandButtonStyle}"
                FontSize="11"
                VerticalAlignment="Top"
                Click="OnDefaultCategoriesClick"
                ToolTipService.ToolTip="Hide the categories hidden by default"/>

        <ToggleButton x:Name="AllCategoriesToggle"
                      Grid.Column="2"
                      Content="All"
                      Style="{StaticResource TabCommandToggleStyle}"
                      FontSize="11"
                      VerticalAlignment="Top"
                      Click="OnAllCategoriesClick"
                      ToolTipService.ToolTip="Show or hide every category"/>
    </Grid>
</UserControl>
