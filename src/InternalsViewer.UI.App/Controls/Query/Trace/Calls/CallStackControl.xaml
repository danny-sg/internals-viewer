<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Query.Trace.Calls.CallStackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:calls="using:InternalsViewer.UI.App.Controls.Query.Trace.Calls"
    xmlns:callStackSignatures="using:InternalsViewer.UI.App.Controls.Query.Trace.Calls.Signatures"
    xmlns:signatures="using:InternalsViewer.UI.App.Models.Query.Trace.Calls.Signatures"
    xmlns:stack="using:InternalsViewer.UI.App.Models.Query.Trace.Calls.Stack"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors">

    <UserControl.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>

        <MenuFlyout x:Key="CallMenu">
            <MenuFlyoutItem Text="Open In Call Tree" Click="OnOpenInCallTreeClick"/>
            <MenuFlyoutItem Text="Zoom" Click="OnZoomClick"/>
            <MenuFlyoutItem Text="Scope" Click="OnScopeClick"/>
            <MenuFlyoutItem Text="Search" Click="OnSearchClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutSubItem Text="Copy">
                <MenuFlyoutItem Text="Copy Signature" Click="OnCopySignatureClick"/>
                <MenuFlyoutItem Text="Copy Symbol" Click="OnCopySymbolClick"/>
                <MenuFlyoutItem Text="Copy Address" Click="OnCopyAddressClick"/>
            </MenuFlyoutSubItem>
        </MenuFlyout>

        <DataTemplate x:Key="ThreadTemplate" x:DataType="muxc:TreeViewNode">
            <TextBlock Text="{x:Bind ((stack:PlayheadThreadRow)Content).Label}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="CallTemplate" x:DataType="muxc:TreeViewNode">
            <Grid Padding="0,3,0,3"
                  RightTapped="OnCallRowRightTapped"
                  ContextFlyout="{StaticResource CallMenu}"
                  Background="{x:Bind calls:CallStackControl.RowBackground(((stack:PlayheadCallRow)Content).IsCurrent)}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#x2192;"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind ((stack:PlayheadCallRow)Content).CurrentText}"
                           Visibility="{x:Bind ((stack:PlayheadCallRow)Content).IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Ellipse Grid.Column="1"
                         Width="8"
                         Height="8"
                         Margin="0,6,6,6"
                         VerticalAlignment="Center"
                         Fill="{x:Bind ((stack:PlayheadCallRow)Content).Node.CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                         ToolTipService.ToolTip="{x:Bind ((stack:PlayheadCallRow)Content).Node.Category}"/>

                <callStackSignatures:CallSignatureLine Grid.Column="2"
                                             TextSize="12"
                                             Parts="{x:Bind ((stack:PlayheadCallRow)Content).Signature}"
                                             HighlightedPart="{x:Bind ((stack:PlayheadCallRow)Content).Highlighted, Mode=OneWay}"
                                             MemorySelected="OnSignatureMemorySelected"/>

                <controls:CopyButton Grid.Column="3"
                                     Style="{StaticResource ValueCopyButtonStyle}"
                                     VerticalAlignment="Center"
                                     Tapped="OnCopyTapped"
                                     Click="OnCopyRowSignatureClick"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArgumentTemplate" x:DataType="signatures:CallSignaturePart">
            <Grid ColumnSpacing="8"
                  Padding="0,1,0,1"
                  Background="Transparent"
                  ContextRequested="OnArgumentContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind Label}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               callStackSignatures:SignatureRuns.Argument="{x:Bind}"/>

                    <HyperlinkButton Style="{StaticResource DetailLinkStyle}"
                                     HorizontalAlignment="Left"
                                     Content="{x:Bind MemoryTarget}"
                                     Tag="{x:Bind}"
                                     Visibility="{x:Bind calls:CallStackControl.GetTargetVisibility(MemoryTarget)}"
                                     IsEnabled="{x:Bind CanOpenTarget}"
                                     ToolTipService.ToolTip="{x:Bind calls:CallStackControl.GetTargetToolTip(IsBufferPage)}"
                                     Click="OnMemoryClick"/>
                </StackPanel>

                <controls:CopyButton Grid.Column="2"
                                     Style="{StaticResource ValueCopyButtonStyle}"
                                     Click="OnCopyArgumentClick"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="StackItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="muxc:TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Margin="{ThemeResource TreeViewItemPresenterMargin}"
                              Padding="{ThemeResource TreeViewItemPresenterPadding}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Width="3"
                                       Height="16"
                                       Fill="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                                       Opacity="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       RadiusX="2"
                                       RadiusY="2"/>

                            <Grid x:Name="MultiSelectGrid"
                                  Grid.Column="1"
                                  Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ExpandCollapseChevron"
                                      Grid.Column="0"
                                      Opacity="{TemplateBinding GlyphOpacity}"
                                      Background="Transparent">
                                    <TextBlock x:Name="CollapsedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Height="12"
                                               Padding="6,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding CollapsedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ExpandedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Height="12"
                                               Padding="6,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding ExpandedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <selectors:PlayheadStackTemplateSelector x:Key="StackTemplateSelector"
                                                 ThreadTemplate="{StaticResource ThreadTemplate}"
                                                 CallTemplate="{StaticResource CallTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StackColumn" Width="*"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <muxc:TreeView x:Name="StackTree"
                       Grid.Column="0"
                       ItemTemplateSelector="{StaticResource StackTemplateSelector}"
                       SelectionMode="Single"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Expanding="OnStackTreeExpanding"
                       Collapsed="OnStackTreeCollapsed"
                       ItemInvoked="OnStackTreeItemInvoked"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollMode="Enabled"
                       ItemContainerStyle="{StaticResource StackItemStyle}"/>

        <TextBlock Grid.Column="0"
                   Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind IsEmpty(ViewModel.Threads), Mode=OneWay}"/>

        <toolkit:GridSplitter x:Name="DetailsSplitter"
                              Grid.Column="1"
                              Width="4"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed"/>

        <Grid x:Name="DetailsPane"
              Grid.Column="2"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Padding="12,6,4,6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <TextBlock x:Name="DetailsTitle"
                           ContextRequested="OnDetailsTitleContextRequested"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="12"
                           Margin="0,0,28,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource TabCommandButtonStyle}"
                        HorizontalAlignment="Right"
                        ToolTipService.ToolTip="Close"
                        Click="OnCloseDetailsClick">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Padding="12,8,12,8"
                      ColumnSpacing="12"
                      RowSpacing="4"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Category"
                               Style="{StaticResource DetailLabelStyle}"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Category), Mode=OneWay}"/>
                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Category), Mode=OneWay}"
                            HorizontalAlignment="Left"
                            CornerRadius="3"
                            Padding="5,2,5,3"
                            Background="{x:Bind CategoryBrush(ViewModel.SelectedCall), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCall.Node.Category, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <controls:CopyButton Grid.Row="0"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Category), Mode=OneWay}"
                                         Tag="{x:Bind ViewModel.SelectedCall.Node.Category, Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Module"
                               Style="{StaticResource DetailLabelStyle}"
                               Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Frame.Module.Name), Mode=OneWay}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource DetailValueStyle}"
                               Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Frame.Module.Name), Mode=OneWay}"
                               Text="{x:Bind ViewModel.SelectedCall.Node.Frame.Module.Name, Mode=OneWay}"/>
                    <controls:CopyButton Grid.Row="1"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Visibility="{x:Bind IsTextVisible(ViewModel.SelectedCall.Node.Frame.Module.Name), Mode=OneWay}"
                                         Tag="{x:Bind ViewModel.SelectedCall.Node.Frame.Module.Name, Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="This"
                               Style="{StaticResource DetailLabelStyle}"
                               Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}"/>
                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}"
                                ContextRequested="OnThisContextRequested">
                        <TextBlock Style="{StaticResource DetailValueStyle}"
                                   IsTextSelectionEnabled="False"
                                   VerticalAlignment="Center"
                                   controls:HexText.Text="{x:Bind ThisText(ViewModel.SelectedCall), Mode=OneWay}"/>

                        <HyperlinkButton Style="{StaticResource ResultPointerStyle}"
                                         Content="{x:Bind TargetText(ViewModel.SelectedCall.This), Mode=OneWay}"
                                         Tag="{x:Bind ViewModel.SelectedCall.This, Mode=OneWay}"
                                         Visibility="{x:Bind IsTargetVisible(ViewModel.SelectedCall.This), Mode=OneWay}"
                                         IsEnabled="{x:Bind IsTargetEnabled(ViewModel.SelectedCall.This), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind TargetToolTip(ViewModel.SelectedCall.This), Mode=OneWay}"
                                         Click="OnMemoryClick"/>
                    </StackPanel>
                    <controls:CopyButton Grid.Row="2"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind ThisText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Visibility="{x:Bind IsVisible(ViewModel.SelectedCall.This), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Returns" Style="{StaticResource DetailLabelStyle}"/>
                    <StackPanel Grid.Row="3" Grid.Column="2" ContextRequested="OnReturnContextRequested">
                        <TextBlock Style="{StaticResource DetailValueStyle}"
                                   IsTextSelectionEnabled="False"
                                   controls:HexText.Text="{x:Bind ReturnText(ViewModel.SelectedCall), Mode=OneWay}"
                                   ToolTipService.ToolTip="Returned after the playhead"/>

                        <HyperlinkButton Style="{StaticResource DetailLinkStyle}"
                                         HorizontalAlignment="Left"
                                         Content="{x:Bind TargetText(ViewModel.SelectedCall.Return), Mode=OneWay}"
                                         Tag="{x:Bind ViewModel.SelectedCall.Return, Mode=OneWay}"
                                         Visibility="{x:Bind IsTargetVisible(ViewModel.SelectedCall.Return), Mode=OneWay}"
                                         IsEnabled="{x:Bind IsTargetEnabled(ViewModel.SelectedCall.Return), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind TargetToolTip(ViewModel.SelectedCall.Return), Mode=OneWay}"
                                         Click="OnMemoryClick"/>
                    </StackPanel>
                    <controls:CopyButton Grid.Row="3"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind ReturnText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Position" Style="{StaticResource DetailLabelStyle}"/>
                    <HyperlinkButton Grid.Row="4"
                                     Grid.Column="2"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource DetailLinkStyle}"
                                     Content="{x:Bind PositionText(ViewModel.SelectedCall), Mode=OneWay}"
                                     Click="OnStartClick"
                                     ContextRequested="OnStartContextRequested"/>
                    <controls:CopyButton Grid.Row="4"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind PositionText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Start" Style="{StaticResource DetailLabelStyle}"/>
                    <HyperlinkButton Grid.Row="5"
                                     Grid.Column="2"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource DetailLinkStyle}"
                                     Content="{x:Bind StartText(ViewModel.SelectedCall), Mode=OneWay}"
                                     Click="OnStartClick"
                                     ContextRequested="OnStartContextRequested"/>
                    <controls:CopyButton Grid.Row="5"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind StartText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="End" Style="{StaticResource DetailLabelStyle}"/>
                    <HyperlinkButton Grid.Row="6"
                                     Grid.Column="2"
                                     HorizontalAlignment="Left"
                                     Style="{StaticResource DetailLinkStyle}"
                                     Content="{x:Bind EndText(ViewModel.SelectedCall), Mode=OneWay}"
                                     Click="OnEndClick"
                                     ContextRequested="OnEndContextRequested"/>
                    <controls:CopyButton Grid.Row="6"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind EndText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Instructions" Style="{StaticResource DetailLabelStyle}"/>
                    <TextBlock Grid.Row="7"
                               Grid.Column="2"
                               Style="{StaticResource DetailValueStyle}"
                               Text="{x:Bind InstructionsText(ViewModel.SelectedCall), Mode=OneWay}"/>
                    <controls:CopyButton Grid.Row="7"
                                         Grid.Column="1"
                                         Style="{StaticResource DetailCopyButtonStyle}"
                                         Tag="{x:Bind InstructionsText(ViewModel.SelectedCall), Mode=OneWay}"
                                         Click="OnCopyValueClick"/>

                    <TextBlock Grid.Row="8" Grid.Column="0"
                               Text="Arguments"
                               Style="{StaticResource DetailLabelStyle}"
                               Margin="0,1,0,0"
                               VerticalAlignment="Top"
                               Visibility="{x:Bind AreArgumentsVisible(ViewModel.SelectedCall), Mode=OneWay}"/>
                    <ItemsControl Grid.Row="8"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  ItemsSource="{x:Bind ViewModel.SelectedCall.Arguments, Mode=OneWay}"
                                  ItemTemplate="{StaticResource ArgumentTemplate}"
                                  Visibility="{x:Bind AreArgumentsVisible(ViewModel.SelectedCall), Mode=OneWay}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
