<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="InternalsViewer.UI.App.Controls.Query.Trace.Dialogs.OperatorTrackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add to Operators"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnAddClick">

    <StackPanel Spacing="12" MinWidth="520">
        <AutoSuggestBox x:Name="FunctionBox"
                        Header="Function"
                        PlaceholderText="Function, such as CEsExec::FastCompare1"
                        TextChanged="OnFunctionTextChanged"
                        SuggestionChosen="OnFunctionChosen"
                        QuerySubmitted="OnFunctionSubmitted"
                        LostFocus="OnFunctionLostFocus"/>

        <TextBox x:Name="NameBox" Header="Name" Text="{x:Bind TrackName, Mode=TwoWay}"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Colour"/>

                <Button x:Name="ColourButton" Width="56" Height="32" Padding="4">
                    <Border x:Name="ColourSwatch" Width="44" Height="22" CornerRadius="2"/>

                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="ColourPicker"
                                         IsAlphaEnabled="False"
                                         IsMoreButtonVisible="False"
                                         ColorChanged="OnColourChanged"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <NumberBox x:Name="HeightBox"
                       Grid.Column="1"
                       Header="Height"
                       Minimum="0.25"
                       Maximum="4"
                       SmallChange="0.25"
                       LargeChange="1"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind HeightFactor, Mode=TwoWay}"/>

            <NumberBox x:Name="WidthBox"
                       Grid.Column="2"
                       Header="Width"
                       Minimum="0.25"
                       Maximum="8"
                       SmallChange="0.25"
                       LargeChange="1"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind WidthFactor, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Spacing="4">
            <TextBlock Text="Conditions"/>
        </StackPanel>

        <StackPanel x:Name="ConditionsPanel" Spacing="8"/>

        <Button x:Name="AddConditionButton" Content="Add Condition" Click="OnAddConditionClick"/>

        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
</ContentDialog>
