<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="InternalsViewer.UI.App.Controls.Query.Trace.Dialogs.OperatorTrackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add to Operators"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnAddClick">

    <StackPanel Spacing="12" MinWidth="520">
        <AutoSuggestBox x:Name="FunctionBox"
                        Header="Function"
                        PlaceholderText="Function, such as CEsExec::FastCompare1"
                        TextChanged="OnFunctionTextChanged"
                        SuggestionChosen="OnFunctionChosen"
                        QuerySubmitted="OnFunctionSubmitted"
                        LostFocus="OnFunctionLostFocus"/>

        <Grid x:Name="WatchFields" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="OffsetBox"
                     Header="Offset"
                     PlaceholderText="Such as 0x40"
                     ToolTipService.ToolTip="Bytes from the start of the operator's object, in decimal or 0x hex"/>

            <NumberBox x:Name="LengthBox"
                       Grid.Column="1"
                       Header="Length"
                       Minimum="1"
                       Maximum="16"
                       SmallChange="1"
                       LargeChange="4"
                       SpinButtonPlacementMode="Compact"
                       ValueChanged="OnLengthChanged"/>

            <ComboBox x:Name="DataTypeBox"
                      Grid.Column="2"
                      Header="Data Type"
                      HorizontalAlignment="Stretch"/>
        </Grid>

        <AutoSuggestBox x:Name="NameBox"
                        Header="Track"
                        PlaceholderText="A new track, or an existing one to combine with"
                        Text="{x:Bind TrackName, Mode=TwoWay}"
                        TextChanged="OnTrackTextChanged"/>

        <TextBox x:Name="LabelBox"
                 Header="Label"
                 PlaceholderText="The function name when empty"
                 ToolTipService.ToolTip="Markdown. {OperatorName} is the tick's operator and {ParentOperatorName} the operator that called it"
                 Text="{x:Bind ValueLabel, Mode=TwoWay}"/>

        <TextBox x:Name="TitleBox"
                 Header="Title"
                 PlaceholderText="The name of each Guide Mode step, the label when empty"
                 ToolTipService.ToolTip="Markdown. {OperatorName} is the tick's operator and {ParentOperatorName} the operator that called it"
                 Text="{x:Bind StepTitle, Mode=TwoWay}"/>

        <TextBox x:Name="DescriptionBox"
                 Header="Description"
                 PlaceholderText="What happens, such as {ParentOperatorName} calls `GetRow` from {OperatorName}"
                 ToolTipService.ToolTip="Markdown. {OperatorName} is the tick's operator and {ParentOperatorName} the operator that called it"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 Text="{x:Bind Description, Mode=TwoWay}"/>

        <TextBox x:Name="DetailsBox"
                 Header="Details"
                 PlaceholderText="A longer explanation of why it happens"
                 ToolTipService.ToolTip="Markdown. Shown below the description in the tick's tooltip and, with Details on, at its Guide Mode step"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 Text="{x:Bind Details, Mode=TwoWay}"/>

        <TextBox x:Name="ReturnDescriptionBox"
                 Header="Return Description"
                 PlaceholderText="What happens at the return, such as `GetRow` returns from {OperatorName} to {ParentOperatorName}"
                 ToolTipService.ToolTip="Markdown. {OperatorName} is the tick's operator and {ParentOperatorName} the operator that called it"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 Text="{x:Bind ReturnDescription, Mode=TwoWay}"/>

        <AutoSuggestBox x:Name="PlanPartBox"
                        Header="Plan Part"
                        PlaceholderText="A part of the operator's plan icon to light, such as Root Node"
                        Text="{x:Bind PlanPart, Mode=TwoWay}"
                        TextChanged="OnPlanPartTextChanged"/>

        <CheckBox x:Name="CounterBox"
                  Content="Counter"
                  ToolTipService.ToolTip="Count these ticks on the operator's plan icon as the playhead passes them"/>

        <CheckBox x:Name="PhaseBox"
                  Content="Phase"
                  ToolTipService.ToolTip="Guide Mode steps over the steps inside each tick, from its start to its end"/>

        <CheckBox x:Name="PlanDefaultBox"
                  Content="Plan Default"
                  ToolTipService.ToolTip="Every tick is a Guide Mode step. When off, the rule is offered under Additional Steps on the plan's View menu"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Colour"/>

                <Button x:Name="ColourButton" Width="56" Height="32" Padding="4">
                    <Border x:Name="ColourSwatch" Width="44" Height="22" CornerRadius="2"/>

                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="ColourPicker"
                                         IsAlphaEnabled="False"
                                         IsMoreButtonVisible="False"
                                         ColorChanged="OnColourChanged"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Background"/>

                <Button x:Name="BackgroundButton" Width="56" Height="32" Padding="4">
                    <Border x:Name="BackgroundSwatch" Width="44" Height="22" CornerRadius="2"/>

                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="BackgroundPicker"
                                         IsAlphaEnabled="True"
                                         IsMoreButtonVisible="False"
                                         ColorChanged="OnBackgroundChanged"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <NumberBox x:Name="HeightBox"
                       Grid.Column="2"
                       Header="Height"
                       Minimum="0.25"
                       Maximum="4"
                       SmallChange="0.25"
                       LargeChange="1"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind HeightFactor, Mode=TwoWay}"/>

            <NumberBox x:Name="WidthBox"
                       Grid.Column="3"
                       Header="Width"
                       Minimum="0.25"
                       Maximum="8"
                       SmallChange="0.25"
                       LargeChange="1"
                       SpinButtonPlacementMode="Compact"
                       Value="{x:Bind WidthFactor, Mode=TwoWay}"/>
        </Grid>

        <CheckBox x:Name="CategoryColourBox"
                  Content="Category Colour"
                  Checked="OnCategoryColourChanged"
                  Unchecked="OnCategoryColourChanged"/>

        <CheckBox x:Name="BackgroundBox"
                  Content="Background Colour"
                  ToolTipService.ToolTip="Fill the track's strip with the background colour instead of a shade of the operator's colour"
                  Checked="OnBackgroundBoxChanged"
                  Unchecked="OnBackgroundBoxChanged"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Conditions"/>
        </StackPanel>

        <StackPanel x:Name="ConditionsPanel" Spacing="8"/>

        <Button x:Name="AddConditionButton" Content="Add Condition" Click="OnAddConditionClick"/>

        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
</ContentDialog>
