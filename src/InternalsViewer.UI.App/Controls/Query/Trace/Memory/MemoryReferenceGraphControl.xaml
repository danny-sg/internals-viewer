<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Query.Trace.Memory.MemoryReferenceGraphControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skiaSharp="using:SkiaSharp.Views.Windows">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GraphLineBrush" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="GraphCrossLineBrush" Color="#B8B8B8"/>
                    <SolidColorBrush x:Key="GraphHotLineBrush" Color="#C25E00"/>
                    <SolidColorBrush x:Key="GraphProgressBrush" Color="#59808080"/>
                    <SolidColorBrush x:Key="GraphActiveBrush" Color="#606060"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GraphLineBrush" Color="#7A7A7A"/>
                    <SolidColorBrush x:Key="GraphCrossLineBrush" Color="#5C5C5C"/>
                    <SolidColorBrush x:Key="GraphHotLineBrush" Color="#F0A030"/>
                    <SolidColorBrush x:Key="GraphProgressBrush" Color="#59A0A0A0"/>
                    <SolidColorBrush x:Key="GraphActiveBrush" Color="#B0B0B0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel IsHitTestVisible="False">
            <Border x:Name="LineProbe" Width="0" Height="0" Background="{ThemeResource GraphLineBrush}"/>
            <Border x:Name="CrossLineProbe" Width="0" Height="0" Background="{ThemeResource GraphCrossLineBrush}"/>
            <Border x:Name="HoverLineProbe" Width="0" Height="0" Background="{ThemeResource SystemFillColorSuccessBrush}"/>
            <Border x:Name="HotLineProbe" Width="0" Height="0" Background="{ThemeResource GraphHotLineBrush}"/>
            <Border x:Name="ProgressProbe" Width="0" Height="0" Background="{ThemeResource GraphProgressBrush}"/>
            <Border x:Name="ActiveProbe" Width="0" Height="0" Background="{ThemeResource GraphActiveBrush}"/>
            <Border x:Name="NodeProbe" Width="0" Height="0" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"/>
            <Border x:Name="DataNodeProbe" Width="0" Height="0" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"/>
            <Border x:Name="AccentProbe" Width="0" Height="0" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Border x:Name="TextProbe" Width="0" Height="0" Background="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border x:Name="SecondaryTextProbe" Width="0" Height="0" Background="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border x:Name="DisabledTextProbe" Width="0" Height="0" Background="{ThemeResource TextFillColorDisabledBrush}"/>
            <Border x:Name="LinkProbe" Width="0" Height="0" Background="{ThemeResource AccentTextFillColorSecondaryBrush}"/>
            <Border x:Name="HoverProbe" Width="0" Height="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        </StackPanel>

        <skiaSharp:SKXamlCanvas x:Name="GraphCanvas"
                                IgnorePixelScaling="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>

        <Canvas IsHitTestVisible="False">
            <Popup x:Name="ToolTipPopup" IsHitTestVisible="False">
                <Border Background="#EB1E1E1E" CornerRadius="3" IsHitTestVisible="False">
                    <TextBlock x:Name="ToolTipText" Foreground="White" FontSize="11" Margin="6,3,6,3"/>
                </Border>
            </Popup>
        </Canvas>

        <ScrollBar x:Name="VerticalScrollBar"
                   Grid.Column="1"
                   Grid.Row="0"
                   Orientation="Vertical"
                   Maximum="0"
                   Minimum="0"
                   Value="0"
                   IndicatorMode="MouseIndicator"
                   Scroll="OnScrollBarScroll"/>

        <ScrollBar x:Name="HorizontalScrollBar"
                   Grid.Column="0"
                   Grid.Row="1"
                   Orientation="Horizontal"
                   Maximum="0"
                   Minimum="0"
                   Value="0"
                   IndicatorMode="MouseIndicator"
                   Scroll="OnScrollBarScroll"/>
    </Grid>
</UserControl>
