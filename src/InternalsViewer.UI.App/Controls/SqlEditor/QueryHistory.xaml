<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.SqlEditor.QueryHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:query="using:InternalsViewer.UI.App.Models.Query"
    xmlns:sqlEditor="using:InternalsViewer.UI.App.Controls.SqlEditor"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="8,6"
              ColumnSpacing="6"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            PlaceholderText="Search"
                            QueryIcon="Find"
                            BorderThickness="0"
                            FontSize="12"
                            Height="28"
                            TextChanged="OnSearchTextChanged"/>

            <Button Grid.Column="1"
                    Style="{StaticResource TabCommandButtonStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Command="{x:Bind ViewModel.ClearAllCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Remove every query from the history">
                <TextBlock Text="Clear All" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="EntryList"
                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="query:QueryHistoryEntry">
                    <Border Padding="8,8"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            DoubleTapped="OnEntryDoubleTapped">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <sqlEditor:SqlTextBlock Grid.Column="0"
                                                    Sql="{x:Bind Sql}"
                                                    MaxLines="3"
                                                    ToolTipService.ToolTip="{x:Bind Sql}"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource TabCommandButtonStyle}"
                                    VerticalAlignment="Top"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="10"
                                    Content="&#xE711;"
                                    Click="OnRemoveClick"
                                    ToolTipService.ToolTip="Remove from the history"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
