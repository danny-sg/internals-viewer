<UserControl
    x:Class="InternalsViewer.UI.App.Controls.SqlEditor.SqlEditorControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" IsInverse="true" />

        <converters:BoolToBrushConverter x:Key="ActiveToRedBrushConverter"
                                         TrueBrush="#C42B1C"
                                         FalseBrush="#cacaca" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="MessagesRow" Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CommandBar IsOpen="False"
                        Padding="8,0,0,0"            
                        VerticalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Top"
                        MinHeight="0"
                        OverflowButtonVisibility="Collapsed"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">

                <!--Execute-->
                <AppBarElementContainer VerticalContentAlignment="Center" Height="40" Width="80" >
                    <Button Click="{x:Bind HandleExecuteClick}"
                            IsEnabled="{x:Bind IsExecuting, Mode=OneWay, Converter={StaticResource InverseBoolConverter }}"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Padding="6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind IsExecuting, Mode=OneWay}"
                                          Visibility="{x:Bind IsExecuting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Grid Width="16"
                                  Height="16"
                                  Visibility="{x:Bind IsExecuting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Path Data="M 0,0 L 10,5.5 L 0,11 Z"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ExecuteLabel, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </AppBarElementContainer>

                <!--Stop-->
                <AppBarElementContainer VerticalContentAlignment="Center" Height="40" Margin="0,0,0,0">
                    <Button Command="{x:Bind CancelCommand, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0">
                        <Rectangle Width="12"
                                   Height="12"
                                   RadiusX="2"
                                   RadiusY="2"
                                   ToolTipService.ToolTip="Stop query"
                                   Fill="{x:Bind IsExecuting, Mode=OneWay, Converter={StaticResource ActiveToRedBrushConverter}}" />
                    </Button>
                </AppBarElementContainer>

                <AppBarSeparator/>

                <!--Trace Toggle-->
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ToggleButton Margin="12,0,12,0"
                                  IsChecked="{x:Bind QueryOptions.Trace, Mode=TwoWay}"
                                  BorderThickness="0">
                        <TextBlock Text="Trace" VerticalAlignment="Center" />
                    </ToggleButton>
                </AppBarElementContainer>

                <AppBarSeparator/>

                <!--Clear Buffer Pool Toggle-->
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ToggleButton Margin="12,0,8,0"
                                  IsChecked="{x:Bind QueryOptions.ClearBufferPool, Mode=TwoWay}"
                                  BorderThickness="0">
                        <TextBlock Text="Clear Buffer Pool" VerticalAlignment="Center" />
                    </ToggleButton>
                </AppBarElementContainer>

                <!--Disable Read-Ahead Toggle-->
                <AppBarElementContainer VerticalContentAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton IsChecked="{x:Bind QueryOptions.DisableReadAhead, Mode=TwoWay}"
                                  Margin="0,0,0,0" 
                                  BorderThickness="0"
                                  >
                        <TextBlock Text="Disable Read-Ahead" VerticalAlignment="Center" />
                    </ToggleButton>
                </AppBarElementContainer>

            </CommandBar>

            <CommandBar IsOpen="False"
                        Padding="0"            
                        VerticalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalContentAlignment="Top"
                        MinHeight="0"
                        OverflowButtonVisibility="Collapsed"
                        Background="Transparent">
                <!--Results Toggle-->
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ToggleButton IsChecked="{x:Bind IsResultsVisible, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Margin="0,0,4,0">
                        <TextBlock Text="Results" VerticalAlignment="Center" />
                    </ToggleButton>
                </AppBarElementContainer>

                <!--Messages Toggle-->
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ToggleButton IsChecked="{x:Bind IsMessagesVisible, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Margin="0,0,8,0">
                        <TextBlock Text="Messages" VerticalAlignment="Center" />
                    </ToggleButton>
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1">
            <WebView2 x:Name="WebView" />

            <Border x:Name="LoadingOverlay"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <ProgressRing Width="20"
                                  Height="20"
                                  IsActive="True" />
                    <TextBlock Text="Loading..." VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <controls:GridSplitter Grid.Row="2"
                               x:Name="MessagesSplitter"
                               Height="2"
                               Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                               VerticalAlignment="Stretch">
            <controls:GridSplitter.Template>
                <ControlTemplate TargetType="controls:GridSplitter">
                    <Grid Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </controls:GridSplitter.Template>
        </controls:GridSplitter>

        <TabView Grid.Row="3"
                 x:Name="ResultsTabView"
                 IsAddTabButtonVisible="False"
                 VerticalAlignment="Stretch"
                 TabWidthMode="SizeToContent">
            <!--Results Tab-->
            <TabViewItem Header="Results" IsClosable="False" x:Name="ResultsTab" Visibility="Collapsed">
                <results:ResultsGridControl ResultSet="{x:Bind ResultSet, Mode=OneWay}" />
            </TabViewItem>
            <!--Messages Tab-->
            <TabViewItem Header="Messages" IsClosable="False" x:Name="MessagesTab">
                <Border Background="White" VerticalAlignment="Stretch">
                    <Grid>
                        <TextBox x:Name="ResultMessage"
                                 Padding="8"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                                 FontFamily="Courier New"
                                 Text="{x:Bind Message, Mode=OneWay}"
                                 Foreground="{x:Bind ResultBrush, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent" />
                    </Grid>
                </Border>
            </TabViewItem>
        </TabView>
    </Grid>

</UserControl>