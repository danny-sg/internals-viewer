<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Trace.HashTableGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:trace="using:InternalsViewer.UI.App.Models.Query.Trace.Hash"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToFontFamilyConverter x:Key="HashBoolToFontFamilyConverter" />
        <converters:BoolToVisibilityConverter x:Key="HashBoolToVisibilityConverter" />

        <SolidColorBrush x:Key="HashBucketCurrentBrush" Color="{ThemeResource SystemListAccentLowColor}" />
        <SolidColorBrush x:Key="HashRowCurrentBrush" Color="{ThemeResource SystemListAccentMediumColor}" />
        <SolidColorBrush x:Key="HashRowMatchedBrush" Color="{ThemeResource SystemFillColorSuccessBackground}" />

        <Style x:Key="HashCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,7,4,2" />
            <Setter Property="Height" Value="30" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HashGridLineStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,3"
                BorderThickness="0,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock VerticalAlignment="Center"
                               Text="{x:Bind Title, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{x:Bind SubTitle, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="Buckets"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ComboBox MinWidth="80"
                              Padding="8,0,0,0"
                              MinHeight="0"
                              FontSize="12"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind BucketCountOptions}"
                              SelectedItem="{x:Bind BucketCount, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="HeaderClip" SizeChanged="OnHeaderClipSizeChanged">
                <ItemsControl ItemsSource="{x:Bind Columns, Mode=OneWay}" HorizontalAlignment="Left">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="HeaderOffset" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="trace:HashColumnModel">
                            <Border Style="{StaticResource HashGridLineStyle}" Height="30" Width="{x:Bind Width, Mode=OneWay}" VerticalAlignment="Stretch">
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="12"
                                           Height="30"
                                           Padding="6,7,4,4"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <ScrollViewer x:Name="BodyScroller"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      ZoomMode="Disabled"
                      ViewChanged="OnBodyViewChanged">
            <ItemsRepeater ItemsSource="{x:Bind Buckets, Mode=OneWay}" Margin="0,0,0,8" HorizontalAlignment="Left">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="trace:HashBucketModel">
                        <Grid MinHeight="30">
                            <Border Background="{StaticResource HashBucketCurrentBrush}"
                                    Visibility="{x:Bind IsCurrent, Mode=OneWay,
                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{x:Bind Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="trace:HashEntryModel">
                                        <Grid>
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsPlaceholder,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Border Background="{StaticResource HashRowMatchedBrush}"
                                                    Visibility="{x:Bind IsMatched, Mode=OneWay,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Border Background="{StaticResource HashRowCurrentBrush}"
                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay,
                                                            Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsControl ItemsSource="{x:Bind Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="trace:HashCellModel">
                                                        <Border Style="{StaticResource HashGridLineStyle}"
                                                                Width="{x:Bind Column.Width, Mode=OneWay}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="{x:Bind Column.PrefixWidth, Mode=OneWay}"
                                                                        BorderThickness="0,0,1,0"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        Visibility="{x:Bind HasPrefix,
                                                                                Converter={StaticResource HashBoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{x:Bind Prefix}"
                                                                               Height="30"
                                                                               Style="{StaticResource HashCellStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               FontFamily="{StaticResource MonospaceFontFamily}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Value}"
                                                                           Height="30"
                                                                           Style="{StaticResource HashCellStyle}"
                                                                           FontFamily="{x:Bind Column.IsMonospace,
                                                                                   Converter={StaticResource HashBoolToFontFamilyConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
