<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Controls.Trace.SplitBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="NamePart"
                CornerRadius="4,0,0,4"
                Padding="6,0,5,1">
            <TextBlock x:Name="NameText" FontSize="11" />
        </Border>
        <Border x:Name="ValuePart"
                CornerRadius="0,4,4,0"
                Padding="5,0,6,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ValueText" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="SuffixText" FontSize="11" Opacity="0.7" Margin="4,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
