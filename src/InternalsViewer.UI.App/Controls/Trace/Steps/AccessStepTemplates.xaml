                                          Version="{Binding Fill.Version}"
                                          HighlightBucket="{Binding Fill.Bucket}"
                                          IsHighlightMatch="{Binding Fill.IsMatch}"
                                          Width="320"
                                          Height="28"
                                          HorizontalAlignment="Left"
                                          Margin="0,4,0,2"
                                          Visibility="{Binding Fill.HasBuckets,
                                                  Converter={StaticResource StepsBoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AggregatePushdownTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <accessSteps:StepSourceGutter x:Name="SourceGutter" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aggregate Pushdown" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="{Binding RowCount}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Rows Folded Into" Style="{StaticResource StepPropertyStyle}" />
                <TextBlock Text="{Binding Groups}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Groups" Style="{StaticResource StepPropertyStyle}" />
                <badge:SplitBadge BadgeName="Run Folded"
                                  BadgeColour="#2E7D32" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsRunFolded, Converter={StaticResource StepsBoolToVisibilityConverter}}" />
                <TextBlock Text="Row Group" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding RowGroupId}" Style="{StaticResource StepValueStyle}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AggregateLocalMergeTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <accessSteps:StepSourceGutter x:Name="SourceGutter" />
            <StackPanel Orientation="Vertical" Spacing="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Merge Local" Style="{StaticResource StepLabelStyle}" />
                    <TextBlock Text="{Binding LocalGroups}" Style="{StaticResource StepValueStyle}" />
                    <TextBlock Text="Local Groups Into" Style="{StaticResource StepPropertyStyle}" />
                    <TextBlock Text="{Binding GlobalGroupsAfter}" Style="{StaticResource StepValueStyle}" />
                    <TextBlock Text="Global" Style="{StaticResource StepPropertyStyle}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasRowGroup, Converter={StaticResource StepsBoolToVisibilityConverter}}">
                        <TextBlock Text="Row Group" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding RowGroupId}" Style="{StaticResource StepValueStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="" Style="{StaticResource StepLabelStyle}" Margin="0" />
                    <badge:SplitBadge BadgeName="New" BadgeValue="{Binding NewGroups}" BadgeColour="#2E7D32" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Materialised}" Style="{StaticResource StepValueStyle}" />
                        <TextBlock Text="Values Resolved Through The Dictionary" Style="{StaticResource StepPropertyStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SegmentEliminationTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <accessSteps:StepSourceGutter x:Name="SourceGutter" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Segment Elimination" Style="{StaticResource StepLabelStyle}" />
                <TextBlock Text="{Binding EliminatedCount}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Of" Style="{StaticResource StepPropertyStyle}" />
                <TextBlock Text="{Binding SegmentCount}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Eliminated" Style="{StaticResource StepPropertyStyle}" />
                <TextBlock Text="Row Group" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding RowGroupId}" Style="{StaticResource StepValueStyle}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompressedDataFilterTemplate" >
        <Grid Style="{StaticResource StepRowStyle}">
            <accessSteps:StepSourceGutter x:Name="SourceGutter" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Compressed Data Filter"
                           Style="{StaticResource StepLabelStyle}"
                           Visibility="{Binding OnCompressedData, Converter={StaticResource StepsBoolToVisibilityConverter}}" />
                <TextBlock Text="Predicate Filter"
                           Style="{StaticResource StepLabelStyle}"
                           Visibility="{Binding OnCompressedData, Converter={StaticResource StepsInverseBoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding Columns}" Style="{StaticResource StepValueStyle}" />
                <TextBlock Text="Row Group" Style="{StaticResource StepPropertyStyle}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding RowGroupId}" Style="{StaticResource StepValueStyle}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

