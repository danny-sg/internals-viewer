        ReseekTemplate="{StaticResource ReseekTemplate}"
        RebindTemplate="{StaticResource RebindTemplate}"
        JoinStartTemplate="{StaticResource JoinStartTemplate}"
        JoinVerdictTemplate="{StaticResource JoinVerdictTemplate}"
        HashBuildTemplate="{StaticResource HashBuildTemplate}"
        TopStartTemplate="{StaticResource TopStartTemplate}"
        InputStartTemplate="{StaticResource InputStartTemplate}"
        ConcatRowTemplate="{StaticResource ConcatRowTemplate}"
        SortCollectTemplate="{StaticResource SortCollectTemplate}"
        SortedTemplate="{StaticResource SortedTemplate}"
        SortRowTemplate="{StaticResource SortRowTemplate}"
        SortDuplicateTemplate="{StaticResource SortDuplicateTemplate}"
        AggregateStartTemplate="{StaticResource AggregateStartTemplate}"
        AggregateGroupTemplate="{StaticResource AggregateGroupTemplate}"
