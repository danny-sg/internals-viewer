        x:Key="AccessStepTemplateSelector"
        OpenTemplate="{StaticResource OpenTemplate}"
        CloseTemplate="{StaticResource CloseTemplate}"
        OutputTemplate="{StaticResource OutputTemplate}"
        ReadPageTemplate="{StaticResource ReadPageTemplate}"
