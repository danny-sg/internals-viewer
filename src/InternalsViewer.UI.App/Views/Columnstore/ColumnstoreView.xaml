<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternalsViewer.UI.App.Views.Columnstore.ColumnstoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:docking="using:InternalsViewer.UI.App.Controls.Docking"
    xmlns:columnstore="using:InternalsViewer.UI.App.Controls.Columnstore"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar IsOpen="False"
                    DefaultLabelPosition="Right"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Background="Transparent">
     
            <AppBarElementContainer VerticalContentAlignment="Center">
                <AppBarElementContainer VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Stretch"
                                Margin="12,0,18,0">
                        <columnstore:ColumnstoreIcon VerticalAlignment="Center"
                                                     Colour="{x:Bind ViewModel.AllocationUnit.DisplayColour, Mode=OneWay}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>Columnstore Index</TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.IndexDescription, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <Grid Margin="0"
                                      VerticalAlignment="Center"
                                      Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
                                    <TextBlock Margin="0"
                                               Foreground="DarkGreen"
                                               Text="{x:Bind ViewModel.IndexTypeDescription, Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </AppBarElementContainer>
             
            </AppBarElementContainer>
            <AppBarSeparator/>
            <AppBarButton Label="Refresh" Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <AppBarSeparator/>
            <AppBarElementContainer VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Stretch" Margin="12,0,18,0">
                    <!--<TextBlock Text="{x:Bind ViewModel.RowGroupCountDescription, Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Opacity="0.7"/>-->
                    </StackPanel>
                </AppBarElementContainer>
        </CommandBar>

        <StackPanel Grid.Row="1"
                    Padding="10"
                    Spacing="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsInitialized,
                            Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter},
                            ConverterParameter=True}">
            <ProgressRing HorizontalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsStructureLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsStructureLoading,
                                  Mode=OneWay,
                                  Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock HorizontalAlignment="Center"
                       Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}"/>
        </StackPanel>

        <docking:DockHost x:Name="DockHostControl"
                          Grid.Row="1"
                          Visibility="{x:Bind ViewModel.IsInitialized,
                              Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}"
                          Layout="{x:Bind ViewModel.Dock, Mode=OneWay}"/>
    </Grid>
</Page>
