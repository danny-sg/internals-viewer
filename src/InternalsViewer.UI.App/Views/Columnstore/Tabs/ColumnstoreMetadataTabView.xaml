<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Columnstore.Tabs.ColumnstoreMetadataTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:columnstore="using:InternalsViewer.UI.App.Models.Columnstore"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabView Grid.Row="0"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 SelectedIndex="{x:Bind SelectedTabIndex, Mode=TwoWay}">
            <TabViewItem Header="Row Groups/Segments" IsClosable="False"/>
            <TabViewItem Header="Dictionaries" IsClosable="False"/>
        </TabView>

        <tableView:TableView x:Name="SegmentTable"
                             Grid.Row="1"
                             Visibility="{x:Bind GetTabContentVisibility(SelectedTabIndex, 0), Mode=OneWay}"
                             AutoGenerateColumns="False"
                             CanSortColumns="True"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="32"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             BorderThickness="0"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Row Group" Width="90"
                                               Binding="{Binding RowGroupId}"/>
                <tableView:TableViewTextColumn Header="Column" Width="80"
                                               Binding="{Binding ColumnId}"/>
                <tableView:TableViewTextColumn Header="Name" Width="150"
                                               Binding="{Binding ColumnName}"/>
                <tableView:TableViewTemplateColumn Header="Segment" Width="80" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:SegmentSummary">
                            <HyperlinkButton Content="View"
                                             HorizontalAlignment="Center"
                                             Click="ViewSegmentButton_Click"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             Tag="{x:Bind}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTemplateColumn Header="Dictionary" Width="90" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:SegmentSummary">
                            <HyperlinkButton Content="{x:Bind DictionaryScope}"
                                             Visibility="{x:Bind HasDictionary, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Click="ViewDictionaryButton_Click"
                                             HorizontalAlignment="Center"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             Tag="{x:Bind}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
 
                <tableView:TableViewTextColumn Header="Encoding" Width="180"
                                               Binding="{Binding EncodingDescription}"/>
                <tableView:TableViewTextColumn Header="Structure" Width="110"
                                               Binding="{Binding RleTypeDescription}"/>
                <tableView:TableViewTextColumn Header="RLE Entries" Width="100"
                                               Binding="{Binding RleDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Bit Pack Entries" Width="120"
                                               Binding="{Binding BitPackEntriesDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Bit Pack Size" Width="110"
                                               Binding="{Binding BitPackSizeDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Rows" Width="100"
                                               Binding="{Binding RowCount}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="First Id" Width="100"
                                               Binding="{Binding FirstId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Size" Width="100"
                                               Binding="{Binding OnDiskSize}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Bytes Per Row" Width="110"
                                               Binding="{Binding BytesPerRow}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
               
                <tableView:TableViewTemplateColumn Header="Nulls" Width="70" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:SegmentSummary">
                            <Grid HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;"
                                          FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          Visibility="{x:Bind HasNulls,
                                                              Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <FontIcon Glyph="&#xE711;"
                                          FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind HasNulls,
                                                              Converter={StaticResource BoolToVisibilityConverter},
                                                              ConverterParameter=True}"/>
                            </Grid>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTextColumn Header="Min Data Id" Width="110"
                                               Binding="{Binding MinDataId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Max Data Id" Width="110"
                                               Binding="{Binding MaxDataId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Base Id" Width="110"
                                               Binding="{Binding BaseId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Magnitude" Width="110"
                                               Binding="{Binding Magnitude}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Min Value" Width="120"
                                               Binding="{Binding MinValueDescription}"/>
                <tableView:TableViewTextColumn Header="Max Value" Width="120"
                                               Binding="{Binding MaxValueDescription}"/>
                <tableView:TableViewTemplateColumn Header="Data Pointer" Width="130" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:SegmentSummary">
                            <HyperlinkButton Content="{x:Bind DataPointerDescription}"
                                             Visibility="{x:Bind HasDataPointer, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Click="DataPointerButton_Click"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             Tag="{x:Bind}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
               
            </tableView:TableView.Columns>
        </tableView:TableView>

        <tableView:TableView x:Name="DictionaryTable"
                             Grid.Row="1"
                             Visibility="{x:Bind GetTabContentVisibility(SelectedTabIndex, 1), Mode=OneWay}"
                             AutoGenerateColumns="False"
                             CanSortColumns="True"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="32"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             BorderThickness="0"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             ItemsSource="{x:Bind ViewModel.Dictionaries, Mode=OneWay}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Dictionary Id" Width="110"
                                               Binding="{Binding DictionaryId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTemplateColumn Header="Dictionary" Width="90" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:DictionarySummary">
                            <HyperlinkButton Content="View"
                                             Padding="0"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Click="Dictionary_OnClick"
                                             Tag="{x:Bind}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
                <tableView:TableViewTextColumn Header="Column" Width="80"
                                               Binding="{Binding ColumnId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Name" Width="150"
                                               Binding="{Binding ColumnName}"/>
                <tableView:TableViewTextColumn Header="Scope" Width="80"
                                               Binding="{Binding Scope}"/>
                <tableView:TableViewTextColumn Header="Type" Width="150"
                                               Binding="{Binding TypeDescription}"/>
                <tableView:TableViewTextColumn Header="Sub Type" Width="110"
                                               Binding="{Binding SubTypeDescription}"/>
                <tableView:TableViewTextColumn Header="Last Id" Width="100"
                                               Binding="{Binding LastId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Entry Count" Width="110"
                                               Binding="{Binding EntryCount}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Size" Width="100"
                                               Binding="{Binding OnDiskSize}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Page Count" Width="100"
                                               Binding="{Binding PageCount}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTemplateColumn Header="Data Pointer" Width="130" CanSort="False">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="columnstore:DictionarySummary">
                            <HyperlinkButton Content="{x:Bind DataPointerDescription}"
                                             Visibility="{x:Bind HasDataPointer, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Click="DictionaryDataPointerButton_Click"
                                             Style="{StaticResource CellPageAddressStyle}"
                                             Tag="{x:Bind}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
            </tableView:TableView.Columns>
        </tableView:TableView>
    </Grid>
</UserControl>
