<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Columnstore.Tabs.Dictionary.DecodeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:columnstore="using:InternalsViewer.UI.App.Controls.Columnstore"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ValuesColumn" Width="*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="HuffmanColumn" Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <toolkit:GridSplitter x:Name="Splitter"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Width="8"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="BasedOnAlignment"
                              Visibility="{x:Bind ViewModel.HasHuffmanPage, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

        <tableView:TableView x:Name="PageEntries"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Grid.Column="0"
                             AutoGenerateColumns="False"
                             CanSortColumns="False"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="28"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             BorderThickness="1,0,1,1"
                             CornerRadius="0"
                             Margin="0"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             SelectionChanged="PageEntries_OnSelectionChanged"
                             ItemsSource="{x:Bind ViewModel.PageEntries, Mode=OneWay}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Data Id" Width="90"
                                               Binding="{Binding DataId}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Offset" Width="80"
                                               Binding="{Binding OffsetDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Width="80"
                                               Binding="{Binding Length}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}">
                    <tableView:TableViewTextColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <columnstore:MarkerKey ItemType="{x:Bind ViewModel.EntryLengthItemType, Mode=OneWay}"/>
                            <TextBlock Text="Length"/>
                        </StackPanel>
                    </tableView:TableViewTextColumn.Header>
                </tableView:TableViewTextColumn>
                <tableView:TableViewTextColumn Width="180"
                                               Binding="{Binding Value}">
                    <tableView:TableViewTextColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <columnstore:MarkerKey ItemType="{x:Bind ViewModel.EntryValueItemType, Mode=OneWay}"/>
                            <TextBlock Text="Value"/>
                        </StackPanel>
                    </tableView:TableViewTextColumn.Header>
                </tableView:TableViewTextColumn>
            </tableView:TableView.Columns>
        </tableView:TableView>

        <Grid Grid.Row="1"
              Grid.Column="2"
              Visibility="{x:Bind ViewModel.HasHuffmanPage, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <TextBlock Padding="16,8,8,8" FontWeight="SemiBold">Huffman Table</TextBlock>
        <tableView:TableView x:Name="CodeTable"
                             Grid.Column="0"
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             CanSortColumns="False"
                             CanFilterColumns="False"
                             CornerButtonMode="None"
                             HeadersVisibility="Columns"
                             ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                             CellStyle="{StaticResource TableViewCellStyle}"
                             ItemContainerStyle="{StaticResource TableViewRowStyle}"
                             RowHeight="28"
                             Margin="16,0,8,16"
                             SelectionMode="Single"
                             SelectionUnit="Row"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             BorderThickness="1"
                             CornerRadius="0"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             SelectionChanged="CodeTable_OnSelectionChanged"
                             ItemsSource="{x:Bind ViewModel.Codes, Mode=OneWay}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Symbol" Width="70"
                                               Binding="{Binding HexValue}"/>
                <tableView:TableViewTextColumn Header="Character" Width="80"
                                               Binding="{Binding Character}"/>
                <tableView:TableViewTextColumn Header="Bits" Width="50"
                                               Binding="{Binding BitLength}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Code" Width="100"
                                               Binding="{Binding Bits}"/>
            </tableView:TableView.Columns>
        </tableView:TableView>

            <columnstore:HuffmanTreeControl x:Name="TreeControl" Grid.Column="1"
                                            Grid.Row="1"
                                            Tree="{x:Bind ViewModel.Tree, Mode=OneWay}"
                                            SelectedSymbol="{x:Bind ViewModel.SelectedSymbol, Mode=TwoWay}"/>
        </Grid>

        <StackPanel Grid.Row="0"
                    Grid.Column="2"
                    Visibility="{x:Bind ViewModel.HasHuffmanPage, Mode=OneWay,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Padding="8,8,0,0" FontWeight="SemiBold">Huffman Decoding</TextBlock>
            <columnstore:HuffmanDecodeControl x:Name="DecodeControl" 
                Height="145"
                VerticalAlignment="Top"
                Margin="0"
                Padding="0"
                Steps="{x:Bind ViewModel.DecodeSteps, Mode=OneWay}"
                CodedContent="{x:Bind ViewModel.DecodeContent, Mode=OneWay}"
                SymbolInvoked="Decode_OnSymbolInvoked"
                SelectedStep="{x:Bind ViewModel.SelectedStep, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
