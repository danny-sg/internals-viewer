<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Columnstore.Tabs.Segment.DecodeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tableView="using:WinUI.TableView"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:models="using:InternalsViewer.UI.App.Models.Columnstore.Segment"
    xmlns:page="using:InternalsViewer.UI.App.Controls.Page"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="455"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
           Grid.Column="0"
           Padding="8,6"
           FontWeight="SemiBold"
           Text="Decompressed Payload"/>

        <page:HexViewControl Grid.Row="1"
                             Grid.Column="0"
                             VerticalAlignment="Stretch"
                             IsVirtualized="True"
                             TotalLength="{x:Bind ViewModel.PayloadHex.TotalLength, Mode=OneWay}"
                             WindowOffset="{x:Bind ViewModel.PayloadHex.WindowOffset, Mode=TwoWay}"
                             WindowLength="{x:Bind ViewModel.PayloadHex.WindowLength, Mode=TwoWay}"
                             Data="{x:Bind ViewModel.PayloadHex.HexData, Mode=OneWay}"
                             BaseAddress="{x:Bind ViewModel.PayloadHex.HexBaseAddress, Mode=OneWay}"
                             Markers="{x:Bind ViewModel.PayloadHex.Markers, Mode=OneWay}"
                             SelectedMarker="{x:Bind ViewModel.PayloadHex.SelectedMarker, Mode=OneWay}"/>

        <tableView:TableView Grid.Row="0"
                     Grid.RowSpan="2"
                     Grid.Column="1"
                     AutoGenerateColumns="False"
                     CanSortColumns="False"
                     CanFilterColumns="False"
                     CornerButtonMode="None"
                     HeadersVisibility="Columns"
                     ColumnHeaderStyle="{StaticResource TableViewColumnHeaderStyle}"
                     CellStyle="{StaticResource TableViewCellStyle}"
                     ItemContainerStyle="{StaticResource TableViewRowStyle}"
                     RowHeight="28"
                     SelectionMode="Single"
                     SelectionUnit="Row"
                     IsReadOnly="True"
                     GridLinesVisibility="All"
                     BorderThickness="0"
                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                     SelectionChanged="Values_OnSelectionChanged"
                     SelectedItem="{x:Bind ViewModel.SelectedValue, Mode=TwoWay}"
                     ItemsSource="{x:Bind ViewModel.Values, Mode=OneWay}">
            <tableView:TableView.Resources>
                <x:Double x:Key="ListViewItemMinHeight">0</x:Double>
            </tableView:TableView.Resources>
            <tableView:TableView.Columns>
                <tableView:TableViewTextColumn Header="Index" 
                                               Width="90" 
                                               Binding="{Binding Index}" 
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Offset"
                                               Width="90"
                                               Binding="{Binding OffsetDescription}"
                                               Visibility="{x:Bind ViewModel.HasVariableWidthValues, Mode=OneWay,
                                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Offset"
                                               Width="90"
                                               Binding="{Binding PositionDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Length"
                                               Width="80"
                                               Binding="{Binding Length}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTextColumn Header="Stored" 
                                               Width="140"
                                               Binding="{Binding StoredDescription}"
                                               CellStyle="{StaticResource TableViewCellRightStyle}"/>
                <tableView:TableViewTemplateColumn Header="Value" Width="360">
                    <tableView:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:ValueDetail">
                            <controls:ValueDerivationControl Derivation="{x:Bind Derivation, Mode=OneTime}"/>
                        </DataTemplate>
                    </tableView:TableViewTemplateColumn.CellTemplate>
                </tableView:TableViewTemplateColumn>
            </tableView:TableView.Columns>
        </tableView:TableView>
    </Grid>
</UserControl>
