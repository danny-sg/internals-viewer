<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.DatabaseView"
    x:Name="DatabaseViewUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:models="using:InternalsViewer.UI.App.Models"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StackLayout Orientation="Vertical" x:Key="VerticalStackLayout" />
        <DataTemplate x:Key="AllocationFileTemplate" x:DataType="models:DatabaseFile">
            <Grid Height="{x:Bind Parent.AllocationMapHeight, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Visibility="{x:Bind IsHeaderVisible, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Padding="8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="File"/> <Run Text="{x:Bind FileId, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind FileName, Mode=OneWay}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Visibility="{x:Bind IsViewToggleVisible, Mode=OneWay}"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Switch to tabbed view"
                                Click="OnSwitchToTabsClick">
                            <FontIcon Glyph="&#xE8A9;" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <allocation:AllocationControl Grid.Row="1"
                                              IsTooltipEnabled="{x:Bind Parent.IsTooltipEnabled, Mode=OneWay}"
                                              ExtentCount="{x:Bind Parent.ExtentCount, Mode=OneWay}"
                                              Layers="{x:Bind Parent.AllocationLayers, Mode=OneWay}"
                                              FileId="{x:Bind FileId, Mode=OneWay}"
                                              BorderColor="{ThemeResource CardStrokeColorDefault}"
                                              GridColor="{ThemeResource AllocationBorderColor}"
                                              PfsChain="{x:Bind Parent.PfsChain, Mode=OneWay}"
                                              IsPfsVisible="{x:Bind Parent.IsPfsVisible, Mode=OneWay}"
                                              PageClicked="OnPageSelected"
                                              x:Name="AllocationControl"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AllocationFileTabTemplate" x:DataType="models:DatabaseFile">
            <TabViewItem IsClosable="False">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="File"/> <Run Text="{x:Bind FileId, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                    </StackPanel>
                </TabViewItem.Header>
                <allocation:AllocationControl IsTooltipEnabled="{x:Bind Parent.IsTooltipEnabled, Mode=OneWay}"
                                              ExtentCount="{x:Bind Parent.ExtentCount, Mode=OneWay}"
                                              Layers="{x:Bind Parent.AllocationLayers, Mode=OneWay}"
                                              FileId="{x:Bind FileId, Mode=OneWay}"
                                              BorderColor="{ThemeResource CardStrokeColorDefault}"
                                              GridColor="{ThemeResource AllocationBorderColor}"
                                              PfsChain="{x:Bind Parent.PfsChain, Mode=OneWay}"
                                              IsPfsVisible="{x:Bind Parent.IsPfsVisible, Mode=OneWay}"
                                              PageClicked="OnPageSelected"/>
            </TabViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" x:Name="LayoutGrid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              BorderThickness="0,0,0,1" 
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CommandBar IsOpen="False" 
                        DefaultLabelPosition="Right"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent">
                <AppBarElementContainer>
                    <ToggleSplitButton Content="{x:Bind TabViewModel.Overlay, Mode=OneWay}"
                                       IsChecked="{x:Bind TabViewModel.HasOverlay, Mode=TwoWay}"
                                       Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                       CommandParameter="Overlay">

                        <ToggleSplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="GAM"     
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                                CommandParameter="GAM"/>
                                <MenuFlyoutItem Text="SGAM"   
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                                CommandParameter="SGAM"/>
                                <MenuFlyoutItem Text="PFS"     
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}"
                                                CommandParameter="PFS"/>
                                <MenuFlyoutItem Text="Buffer Pool" 
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                                CommandParameter="Buffer Pool"
                                                IsEnabled="{x:Bind TabViewModel.IsServerConnection}"/>
                                <MenuFlyoutItem Text="DCM"    
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                                CommandParameter="DCM"/>
                                <MenuFlyoutItem Text="BCM"     
                                                Command="{x:Bind TabViewModel.SetOverlayCommand}" 
                                                CommandParameter="BCM"/>
                            </MenuFlyout>
                        </ToggleSplitButton.Flyout>

                    </ToggleSplitButton>
                </AppBarElementContainer>

                <AppBarButton Label="Refresh" 
                              Icon="Refresh" 
                              Command="{x:Bind TabViewModel.RefreshCommand}"/>
                <AppBarButton x:Name="QueryReplayAppBarToggleButton"
                              Label="Query" 
                              Icon="Play"
                              IsEnabled="{x:Bind TabViewModel.IsServerConnection}"
                              Command="{x:Bind TabViewModel.OpenQueryReplayCommand}" />
            </CommandBar>
            <CommandBar 
                Grid.Column="1"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Right">
                <AppBarElementContainer>
                    <controls:PageAddressTextBox x:Name="PageAddressTextBox" 
                                                 DatabaseName="{x:Bind TabViewModel.Database.Name, Mode=OneWay}" />
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <ItemsRepeater
            x:Name="AllocationItemRepeater"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind ToInverseVisibility(TabViewModel.IsTabbedView), Mode=OneWay}"
            ItemsSource="{x:Bind TabViewModel.DatabaseFiles}"
            Layout="{StaticResource VerticalStackLayout}"
            ItemTemplate="{StaticResource AllocationFileTemplate}" />

        <TabView x:Name="AllocationTabView"
                 Grid.Row="1"
                 Visibility="{x:Bind TabViewModel.IsTabbedView, Mode=OneWay}"
                 IsAddTabButtonVisible="False"
                 VerticalAlignment="Stretch"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 TabWidthMode="SizeToContent"
                 SelectionChanged="AllocationTabView_SelectionChanged"
                 TabItemsSource="{x:Bind TabViewModel.DatabaseFiles, Mode=OneWay}"
                 TabItemTemplate="{StaticResource AllocationFileTabTemplate}">
            <TabView.TabStripFooter>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Switch to stacked view"
                        Click="OnSwitchToStackedClick">
                    <FontIcon Glyph="&#xE8A9;" FontSize="12"/>
                </Button>
            </TabView.TabStripFooter>
        </TabView>
    
        <allocation:AllocationLayerGrid Grid.Row="2"
                                        x:Name="AllocationLayerGrid"
                                        SelectedLayers="{x:Bind TabViewModel.SelectedLayers, Mode=TwoWay}"
                                        Layers="{x:Bind TabViewModel.AllocationLayers, Mode=OneWay}"/>
        <toolkit:GridSplitter Grid.Row="2"
                              Height="4"
                              VerticalAlignment="Top">
            <toolkit:GridSplitter.RenderTransform>
                <TranslateTransform Y="-2" />
            </toolkit:GridSplitter.RenderTransform>
        </toolkit:GridSplitter>
        <Border Grid.Row="4"   
                BorderThickness="0,1,0,1" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="6" Orientation="Horizontal"  HorizontalAlignment="Right">
                <ToggleButton Height="24" VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              Padding="12,0,12,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind TabViewModel.IsDisplaySystemObjects, Mode=TwoWay}" >
                    <TextBlock>System Objects</TextBlock>
                </ToggleButton>
                <ToggleButton Height="24" VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              Padding="12,0,12,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind TabViewModel.IsTooltipEnabled, Mode=TwoWay}" >
                    <TextBlock>Tooltip</TextBlock>
                </ToggleButton>
                <ToggleButton Height="24" 
                          Margin="0,0,4,0"
                          Padding="12,0,12,0"
                          BorderThickness="0"
                          x:Name="AllocationInfoAppBarToggleButton"
                          IsChecked="{x:Bind TabViewModel.IsDetailVisible, Mode=TwoWay}">
                    <TextBlock>Details</TextBlock>
                </ToggleButton>
            </StackPanel>
        </Border>

     
    </Grid>
</UserControl>
