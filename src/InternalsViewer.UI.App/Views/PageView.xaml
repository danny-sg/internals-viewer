<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.PageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="using:InternalsViewer.UI.App.Controls.Page"
    xmlns:hexView="using:InternalsViewer.UI.App.Controls.HexView"
    xmlns:models="using:InternalsViewer.UI.App.Models.Page"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TitleStyle" 
               BasedOn="{StaticResource BodyStrongTextBlockStyle}" 
               TargetType="TextBlock" />
        <Style x:Key="SlotHeader" TargetType="Grid" >
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
        </Style>

        <DataTemplate x:Key="SlotTemplate" x:DataType="models:PageSlot">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{x:Bind Index}" 
                           Style="{StaticResource ListTextBlockStyle}"
                           x:Phase="1"/>
                <TextBlock Grid.Column="1" 
                           Text="{x:Bind Offset}" 
                           Style="{StaticResource ListTextBlockStyle}"
                           x:Phase="2"/>
                <TextBlock Grid.Column="2"                  
                           Text="{x:Bind Description}"
                           Style="{StaticResource ListTextBlockStyle}"
                           x:Phase="3"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SlotItemTemplate" x:DataType="models:PageSlot">
            <Grid>
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource ListTextBlockStyle}" Padding="0"/>
            </Grid>
        </DataTemplate>

        <selectors:SlotTemplateSelector x:Key="SlotTemplateSelector" 
                                        ItemTemplate="{StaticResource SlotItemTemplate}"
                                        SlotTemplate="{StaticResource SlotTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="DataColumn"/>
                <ColumnDefinition Width="Auto" x:Name="SlotColumn"/>
                <ColumnDefinition Width="*" x:Name="TabsColumn"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" x:Name="MenuRow"/>
                <RowDefinition Height="*" x:Name="ContentRow"/>
            </Grid.RowDefinitions>

            <!--Command Bar-->
            <Grid Grid.Row="0"
                  Grid.ColumnSpan="3"
                  BorderThickness="0,0,0,1" 
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CommandBar 
                    Grid.Column="0"
                    Background="Transparent" 
                    IsOpen="False"       
                    DefaultLabelPosition="Right" 
                    HorizontalAlignment="Left">
                    <AppBarElementContainer VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Stretch" Margin="12,8,18,0" MinWidth="150">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">Page</TextBlock>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                        </StackPanel>
                    </AppBarElementContainer>
                    <AppBarSeparator />
                    <AppBarElementContainer VerticalAlignment="Stretch" Margin="12,0,0,0" VerticalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                            <TextBlock         Foreground="{ThemeResource TextFillColorSecondaryBrush}">Page Address</TextBlock>
                            <controls:PageAddressTextBox x:Name="PageAddressTextBox" 
                                                         VerticalAlignment="Top"
                                                         PageAddress="{x:Bind ViewModel.PageAddress, Mode=TwoWay}" 
                                                         DatabaseName="{x:Bind ViewModel.Database.Name, Mode=OneWay}" />
                        </StackPanel>
                    </AppBarElementContainer>
                    <AppBarSeparator />
                    <AppBarButton Label="Refresh" 
                                  Icon="Refresh" 
                                  Command="{x:Bind ViewModel.RefreshCommand}"/>
                    <!--<AppBarButton Label="Back" 
                                  Icon="Previous" 
                                  Command="{x:Bind ViewModel.PageBackCommand}" />
                    <AppBarButton Label="Forward" 
                                  Icon="Next" 
                                  Command="{x:Bind ViewModel.PageForwardCommand}"/>-->

                    <AppBarSeparator />

                    <AppBarButton Label="Index" Command="{x:Bind ViewModel.OpenIndexViewCommand}">
                        <AppBarButton.Icon>
                            <BitmapIcon UriSource="ms-appx:///Assets/Index32.png"/>
                        </AppBarButton.Icon>
                    </AppBarButton>

                </CommandBar>

                <CommandBar Grid.Column="1"         
                            Background="Transparent" 
                            IsOpen="False"       
                            Name="AllocationUnitSummaryCommandBar"
                            Visibility="{x:Bind ViewModel.AllocationUnit,
                                                Converter={StaticResource NullToVisibilityConverter},
                                                Mode=OneWay}"
                            DefaultLabelPosition="Right" 
                            HorizontalAlignment="Right">

                    <AppBarElementContainer>
                        <allocation:AllocationUnitSummaryControl
                            AllocationUnit="{x:Bind ViewModel.AllocationUnit, Mode=OneWay}" />
                    </AppBarElementContainer>
                </CommandBar>
                <CommandBar Grid.Column="2"         
                            Background="Transparent" 
                            IsOpen="False"       
                            DefaultLabelPosition="Right" 
                            HorizontalAlignment="Right">
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Border Background="{ThemeResource TextFillColorTertiaryBrush}" 
                                Padding="4" 
                                Visibility="{x:Bind ViewModel.LogRecordsVisibility, Mode=OneWay}"
                                CornerRadius="2">
                            <TextBlock Foreground="White"
                                   Text="{x:Bind ViewModel.ReplayStatus, Mode=OneWay}"/>
                        </Border>
                    </AppBarElementContainer>
                </CommandBar>
            </Grid>

            <!--Hex Data View-->
            <hexView:HexViewControl Grid.Row="1"
                                 Grid.Column="0"
                                 Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                 Width="455" 
                                 VerticalContentAlignment="Stretch"
                                 Margin="14,14,0,14"
                                 Data="{x:Bind ViewModel.Page.Data, Mode=OneWay}"
                                 Markers="{x:Bind ViewModel.Markers, Mode=OneWay}"
                                 SelectedMarker="{x:Bind ViewModel.SelectedMarker, Mode=TwoWay}"
                                 ChangeSpans="{x:Bind ViewModel.ChangeSpans, Mode=OneWay}"
                                 SelectedChangeSpan="{x:Bind ViewModel.SelectedChangeSpan, Mode=OneWay}"
                                 ScrollToOffset="{x:Bind ViewModel.ScrollToOffset, Mode=OneWay}"/>

            <!--Page Slots Table-->
            <Grid x:Name="OffsetTableContainerGrid"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="14,14,0,14" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="OffsetTableHeaderGrid" Style="{StaticResource SlotHeader}" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Slot"/>
                    <TextBlock Grid.Column="1" Text="Offset"/>
                </Grid>

                <ListView x:Name="OffsetTableListView"
                          Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                          BorderThickness="1"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectedItem="{x:Bind ViewModel.SelectedSlot, Mode=TwoWay}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          ItemsSource="{x:Bind ViewModel.PageSlots, Mode=OneWay}"
                          Width="178"
                          IsItemClickEnabled="True"
                          ItemClick="OffsetTableListView_ItemClick"
                          ItemContainerStyle="{StaticResource RowListViewItemStyle}"
                          ItemTemplateSelector="{StaticResource SlotTemplateSelector}"
                          HorizontalAlignment="Left">
                </ListView>
            </Grid>


            <!--Tab View/Log Record view-->
            <Grid Grid.Column="2" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{x:Bind ViewModel.LogRecordsHeight, Mode=OneWay}"/>
                </Grid.RowDefinitions>

                <TabView
                     Margin="14,10,14,0"
                     SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
                     IsAddTabButtonVisible="False"
                     HorizontalAlignment="Stretch"
                     Grid.Row="0"
                     TabWidthMode="SizeToContent">
                    <TabView.Resources>
                    </TabView.Resources>

                    <TabViewItem IsClosable="False"
                                 x:Name="RowDataTabViewItem"
                                 Visibility="{x:Bind ViewModel.IsRowDataTabVisible,
                                                     Converter={StaticResource BoolToVisibilityConverter},
                                                     Mode=OneWay}">
                        <TabViewItem.Header>
                            <TextBlock Text="{x:Bind ViewModel.MarkerTabName, Mode=OneWay}"/>
                        </TabViewItem.Header>
                    </TabViewItem>

                    <TabViewItem IsClosable="False"
                                 x:Name="AllocationTabViewItem"
                                 Visibility="{x:Bind ViewModel.IsAllocationsTabVisible,
                                                     Converter={StaticResource BoolToVisibilityConverter},
                                                     Mode=OneWay}">
                        <TabViewItem.Header>
                            Allocations
                        </TabViewItem.Header>
                    </TabViewItem>
                    <TabViewItem IsClosable="False"
                                 x:Name="PfsTabViewItem"
                                 Visibility="{x:Bind ViewModel.IsPfsTabVisible,
                                                 Converter={StaticResource BoolToVisibilityConverter},
                                                 Mode=OneWay}">
                        <TabViewItem.Header>
                            PFS
                        </TabViewItem.Header>
                    </TabViewItem>
                    <TabViewItem IsClosable="False"
                                 x:Name="DataTabView"
                                 Visibility="{x:Bind ViewModel.IsDataTabVisible,
                                                 Converter={StaticResource BoolToVisibilityConverter},
                                                 Mode=OneWay}">
                        <TabViewItem.Header>
                            Data
                        </TabViewItem.Header>
                    </TabViewItem>
                </TabView>

                <Grid Grid.Row="1" Margin="14,0,14,14">
                    <page:MarkerTreeView x:Name="MarkerTreeView"
                                         Visibility="{x:Bind GetTabContentVisibility(ViewModel.SelectedTabIndex,
                                                             ViewModel.IsRowDataTabVisible, 0), Mode=OneWay}"
                                         Markers="{x:Bind ViewModel.Markers, Mode=OneWay}"
                                         SelectedMarker="{x:Bind ViewModel.SelectedMarker, Mode=TwoWay}"/>

                    <allocation:AllocationControl x:Name="AllocationControl"
                                                  Visibility="{x:Bind GetTabContentVisibility(ViewModel.SelectedTabIndex,
                                                                      ViewModel.IsAllocationsTabVisible, 1), 
                                                                      Mode=OneWay}"
                                                  ExtentCount="63903"
                                                  IsTooltipEnabled="True"
                                                  BorderColor="{ThemeResource CardStrokeColorDefault}"
                                                  GridColor="{ThemeResource AllocationBorderColor}"
                                                  FileId="{x:Bind ViewModel.AllocationFileId, Mode=OneWay}"
                                                  Layers="{x:Bind ViewModel.AllocationLayers, Mode=OneWay}"/>

                    <allocation:AllocationControl x:Name="PfsControl"
                                                  Visibility="{x:Bind GetTabContentVisibility(ViewModel.SelectedTabIndex,
                                                                      ViewModel.IsPfsTabVisible, 2), 
                                                                      Mode=OneWay}"
                                                  ExtentCount="1011"
                                                  IsPfsVisible="true"
                                                  Zoom="2"
                                                  IsTooltipEnabled="True"
                                                  PageClicked="PfsControl_PageClicked"
                                                  StartPage="{x:Bind ViewModel.AllocationStartPage, Mode=OneWay}"
                                                  BorderColor="{ThemeResource CardStrokeColorDefault}"
                                                  GridColor="{ThemeResource AllocationBorderColor}"
                                                  PfsChain="{x:Bind ViewModel.PfsChain, Mode=OneWay}"
                                                  Borders="{x:Bind ViewModel.PfsBorders, Mode=OneWay}"
                                                  Layers="{x:Bind ViewModel.AllocationLayers, Mode=OneWay}"
                                                  FileId="{x:Bind ViewModel.AllocationFileId, Mode=OneWay}"/>

                    <results:ResultsGridControl x:Name="ResultsGrid"
                                                Visibility="{x:Bind GetTabContentVisibility(ViewModel.SelectedTabIndex,
                                                                    ViewModel.IsDataTabVisible, 3), Mode=OneWay}"
                                                ResultSet="{x:Bind ViewModel.RecordsResultSet, Mode=OneWay}"
                                                SelectedRow="{x:Bind ViewModel.SelectedRecordRow, Mode=TwoWay}"/>
                </Grid>

                <toolkit:GridSplitter Grid.Row="2"
                                        x:Name="LogRecordsSplitter"
                                        Height="1"
                                        Visibility="{x:Bind ViewModel.LogRecordsVisibility, Mode=OneWay}"
                                        Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        VerticalAlignment="Stretch">

                </toolkit:GridSplitter>

                <Grid Grid.Row="3"
                      VerticalAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.LogRecordsVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,8,14,0" Spacing="14">
                        <TextBlock Style="{StaticResource LabelTextBlockStyle}">Log Operations</TextBlock>

                    </StackPanel>
                    <page:LogRecordTreeView x:Name="LogRecordTreeView"
                                            Grid.Row="1"
                                            Margin="14,10,14,14"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Records="{x:Bind ViewModel.LogRecords, Mode=OneWay}"
                                            SelectedRecord="{x:Bind ViewModel.SelectedLogRecord, Mode=TwoWay}"
                                            SelectedAnnotation="{x:Bind ViewModel.SelectedChangeSpan, Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>