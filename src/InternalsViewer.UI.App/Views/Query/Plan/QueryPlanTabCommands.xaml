<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Plan.QueryPlanTabCommands"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Spacing="4">
        <ToggleButton Style="{StaticResource TabCommandToggleStyle}"
                      Visibility="{x:Bind ViewModel.Layout.IsGuideMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      IsChecked="{x:Bind ViewModel.IsGuideStepsVisible, Mode=TwoWay}">
            <TextBlock Text="Steps" VerticalAlignment="Center" />
        </ToggleButton>
        <Button Style="{StaticResource TabCommandButtonStyle}"
                VerticalAlignment="Stretch"
                Click="OnViewMenuClick"
                ToolTipService.ToolTip="Select what is visible on the plan">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="View" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
