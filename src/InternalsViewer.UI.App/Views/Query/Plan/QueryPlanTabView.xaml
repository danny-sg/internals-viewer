<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Plan.QueryPlanTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:query="using:InternalsViewer.UI.App.Controls.Query"
    xmlns:plan="using:InternalsViewer.UI.App.Controls.Query.Plan"
    xmlns:plans="using:InternalsViewer.Query.Plans"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StackLayout Orientation="Vertical" Spacing="24" x:Key="PlanStackLayout" />
        <DataTemplate x:Key="ExecutionPlanTemplate" x:DataType="plans:ExecutionPlan">
            <plan:ExecutionPlanControl Plan="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind BodyColumnWidth, Mode=OneTime}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{x:Bind DetailColumnWidth, Mode=OneTime}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Bind BodyRowHeight, Mode=OneTime}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{x:Bind DetailRowHeight, Mode=OneTime}" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind GetStepsWidth(ViewModel.Layout.IsGuideMode, ViewModel.IsGuideStepsVisible), Mode=OneWay}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{x:Bind GetGuidePaneHeight(ViewModel.Layout.IsGuideMode), Mode=OneWay}"
                               MinHeight="{x:Bind GetGuidePaneMinHeight(ViewModel.Layout.IsGuideMode), Mode=OneWay}" />
            </Grid.RowDefinitions>

            <Slider Grid.Row="0"
                    Margin="12,0,12,0"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.GuideStepMaximum, Mode=OneWay}"
                    StepFrequency="1"
                    IsThumbToolTipEnabled="False"
                    Value="{x:Bind ViewModel.GuideStepIndex, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.Layout.IsGuideMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTipService.ToolTip="How far through the steps the current step is. Drag to move through them" />

            <ScrollViewer x:Name="PlanScroller"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.25"
                          MaxZoomFactor="4.0"
                          Background="White"
                          Padding="8">
                <ItemsRepeater x:Name="PlanRepeater"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ItemsSource="{x:Bind ViewModel.ExecutionPlans, Mode=OneWay}"
                               Layout="{StaticResource PlanStackLayout}"
                               ItemTemplate="{StaticResource ExecutionPlanTemplate}" />
            </ScrollViewer>

            <query:NoQueryHint Grid.Row="1"
                               Layout="{x:Bind ViewModel.Layout, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsNoQueryHintVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <controls:GridSplitter Grid.Row="2"
                                   Grid.Column="0"
                                   Height="4"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Rows"
                                   Visibility="{x:Bind ViewModel.Layout.IsGuideMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Row="3"
                  Visibility="{x:Bind ViewModel.Layout.IsGuideMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            Padding="12,6,12,6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                    <Image Width="24"
                           Height="24"
                           VerticalAlignment="Center"
                           Source="{x:Bind GetIconSource(ViewModel.GuideOperatorIcon), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.GuideOperatorName, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="1" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4" Padding="12,8,12,10">
                            <controls:MarkdownTextBlock x:Name="GuideNameText"
                                                        Text="{x:Bind ViewModel.GuideName, Mode=OneWay}"
                                                        FontSize="12"
                                                        FontWeight="Bold">
                                                        <controls:MarkdownTextBlock.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="Consolas" />
                                                            </Style>
                                                        </controls:MarkdownTextBlock.Resources>
                            </controls:MarkdownTextBlock>
                            <controls:MarkdownTextBlock x:Name="GuideDescriptionText"
                                                        Text="{x:Bind ViewModel.GuideDescription, Mode=OneWay}"
                                                        FontSize="12">
                                                        <controls:MarkdownTextBlock.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="Consolas" />
                                                            </Style>
                                                        </controls:MarkdownTextBlock.Resources>
                            </controls:MarkdownTextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Padding="12,0,12,10">
                        <Button HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.GuidePreviousCommand}"
                                ToolTipService.ToolTip="Previous Step">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE892;" FontSize="12" />
                                <TextBlock Text="Previous" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.GuideNextCommand}"
                                ToolTipService.ToolTip="Next Step">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Next" />
                                <FontIcon Glyph="&#xE893;" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <controls:GridSplitter Grid.Row="0"
                                   Grid.RowSpan="4"
                                   Grid.Column="1"
                                   Width="4"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Columns"
                                   Visibility="{x:Bind GetStepsVisibility(ViewModel.Layout.IsGuideMode, ViewModel.IsGuideStepsVisible), Mode=OneWay}"
                                   Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Row="0"
                  Grid.RowSpan="4"
                  Grid.Column="2"
                  Visibility="{x:Bind GetStepsVisibility(ViewModel.Layout.IsGuideMode, ViewModel.IsGuideStepsVisible), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Padding="8,4,16,4"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="4,0,0,1"
                               VerticalAlignment="Center"
                               Text="Steps" />
                    <Button Grid.Column="1"
                            Click="{x:Bind CloseStepsPane}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <results:ResultsGridControl Grid.Row="1"
                                            ResultSet="{x:Bind ViewModel.GuideStepsTable, Mode=OneWay}"
                                            SelectedRow="{x:Bind ViewModel.SelectedGuideStep, Mode=TwoWay}"
                                            RowName="step" />
            </Grid>
        </Grid>

        <controls:GridSplitter Grid.Row="0"
                               Grid.Column="1"
                               Width="4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ResizeBehavior="PreviousAndNext"
                               ResizeDirection="Columns"
                               Visibility="{x:Bind ColumnSplitterVisibility, Mode=OneTime}"
                               Background="{ThemeResource ControlStrokeColorDefaultBrush}">
            <controls:GridSplitter.Template>
                <ControlTemplate TargetType="controls:GridSplitter">
                    <Grid Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </controls:GridSplitter.Template>
        </controls:GridSplitter>

        <controls:GridSplitter Grid.Row="1"
                               Grid.Column="0"
                               Height="4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ResizeBehavior="PreviousAndNext"
                               ResizeDirection="Rows"
                               Visibility="{x:Bind RowSplitterVisibility, Mode=OneTime}"
                               Background="{ThemeResource ControlStrokeColorDefaultBrush}">
            <controls:GridSplitter.Template>
                <ControlTemplate TargetType="controls:GridSplitter">
                    <Grid Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </controls:GridSplitter.Template>
        </controls:GridSplitter>

        <Grid x:Name="DetailPane"
              Grid.Row="0"
              Grid.Column="2"
              Visibility="{x:Bind DetailPaneVisibility, Mode=OneTime}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="{x:Bind DetailPaneBorderThickness, Mode=OneTime}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Padding="8,4,16,4"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="4,0,0,1"
                           VerticalAlignment="Center"
                           Text="Properties" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Click="{x:Bind ToggleDetailPaneDock}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind DockToggleTooltip, Mode=OneTime}">
                        <FontIcon Glyph="{x:Bind DockToggleGlyph, Mode=OneTime}" FontSize="12" />
                    </Button>
                    <Button Click="{x:Bind CloseDetailPane}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <plan:PlanNodePropertiesView Grid.Row="1"
                                         Node="{x:Bind ViewModel.SelectedPlanNode, Mode=OneWay}"
                                         EventStatistics="{x:Bind ViewModel.SelectedPlanNodeEventStatistics, Mode=OneWay}"
                                         Expressions="{x:Bind ViewModel.SelectedPlanExpressions, Mode=OneWay}"
                                         ScanMode="{x:Bind ViewModel.SelectedPlanNodeScanMode, Mode=OneWay}"
                                         ColumnNames="{x:Bind ViewModel.SelectedPlanNodeColumnNames, Mode=OneWay}" />
        </Grid>
    </Grid>

</UserControl>
