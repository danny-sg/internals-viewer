<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternalsViewer.UI.App.Views.Query.QueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:docking="using:InternalsViewer.UI.App.Controls.Docking"
    xmlns:icons="using:InternalsViewer.UI.App.Controls.Icons"
    xmlns:timeline="using:InternalsViewer.UI.App.Controls.Query.Timeline"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu/Command Bar -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,0">
            <CommandBar DefaultLabelPosition="Right" 
                        OverflowButtonVisibility="Collapsed"
                        IsDynamicOverflowEnabled="False"
                        HorizontalContentAlignment="Stretch"
                        Height="32">
                <CommandBar.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Center">
                            <icons:QueryIcon VerticalAlignment="Center">
                                <icons:QueryIcon.RenderTransform>
                                    <TranslateTransform Y="1"/>
                                </icons:QueryIcon.RenderTransform>
                            </icons:QueryIcon>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                Query
                            </TextBlock>
                        </StackPanel>
                        <AppBarSeparator Grid.Column="1"/>
                        <MenuBar Grid.Column="2"
                                 Height="32"
                                 Padding="0">
                            <MenuBar.Resources>
                                <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

                            </MenuBar.Resources>
                            <MenuBarItem Title="View">
                                <ToggleMenuFlyoutItem Text="SQL Editor"
                                   IsChecked="{x:Bind ViewModel.Layout.IsSqlEditorVisible, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Allocations"
                                   IsChecked="{x:Bind ViewModel.Layout.IsAllocationsVisible, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Execution Plan"
                                   IsChecked="{x:Bind ViewModel.Layout.IsExecutionPlanVisible, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Events"
                                   IsChecked="{x:Bind ViewModel.Layout.IsEventsVisible, Mode=TwoWay}"
                                   IsEnabled="{x:Bind ViewModel.Layout.CanShowEventViews, Mode=OneWay}"/>

                                <MenuFlyoutSubItem Text="Calls">
                                    <ToggleMenuFlyoutItem Text="Call Tree"
                                       IsChecked="{x:Bind ViewModel.Layout.IsCallTreeVisible, Mode=TwoWay}"/>
                                    <MenuFlyoutSeparator/>
                                    <ToggleMenuFlyoutItem Text="Members"
                                       IsChecked="{x:Bind ViewModel.Layout.IsCallTreeMembersVisible, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Symbols"
                                       IsChecked="{x:Bind ViewModel.Layout.IsCallTreeSymbolsVisible, Mode=TwoWay}"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem Text="Timeline"
                                   IsChecked="{x:Bind ViewModel.Layout.IsTimelineVisible, Mode=TwoWay}"
                                   IsEnabled="{x:Bind ViewModel.Layout.CanShowEventViews, Mode=OneWay}"/>
                                <ToggleMenuFlyoutItem Text="Trace Timeline"
                                   IsChecked="{x:Bind ViewModel.Layout.IsTraceTimelineVisible, Mode=TwoWay}"
                                   IsEnabled="{x:Bind ViewModel.Layout.IsTrace, Mode=OneWay}"/>
                                <ToggleMenuFlyoutItem Text="Pin Timeline"
                                   IsChecked="{x:Bind Settings.PinTimeline, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Simulation"
                                   IsChecked="{x:Bind ViewModel.IsSimulationVisible, Mode=TwoWay}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Reset Layout"
                             Command="{x:Bind ViewModel.ResetLayoutCommand}"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem Text="Instructions"
                                   IsChecked="{x:Bind ViewModel.Layout.IsInstructionsVisible, Mode=TwoWay}"/>
                            </MenuBarItem>

                            <MenuBarItem Title="Query">
                                <ToggleMenuFlyoutItem Text="Track query"
                                   IsChecked="{x:Bind ViewModel.TrackQuery, Mode=TwoWay}"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem Text="Crop to query"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.CropToQuery, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Include system objects"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.IncludeSystemObjects, Mode=TwoWay}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Open all indexes"
                                                Command="{x:Bind ViewModel.OpenIndexesCommand}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Export to file"
                                                Command="{x:Bind ViewModel.ExportRunCommand}"/>
                                <MenuFlyoutItem Text="Import from file"
                                                Command="{x:Bind ViewModel.ImportRunCommand}"/>
                            </MenuBarItem>
               

                            <MenuBarItem Title="Events">
                                <MenuFlyoutSubItem Text="Locks">
                                    <MenuFlyoutItem Text="None"
                                 Command="{x:Bind ViewModel.QueryOptions.NoLockModeCategoriesCommand}"/>
                                    <MenuFlyoutSeparator/>
                                    <ToggleMenuFlyoutItem Text="Read"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowReadLocks, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Update"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowUpdateLocks, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Write"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowWriteLocks, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Schema"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowSchemaLocks, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Range"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowRangeLocks, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Bulk"
                                       IsChecked="{x:Bind ViewModel.QueryOptions.ShowBulkLocks, Mode=TwoWay}"/>
                     
                                    <MenuFlyoutItem Text="Default"
                                 Command="{x:Bind ViewModel.QueryOptions.DefaultLockModeCategoriesCommand}"/>
                                </MenuFlyoutSubItem>

                                <ToggleMenuFlyoutItem Text="Waits"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.ShowWaits, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Latches"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.ShowLatches, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Columnstore"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.IncludeColumnstore, Mode=TwoWay}"/>
                                <ToggleMenuFlyoutItem Text="Memory"
                                   IsChecked="{x:Bind ViewModel.QueryOptions.IncludeMemory, Mode=TwoWay}"/>
                            </MenuBarItem>

                            <MenuBarItem Title="Trace">
                                <ToggleMenuFlyoutItem Text="Record Full Trace"
                                                      IsChecked="{x:Bind ViewModel.QueryOptions.RecordTimeTravel, Mode=OneWay}"
                                                      Click="OnRecordTimeTravelClick"/>
                                <MenuFlyoutSubItem Text="Capture">
                                    <MenuFlyoutSubItem Text="Heap Memory">
                                        <ToggleMenuFlyoutItem Text="Reads"
                                                              IsChecked="{x:Bind ViewModel.QueryOptions.CaptureHeapReads, Mode=TwoWay}"/>
                                        <ToggleMenuFlyoutItem Text="Writes"
                                                              IsChecked="{x:Bind ViewModel.QueryOptions.CaptureHeapWrites, Mode=TwoWay}"/>
                                    </MenuFlyoutSubItem>
                                    <ToggleMenuFlyoutItem Text="Stack Memory"
                                                          IsChecked="{x:Bind ViewModel.QueryOptions.CaptureStackMemory, Mode=TwoWay}"/>
                                    <ToggleMenuFlyoutItem Text="Page Reads"
                                                          IsChecked="{x:Bind ViewModel.QueryOptions.CapturePageReads, Mode=TwoWay}"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Search symbols"
                                                Command="{x:Bind ViewModel.SearchSymbolsCommand}"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Operator Tracks"
                                                Command="{x:Bind ViewModel.ShowOperatorTracksCommand}"/>
                                <MenuFlyoutSeparator                                                 Visibility="{x:Bind ViewModel.MemoryHistory.IsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <MenuFlyoutItem Text="Object Graph"
                                                Command="{x:Bind ViewModel.ShowObjectGraphCommand}"
                                                Visibility="{x:Bind ViewModel.MemoryHistory.IsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </MenuBarItem>

                        </MenuBar>
                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind GetRulerVisibility(Settings.PinTimeline, ViewModel.IsRulerAvailable), Mode=OneWay}">
                            <timeline:PinnedTransport x:Name="PinnedTransport"
                                                      Source="{x:Bind ViewModel.RulerSource, Mode=OneWay}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="3"
                                      Margin="-6,1,0,0"
                                      Style="{StaticResource TabCommandToggleStyle}"
                                      Padding="4,0,4,2"
                                      IsChecked="{x:Bind ViewModel.QueryOptions.RecordTimeTravel, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.QueryOptions.RecordTimeTravel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTipService.ToolTip="Full Trace is on for the next run. Click to turn it off.">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#C42B1C" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#AE2617" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#962113" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                            </ToggleButton.Resources>
                            <TextBlock Text="Full Trace" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </ToggleButton>
                    </Grid>

                </CommandBar.Content>
            </CommandBar>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="0,8,0,0"
                Visibility="{x:Bind GetRulerVisibility(Settings.PinTimeline, ViewModel.IsRulerAvailable), Mode=OneWay}">
            <Border Padding="0,4,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,1">
                <timeline:TimelineRuler x:Name="PinnedRuler"
                                        Source="{x:Bind ViewModel.RulerSource, Mode=OneWay}"
                                        IsPinned="{x:Bind Settings.PinTimeline, Mode=TwoWay}"/>
            </Border>
        </Border>

        <!--Tabs (dockable / splittable document region)-->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <docking:DockHost x:Name="DockHostControl"
                              Layout="{x:Bind ViewModel.Layout.Dock, Mode=OneWay}"/>
        </Border>

    </Grid>
</Page>
