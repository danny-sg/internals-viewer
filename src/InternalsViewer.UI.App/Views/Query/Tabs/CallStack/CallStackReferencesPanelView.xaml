<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallStackReferencesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:members="using:InternalsViewer.UI.App.Models.Query.CallStack"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors">

    <UserControl.Resources>
        <members:ValueDisplay x:Key="ValueDisplay"/>

        <DataTemplate x:Key="ValueTypeTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ((members:ValueTypeRow)Content).ToolTip}">
                <TextBlock Text="Type"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:ValueTypeRow)Content).Name}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource CppClassBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ValueGroupTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ((members:ValueUseGroup)Content).Title}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:ValueUseGroup)Content).CountLabel}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ValueFunctionTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ((members:ValueUseRow)Content).Function}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:ValueUseRow)Content).Location}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:ValueUseRow)Content).Calls}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ValueCallTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ((members:ValueCallRow)Content).Call}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="Show this call in the call tree and the Flame Chart"/>
                <TextBlock Text="{x:Bind ((members:ValueCallRow)Content).Thread}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <callStack:CallSignatureLine Parts="{x:Bind ((members:ValueCallRow)Content).Signature}"
                                             IsDecoded="{Binding IsDecoded, Source={StaticResource ValueDisplay}, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ValueNoteTemplate" x:DataType="muxc:TreeViewNode">
            <TextBlock Text="{x:Bind ((members:ValueNoteRow)Content).Label}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <selectors:ValueTreeTemplateSelector x:Key="ValueTreeTemplateSelector"
                                               TypeTemplate="{StaticResource ValueTypeTemplate}"
                                               GroupTemplate="{StaticResource ValueGroupTemplate}"
                                               FunctionTemplate="{StaticResource ValueFunctionTemplate}"
                                               CallTemplate="{StaticResource ValueCallTemplate}"
                                               NoteTemplate="{StaticResource ValueNoteTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6,16,6"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock controls:HexText.Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <ProgressRing Width="12"
                              Height="12"
                              IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <muxc:TreeView x:Name="ValueTree"
                       Grid.Row="1"
                       ItemTemplateSelector="{StaticResource ValueTreeTemplateSelector}"
                       SelectionMode="None"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Background="{ThemeResource LayerFillColorDefaultBrush}"
                       Expanding="OnValueTreeExpanding"
                       ItemInvoked="OnValueTreeItemInvoked"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled">
            <muxc:TreeView.ItemContainerStyle>
                <Style TargetType="muxc:TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="MinHeight" Value="22"/>
                </Style>
            </muxc:TreeView.ItemContainerStyle>
        </muxc:TreeView>
    </Grid>
</UserControl>
