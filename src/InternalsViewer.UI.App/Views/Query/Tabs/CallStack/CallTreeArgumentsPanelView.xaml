<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallTreeArgumentsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,6,16,6"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy Signature" Click="OnCopySignatureClick"/>
                </MenuFlyout>
            </Border.ContextFlyout>

            <TextBlock VerticalAlignment="Center"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Arguments.Signature, Mode=OneWay}"
                       callStack:SignatureText.Signature="{x:Bind ViewModel.Arguments.Signature, Mode=OneWay}"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.Arguments.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Arguments.Message, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <results:ResultsGridControl Grid.Row="1"
                                    ResultSet="{x:Bind ViewModel.Arguments.CallTable, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.Arguments.SelectedCall, Mode=TwoWay}"
                                    RowDetails="{x:Bind ViewModel.Arguments.RowDetails, Mode=OneWay}"
                                    Version="{x:Bind ViewModel.Arguments.CallTableVersion, Mode=OneWay}"
                                    PageClicked="OnArgumentPageClicked"
                                    ObjectClicked="OnArgumentObjectClicked"
                                    CellMenuOpening="OnArgumentCellMenuOpening"
                                    RowName="call"
                                    Visibility="{x:Bind ViewModel.Arguments.HasCalls, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Arguments.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.Arguments.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.Arguments.LoadingMessage, Mode=OneWay}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
