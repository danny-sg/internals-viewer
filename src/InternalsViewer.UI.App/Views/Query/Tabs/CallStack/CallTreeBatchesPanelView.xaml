<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallTreeBatchesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results"
    xmlns:callStack="using:InternalsViewer.UI.App.Views.Query.Tabs.CallStack"
    xmlns:batch="using:InternalsViewer.UI.App.Models.Query.Simulation.Batch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition x:Name="BatchSplitterRow" Height="0" />
            <RowDefinition x:Name="BatchRow" Height="0" />
            <RowDefinition x:Name="SplitterRow" Height="0" />
            <RowDefinition x:Name="DetailRow" Height="0" />
        </Grid.RowDefinitions>

        <results:ResultsGridControl x:Name="BatchGrid"
                                    Grid.Row="0"
                                    ResultSet="{x:Bind ViewModel.Table, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                                    Version="{x:Bind ViewModel.TableVersion, Mode=OneWay}"
                                    CallClicked="OnCallClicked"
                                    CellMenuOpening="OnCellMenuOpening"
                                    RowName="batch"/>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <ProgressRing Grid.Row="0"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <toolkit:GridSplitter x:Name="BatchSplitter"
                              Grid.Row="1"
                              Height="6"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />

        <callStack:CallTreeBatchDetailsView x:Name="BatchView" Grid.Row="2" Visibility="Collapsed" />

        <toolkit:GridSplitter x:Name="DetailSplitter"
                              Grid.Row="3"
                              Height="6"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />

        <Grid x:Name="DetailPane" Grid.Row="4" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="10,1,4,1"
                    BorderThickness="0,1,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.DetailHeading, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1"
                            Click="OnCloseDetailClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Detail, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0,2,0,6">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="batch:BatchDetailItem">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <controls:CopyTextBlock Grid.Column="1"
                                                    Value="{x:Bind Value}"
                                                    FontFamily="{x:Bind IsMonospaced, Converter={StaticResource BoolToFontFamilyConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
