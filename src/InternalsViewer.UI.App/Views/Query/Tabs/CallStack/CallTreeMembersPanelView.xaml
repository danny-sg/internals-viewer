<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallTreeMembersPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:symbols="using:InternalsViewer.UI.App.Models.Query.CallStack.Symbols">

    <UserControl.Resources>
        <DataTemplate x:Key="MemberRowTemplate" x:DataType="symbols:ClassMemberRow">
            <callStack:ClassMemberLine/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="8,4,16,4"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource TabCommandButtonStyle}"
                    Click="OnMembersBackClick"
                    IsEnabled="{x:Bind ViewModel.Symbols.CanGoBackMembers, Mode=OneWay}"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
            </Button>
            <TextBlock Grid.Column="1"
                       Margin="4,0,0,1"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.Symbols.MembersClassName, Mode=OneWay}"/>
            <TextBlock Grid.Column="2"
                       Margin="10,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.Symbols.MembersSummary, Mode=OneWay}"/>
        </Grid>

        <AutoSuggestBox x:Name="MembersSearchBox"
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                        BorderThickness="0"
                        FontSize="12"
                        Height="28"
                        TextChanged="OnMembersSearchTextChanged"/>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.Symbols.MembersMessage, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Symbols.MembersMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Symbols.FilteredMembers, Mode=OneWay}"
                  ItemTemplate="{StaticResource MemberRowTemplate}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="22"/>
                    <Setter Property="Padding" Value="12,0,12,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Symbols.IsMembersLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.Symbols.IsMembersLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="Loading..." HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
