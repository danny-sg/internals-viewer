<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallTreePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors"
    xmlns:model="using:InternalsViewer.Query.CallStack"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:members="using:InternalsViewer.UI.App.Models.Query.CallStack"
    xmlns:converters1="using:InternalsViewer.UI.App.Helpers.Converters.CallStack"
    xmlns:helpers="using:InternalsViewer.UI.App.Helpers">

    <UserControl.Resources>
        <members:ActivityColumnLayout x:Key="ActivityColumn"/>

        <members:CallTreeHighlight x:Key="TreeHighlight"/>

        <Style x:Key="PlainItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ActivityItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="muxc:TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Margin="{ThemeResource TreeViewItemPresenterMargin}"
                              Padding="{ThemeResource TreeViewItemPresenterPadding}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelected}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Width="3"
                                       Height="16"
                                       Fill="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                                       Opacity="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       RadiusX="2"
                                       RadiusY="2"/>

                            <Border x:Name="ActivityCell"
                                    Grid.Column="0"
                                    Width="{Binding Width, Source={StaticResource ActivityColumn}, Mode=OneWay}"
                                    Margin="6,0,4,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border Background="#F0F0F0"
                                        Padding="1"
                                        HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="{x:Bind converters1:ActivityBandBrush.ToolTip(Content), Mode=OneWay}"
                                        Visibility="{x:Bind converters1:ActivityBandBrush.Visibility(Content), Mode=OneWay}">
                                    <Rectangle Height="12"
                                               Fill="{x:Bind converters1:ActivityBandBrush.Fill(Content, IsExpanded), Mode=OneWay}"/>
                                </Border>
                            </Border>

                            <Grid x:Name="MultiSelectGrid"
                                  Grid.Column="1"
                                  Margin="{ThemeResource TreeViewItemMultiSelectSelectedItemBorderMargin}"
                                  Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}"
                                  BorderBrush="Transparent"
                                  BorderThickness="{ThemeResource TreeViewItemBorderThemeThickness}"
                                  CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ExpandCollapseChevron"
                                      Grid.Column="0"
                                      Padding="0"
                                      Opacity="{TemplateBinding GlyphOpacity}"
                                      Background="Transparent">
                                    <TextBlock x:Name="CollapsedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Width="Auto"
                                               Height="12"
                                               Padding="8,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding CollapsedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ExpandedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Width="Auto"
                                               Height="12"
                                               Padding="8,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding ExpandedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  MinHeight="{ThemeResource TreeViewItemContentHeight}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <MenuFlyout x:Key="CallFrameMenu">
            <MenuFlyoutItem Text="Expand All" Click="OnExpandAllClick"/>
            <MenuFlyoutItem Text="Collapse All" Click="OnCollapseAllClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Filter To" Click="OnFilterToClick"/>
            <MenuFlyoutItem Text="Clear Filter" Tag="ClearFilter" Click="OnClearFilterClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutSubItem Text="Copy">
                <MenuFlyoutItem Text="Copy to Clipboard" Click="OnCopySymbolClick"/>
                <MenuFlyoutItem Text="Copy Call Tree to Clipboard" Click="OnCopyCallTreeClick"/>
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="List Members" Click="OnListMembersClick"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Arguments" Tag="ShowArguments" Click="OnShowArgumentsClick"/>
            <MenuFlyoutItem Text="Row Buffers" Tag="ShowRowBuffers" Click="OnShowRowBuffersClick"/>
            <MenuFlyoutItem Text="Batches" Tag="ShowBatches" Click="OnShowBatchesClick"/>
        </MenuFlyout>

        <MenuFlyout x:Key="TreeBackgroundMenu">
            <MenuFlyoutItem Text="Reset" Click="OnResetClick"/>
        </MenuFlyout>

        <DataTemplate x:Key="CallFrameTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        RightTapped="OnNodeRightTapped"
                        ContextFlyout="{StaticResource CallFrameMenu}">
                <Border Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        ToolTipService.ToolTip="Row Buffers"
                        Tapped="OnNodeRowBuffersTapped"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasRowBuffers, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorAttentionBrush}"
                        ToolTipService.ToolTip="Batches"
                        Tapped="OnNodeBatchesTapped"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasBatches, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#61B0E3"
                            CornerRadius="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                            Padding="5,2,5,3"
                            ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).TargetDetail}"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).TargetLabel}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{x:Bind ((model:CallStackNode)Content).CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                            CornerRadius="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                            Padding="5,2,5,3"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasTarget, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).Category}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="0,3,3,0"
                            Padding="5,2,5,3"
                            Background="#4A4A55"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).Operator}"
                                   callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{x:Bind ((model:CallStackNode)Content).Symbol}"
                           callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="3"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).AllocationsLabel}"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasAllocations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind helpers:SizeFormat.Format(((model:CallStackNode)Content).AllocatedBytesIncludingChildren)}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="3"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).LocatorsDetail}"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasLocators, Converter={StaticResource BoolToVisibilityConverter}}">
                    <HyperlinkButton Content="{x:Bind ((model:CallStackNode)Content).LocatorsLabel}"
                                     FontSize="10"
                                     Padding="0"
                                     MinHeight="0"
                                     Click="OnNodeLocatorsClick"/>
                </Border>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CallFrameSignatureTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        RightTapped="OnNodeRightTapped"
                        ContextFlyout="{StaticResource CallFrameMenu}">
                <Border Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        ToolTipService.ToolTip="Row Buffers"
                        Tapped="OnNodeRowBuffersTapped"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasRowBuffers, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorAttentionBrush}"
                        ToolTipService.ToolTip="Batches"
                        Tapped="OnNodeBatchesTapped"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasBatches, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#61B0E3"
                            CornerRadius="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                            Padding="5,2,5,3"
                            ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).TargetDetail}"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).TargetLabel}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{x:Bind ((model:CallStackNode)Content).CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                            CornerRadius="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                            Padding="5,2,5,3"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasTarget, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).Category}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="0,3,3,0"
                            Padding="5,2,5,3"
                            Background="#4A4A55"
                            Visibility="{x:Bind ((model:CallStackNode)Content).HasOperator, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((model:CallStackNode)Content).Operator}"
                                   callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind converters1:CallFrameText.ClassPrefix(Content)}"
                               callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               FontSize="11"
                               Foreground="{ThemeResource CppClassBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock callStack:SignatureText.Signature="{x:Bind converters1:CallFrameText.Signature(Content)}"
                               callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="3"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).AllocationsLabel}"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasAllocations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind helpers:SizeFormat.Format(((model:CallStackNode)Content).AllocatedBytesIncludingChildren)}"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="3"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ((model:CallStackNode)Content).LocatorsDetail}"
                        Visibility="{x:Bind ((model:CallStackNode)Content).HasLocators, Converter={StaticResource BoolToVisibilityConverter}}">
                    <HyperlinkButton Content="{x:Bind ((model:CallStackNode)Content).LocatorsLabel}"
                                     FontSize="10"
                                     Padding="0"
                                     MinHeight="0"
                                     Click="OnNodeLocatorsClick"/>
                </Border>

            </StackPanel>
        </DataTemplate>

        <!-- An operator row (when scoped): a category-coloured pill with the operator, then its table/index.
             Its children are the operator's own call tree followed by its child operators. -->
        <DataTemplate x:Key="OperatorNodeTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Background="{x:Bind ((members:OperatorRow)Content).Operator.Category, Converter={StaticResource OperatorCategoryToBrushConverter}}"
                        CornerRadius="3"
                        Padding="6,2,6,3">
                    <TextBlock Text="{x:Bind ((members:OperatorRow)Content).Operator.OperatorDescription}"
                               callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{x:Bind ((members:OperatorRow)Content).Operator.TargetLabel}"
                           callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <Border CornerRadius="3"
                        Padding="5,2,5,3"
                        Background="#4A4A55"
                        ToolTipService.ToolTip="No call-stack frames could be located for this operator — it is inlined, captured no events of its own, or its iterator class is not in the mappings. It keeps its place in the plan but shows nothing."
                        Visibility="{x:Bind ((members:OperatorRow)Content).Unsegmented, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="no stack"
                               Foreground="#B0B0B8"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OperatorLinkTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Left" Opacity="0.75">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ((members:OperatorLink)Content).Glyph}"
                               FontFamily="{ThemeResource SymbolThemeFontFamily}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Border Background="{x:Bind ((members:OperatorLink)Content).Operator.Category, Converter={StaticResource OperatorCategoryToBrushConverter}}"
                            CornerRadius="3"
                            Padding="6,2,6,3">
                        <TextBlock Text="{x:Bind ((members:OperatorLink)Content).Operator.OperatorDescription}"
                                   callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{x:Bind ((members:OperatorLink)Content).Operator.TargetLabel}"
                               callStack:SearchHighlight.Search="{Binding Text, Source={StaticResource TreeHighlight}, Mode=OneWay}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Height="0"
                           Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="1,2"
                           StrokeDashCap="Round"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EventRowTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Background="#4A4A55"
                        CornerRadius="3"
                        Padding="6,2,6,3">
                    <TextBlock Text="{x:Bind ((members:EventRow)Content).Event.Name}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{x:Bind ((members:EventRow)Content).Event.Description}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RevealedCallFrameTemplate" x:DataType="muxc:TreeViewNode">
            <ContentControl Content="{x:Bind}"
                            ContentTemplate="{StaticResource CallFrameTemplate}"
                            Opacity="0.5"
                            IsTabStop="False"/>
        </DataTemplate>

        <DataTemplate x:Key="RevealedCallFrameSignatureTemplate" x:DataType="muxc:TreeViewNode">
            <ContentControl Content="{x:Bind}"
                            ContentTemplate="{StaticResource CallFrameSignatureTemplate}"
                            Opacity="0.5"
                            IsTabStop="False"/>
        </DataTemplate>

        <selectors:CallTreeNodeTemplateSelector x:Key="NodeTemplateSelector"
                                             FrameTemplate="{StaticResource CallFrameTemplate}"
                                             SignatureFrameTemplate="{StaticResource CallFrameSignatureTemplate}"
                                             RevealedFrameTemplate="{StaticResource RevealedCallFrameTemplate}"
                                             RevealedSignatureFrameTemplate="{StaticResource RevealedCallFrameSignatureTemplate}"
                                             LinkTemplate="{StaticResource OperatorLinkTemplate}"
                                             EventTemplate="{StaticResource EventRowTemplate}"
                                             OperatorTemplate="{StaticResource OperatorNodeTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <callStack:CallSearchBar x:Name="SearchBar"
                                 Grid.Row="0"
                                 CallStack="{x:Bind ViewModel.Query.CallStack, Mode=OneWay}"/>

        <Grid x:Name="FilterHeader"
              Grid.Row="1"
              Visibility="Collapsed"
              Padding="8,4,8,6"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Filtered To"
                       FontSize="11"
                       Margin="0,0,8,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"/>

            <ContentControl x:Name="FilterCurrent"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            IsTabStop="False"
                            ContentTemplateSelector="{StaticResource NodeTemplateSelector}"/>

            <HyperlinkButton Grid.Column="2"
                             Content="Clear Filter"
                             FontSize="11"
                             Padding="4,0,4,0"
                             VerticalAlignment="Center"
                             Click="OnClearFilterClick"/>
        </Grid>

        <Grid x:Name="FocusHeader"
              Grid.Row="2"
              Visibility="Collapsed"
              Padding="8,4,8,6"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="HeaderParent"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            IsTabStop="False"
                            Tapped="OnHeaderParentTapped"
                            ContentTemplateSelector="{StaticResource NodeTemplateSelector}"/>

            <ContentControl x:Name="HeaderCurrent"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            IsTabStop="False"
                            ContentTemplateSelector="{StaticResource NodeTemplateSelector}"/>
        </Grid>

        <Grid x:Name="ActivityHeader"
              Grid.Row="3"
              Visibility="Collapsed"
              Height="10">
            <Border x:Name="ActivitySplitter"
                    Width="7"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    ManipulationMode="TranslateX"
                    ManipulationDelta="OnActivitySplitterDelta"
                    ToolTipService.ToolTip="Drag to resize the activity column">
                <Rectangle Width="1"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            </Border>
        </Grid>

        <muxc:TreeView x:Name="Tree"
                   Grid.Row="4"
                   SelectionMode="Single"
                   ItemInvoked="OnFrameInvoked"
                   Expanding="OnTreeExpanding"
                   ContextRequested="OnTreeContextRequested"
                   CanDragItems="False"
                   CanReorderItems="False"
                   Background="White"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollMode="Enabled"
                   ItemTemplateSelector="{StaticResource NodeTemplateSelector}"
                   ItemContainerStyle="{StaticResource ActivityItemStyle}"/>

        <StackPanel Grid.Row="4"
                    Orientation="Vertical"
                    Spacing="8"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.Query.IsTraceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.Query.IsTraceLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.Query.TraceStatus, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <HyperlinkButton Content="Cancel"
                             FontSize="12"
                             HorizontalAlignment="Center"
                             Command="{x:Bind ViewModel.Query.CancelTraceCommand, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
