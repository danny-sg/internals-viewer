<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.CallTreeRowBuffersPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <results:ResultsGridControl ResultSet="{x:Bind ViewModel.Table, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                                    Version="{x:Bind ViewModel.TableVersion, Mode=OneWay}"
                                    CallClicked="OnCallClicked"
                                    CellMenuOpening="OnCellMenuOpening"
                                    RowName="row buffer"/>

        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</UserControl>
