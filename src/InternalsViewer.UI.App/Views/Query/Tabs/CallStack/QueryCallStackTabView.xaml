<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.QueryCallStackTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:operators="using:InternalsViewer.Query.Events.Operators"
    xmlns:local="using:InternalsViewer.UI.App.Views.Query.Tabs" 
    xmlns:callstack="using:InternalsViewer.Query.CallStack"
    xmlns:callStack="using:InternalsViewer.UI.App.Views.Query.Tabs.CallStack"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:signature="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:members="using:InternalsViewer.UI.App.Models.Query.CallStack"
    xmlns:selectors="using:InternalsViewer.UI.App.Helpers.Selectors"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    xmlns:converters1="using:InternalsViewer.UI.App.Helpers.Converters.CallStack"
    mc:Ignorable="d">

    <UserControl.Resources>
        <members:ActivityColumnLayout x:Key="ActivityColumn"/>

        <Style x:Key="PlainItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ActivityItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="muxc:TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Margin="{ThemeResource TreeViewItemPresenterMargin}"
                              Padding="{ThemeResource TreeViewItemPresenterPadding}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelected}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Width="3"
                                       Height="16"
                                       Fill="{ThemeResource TreeViewItemSelectionIndicatorForeground}"
                                       Opacity="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       RadiusX="2"
                                       RadiusY="2"/>

                            <Border x:Name="ActivityCell"
                                    Grid.Column="0"
                                    Width="{Binding Width, Source={StaticResource ActivityColumn}, Mode=OneWay}"
                                    Margin="6,0,4,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border Background="#F0F0F0"
                                        Padding="1"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind converters1:ActivityBandBrush.Visibility(Content), Mode=OneWay}">
                                    <Rectangle Height="12"
                                               Fill="{x:Bind converters1:ActivityBandBrush.Fill(Content, IsExpanded), Mode=OneWay}"/>
                                </Border>
                            </Border>

                            <Grid x:Name="MultiSelectGrid"
                                  Grid.Column="1"
                                  Margin="{ThemeResource TreeViewItemMultiSelectSelectedItemBorderMargin}"
                                  Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}"
                                  BorderBrush="Transparent"
                                  BorderThickness="{ThemeResource TreeViewItemBorderThemeThickness}"
                                  CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ExpandCollapseChevron"
                                      Grid.Column="0"
                                      Padding="0"
                                      Opacity="{TemplateBinding GlyphOpacity}"
                                      Background="Transparent">
                                    <TextBlock x:Name="CollapsedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Width="Auto"
                                               Height="12"
                                               Padding="8,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding CollapsedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ExpandedGlyph"
                                               Foreground="{TemplateBinding GlyphBrush}"
                                               Width="Auto"
                                               Height="12"
                                               Padding="8,0,0,0"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                               FontSize="{TemplateBinding GlyphSize}"
                                               Text="{TemplateBinding ExpandedGlyph}"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               IsTextScaleFactorEnabled="False"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Grid.Column="1"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  MinHeight="{ThemeResource TreeViewItemContentHeight}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="IsSpellCheckEnabled" Value="False"/>
        </Style>

        <DataTemplate x:Key="MemberRowTemplate" x:DataType="members:ClassMemberRow">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" RightTapped="OnMemberRightTapped">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy Signature" Click="OnCopySignatureClick"/>
                        <MenuFlyoutItem Text="Copy Symbol" Click="OnCopyMemberSymbolClick"/>
                        <MenuFlyoutSubItem Text="WinDbg">
                            <MenuFlyoutItem Text="Set Breakpoint" Click="OnSendMemberWinDbgClick" Tag="Breakpoint" IsEnabled="{x:Bind IsFunction}"/>
                            <MenuFlyoutItem Text="Set Breakpoint With Stack" Click="OnSendMemberWinDbgClick" Tag="BreakpointWithStack" IsEnabled="{x:Bind IsFunction}"/>
                            <MenuFlyoutItem Text="Set Breakpoint, Dump Arguments and Continue" Click="OnSendMemberWinDbgClick" Tag="DumpArguments" IsEnabled="{x:Bind IsFunction}"/>
                            <MenuFlyoutItem Text="Set Breakpoint, Dump Arguments and Break" Click="OnSendMemberWinDbgClick" Tag="DumpArgumentsAndBreak" IsEnabled="{x:Bind IsFunction}"/>
                            <MenuFlyoutItem Text="Set Breakpoint on All Overloads" Click="OnSendMemberWinDbgClick" Tag="BreakpointOnAllOverloads" IsEnabled="{x:Bind IsOverloadedFunction}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Examine Symbol" Click="OnSendMemberWinDbgClick" Tag="ExamineSymbol"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Display Type" Click="OnSendMemberWinDbgClick" Tag="DisplayType"/>
                            <MenuFlyoutItem Text="List Class Symbols" Click="OnSendMemberWinDbgClick" Tag="ListClassSymbols"/>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <TextBlock Text="{x:Bind Prefix}"
                           signature:SearchHighlight.Search="{x:Bind Highlight}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource SqlKeywordBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ClassPrefix}"
                           signature:SearchHighlight.Search="{x:Bind Highlight}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource CppClassBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock signature:SignatureText.Signature="{x:Bind Signature}"
                           signature:SearchHighlight.Search="{x:Bind Highlight}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SymbolModuleTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" RightTapped="OnModuleRightTapped">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Expand all" Click="OnExpandSymbolsClick"/>
                        <MenuFlyoutItem Text="Collapse all" Click="OnCollapseSymbolsClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Exclude module" Click="OnExcludeModuleClick"/>
                        <MenuFlyoutItem Text="Clear module exclusions" Click="OnClearModuleExclusionsClick"/>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <TextBlock Text="{x:Bind ((members:SymbolModuleRow)Content).Module}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource SqlKeywordBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:SymbolModuleRow)Content).CountLabel}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SymbolGroupTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Expand All" Click="OnExpandSymbolsClick"/>
                        <MenuFlyoutItem Text="Collapse All" Click="OnCollapseSymbolsClick"/>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <TextBlock Text="{x:Bind ((members:SymbolGroupRow)Content).Label}"
                           signature:SearchHighlight.Search="{x:Bind ((members:SymbolGroupRow)Content).Highlight}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           Foreground="{ThemeResource CppClassBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((members:SymbolGroupRow)Content).CountLabel}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SymbolMemberTemplate" x:DataType="muxc:TreeViewNode">
            <ContentPresenter Content="{x:Bind Content}" ContentTemplate="{StaticResource MemberRowTemplate}"/>
        </DataTemplate>

        <DataTemplate x:Key="SymbolExclusionsTemplate" x:DataType="muxc:TreeViewNode">
            <HyperlinkButton Content="{x:Bind ((members:SymbolExclusionsRow)Content).Label}"
                             ToolTipService.ToolTip="{x:Bind ((members:SymbolExclusionsRow)Content).Detail}"
                             FontSize="11"
                             Padding="0,2,0,2"
                             Click="OnClearModuleExclusionsClick"/>
        </DataTemplate>

        <selectors:SymbolTreeTemplateSelector x:Key="SymbolTreeTemplateSelector"
                                                ModuleTemplate="{StaticResource SymbolModuleTemplate}"
                                                GroupTemplate="{StaticResource SymbolGroupTemplate}"
                                                MemberTemplate="{StaticResource SymbolMemberTemplate}"
                                                ExclusionsTemplate="{StaticResource SymbolExclusionsTemplate}"/>

        <!-- A call frame row: the Category | Operator badge, the resolved symbol, and (on the selected node) the
             activity histogram. Used for every node in the merged tree, and for the call frames under each operator
             when scoped. -->
        <DataTemplate x:Key="CallFrameTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" RightTapped="OnNodeRightTapped">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Expand All" Click="OnExpandAllClick"/>
                        <MenuFlyoutItem Text="Collapse All" Click="OnCollapseAllClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Copy to Clipboard" Click="OnCopySymbolClick"/>
                        <MenuFlyoutItem Text="Copy Call Tree to Clipboard" Click="OnCopyCallTreeClick"/>
                        <MenuFlyoutSubItem Text="WinDbg">
                            <MenuFlyoutItem Text="Set Breakpoint" Click="OnSendWinDbgClick" Tag="Breakpoint"/>
                            <MenuFlyoutItem Text="Set Breakpoint With Stack" Click="OnSendWinDbgClick" Tag="BreakpointWithStack"/>
                            <MenuFlyoutItem Text="Set Breakpoint, Dump Arguments and Continue" Click="OnSendWinDbgClick" Tag="DumpArguments"/>
                            <MenuFlyoutItem Text="Set Breakpoint, Dump Arguments and Break" Click="OnSendWinDbgClick" Tag="DumpArgumentsAndBreak"/>
                            <MenuFlyoutItem Text="Set Breakpoint at Frame Address" Click="OnSendWinDbgClick" Tag="BreakpointAtFrame"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Examine Symbol" Click="OnSendWinDbgClick" Tag="ExamineSymbol"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Display Type" Click="OnSendWinDbgClick" Tag="DisplayType"/>
                            <MenuFlyoutItem Text="List Class Symbols" Click="OnSendWinDbgClick" Tag="ListClassSymbols"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="List Members" Click="OnListMembersClick"/>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>

                <!-- Category | Operator badge: a single pill; when the frame is a plan operator a second
                     tone (the operator name) is appended, otherwise the category badge stands alone. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{x:Bind ((callstack:CallStackNode)Content).CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                            CornerRadius="{x:Bind ((callstack:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                            Padding="5,2,5,3">
                        <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Category}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="0,3,3,0"
                            Padding="5,2,5,3"
                            Background="#4A4A55"
                            Visibility="{x:Bind ((callstack:CallStackNode)Content).HasOperator, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Operator}"
                                   Foreground="White"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Symbol}"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

            </StackPanel>
        </DataTemplate>

        <!-- An operator row (when scoped): a category-coloured pill with the operator, then its table/index.
             Its children are the operator's own call tree followed by its child operators. -->
        <DataTemplate x:Key="OperatorNodeTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Background="{x:Bind ((callStack:OperatorRow)Content).Operator.Category, Converter={StaticResource OperatorCategoryToBrushConverter}}"
                        CornerRadius="3"
                        Padding="6,2,6,3">
                    <TextBlock Text="{x:Bind ((callStack:OperatorRow)Content).Operator.OperatorDescription}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{x:Bind ((callStack:OperatorRow)Content).Operator.TargetLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <Border CornerRadius="3"
                        Padding="5,2,5,3"
                        Background="#4A4A55"
                        ToolTipService.ToolTip="No call-stack frames could be located for this operator — it is inlined, captured no events of its own, or its iterator class is not in the mappings. It keeps its place in the plan but shows nothing."
                        Visibility="{x:Bind ((callStack:OperatorRow)Content).Unsegmented, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="no stack"
                               Foreground="#B0B0B8"
                               FontSize="9"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OperatorLinkTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Left" Opacity="0.75">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ((callStack:OperatorLink)Content).Glyph}"
                               FontFamily="{ThemeResource SymbolThemeFontFamily}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Border Background="{x:Bind ((callStack:OperatorLink)Content).Operator.Category, Converter={StaticResource OperatorCategoryToBrushConverter}}"
                            CornerRadius="3"
                            Padding="6,2,6,3">
                        <TextBlock Text="{x:Bind ((callStack:OperatorLink)Content).Operator.OperatorDescription}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{x:Bind ((callStack:OperatorLink)Content).Operator.TargetLabel}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Height="0"
                           Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="1,2"
                           StrokeDashCap="Round"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EventRowTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Background="#4A4A55"
                        CornerRadius="3"
                        Padding="6,2,6,3">
                    <TextBlock Text="{x:Bind ((callStack:EventRow)Content).Event.Name}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{x:Bind ((callStack:EventRow)Content).Event.Description}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <callStack:CallstackNodeTemplateSelector x:Key="NodeTemplateSelector"
                                             FrameTemplate="{StaticResource CallFrameTemplate}"
                                             LinkTemplate="{StaticResource OperatorLinkTemplate}"
                                             EventTemplate="{StaticResource EventRowTemplate}"
                                             OperatorTemplate="{StaticResource OperatorNodeTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind BodyColumnWidth, Mode=OneTime}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="{x:Bind DetailColumnWidth, Mode=OneTime}"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Bind BodyRowHeight, Mode=OneTime}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{x:Bind DetailRowHeight, Mode=OneTime}"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            PlaceholderText="Search"
                            QueryIcon="Find"
                            TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                            BorderThickness="0"
                            FontSize="12"
                            Height="28"
                            TextChanged="OnSearchTextChanged"/>

            <Grid x:Name="FocusHeader"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Padding="8,4,8,6"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="HeaderParent"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                IsTabStop="False"
                                Tapped="OnHeaderParentTapped"
                                ContentTemplateSelector="{StaticResource NodeTemplateSelector}"/>

                <ContentControl x:Name="HeaderCurrent"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                IsTabStop="False"
                                ContentTemplateSelector="{StaticResource NodeTemplateSelector}"/>
            </Grid>

            <Grid x:Name="ActivityHeader"
                  Grid.Row="2"
                  Height="10">
                <Border x:Name="ActivitySplitter"
                        Width="7"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        ManipulationMode="TranslateX"
                        ManipulationDelta="OnActivitySplitterDelta"
                        ToolTipService.ToolTip="Drag to resize the activity column">
                    <Rectangle Width="1"
                               HorizontalAlignment="Center"
                               Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                </Border>
            </Grid>

            <muxc:TreeView x:Name="Tree"
                       Grid.Row="3"
                       SelectionMode="Single"
                       ItemInvoked="OnFrameInvoked"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Background="White"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled"
                       ItemTemplateSelector="{StaticResource NodeTemplateSelector}"
                       ItemContainerStyle="{StaticResource ActivityItemStyle}"/>
        </Grid>

        <controls:GridSplitter Grid.Row="0"
                               Grid.Column="1"
                               Width="4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ResizeBehavior="PreviousAndNext"
                               ResizeDirection="Columns"
                               Visibility="{x:Bind ColumnSplitterVisibility, Mode=OneTime}"
                               Background="{ThemeResource ControlStrokeColorDefaultBrush}">
            <controls:GridSplitter.Template>
                <ControlTemplate TargetType="controls:GridSplitter">
                    <Grid Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </controls:GridSplitter.Template>
        </controls:GridSplitter>

        <controls:GridSplitter Grid.Row="1"
                               Grid.Column="0"
                               Height="4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ResizeBehavior="PreviousAndNext"
                               ResizeDirection="Rows"
                               Visibility="{x:Bind RowSplitterVisibility, Mode=OneTime}"
                               Background="{ThemeResource ControlStrokeColorDefaultBrush}">
            <controls:GridSplitter.Template>
                <ControlTemplate TargetType="controls:GridSplitter">
                    <Grid Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </controls:GridSplitter.Template>
        </controls:GridSplitter>

        <Grid x:Name="DetailPane"
              Grid.Row="0"
              Grid.Column="2"
              Visibility="{x:Bind DetailPaneVisibility, Mode=OneTime}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="{x:Bind DetailPaneBorderThickness, Mode=OneTime}">
            <TabView x:Name="DetailTabs"
                     VerticalAlignment="Stretch"
                     IsAddTabButtonVisible="False"
                     CanReorderTabs="False"
                     CanDragTabs="False"
                     TabWidthMode="SizeToContent"
                     SelectionChanged="OnDetailTabChanged">
                <TabView.TabStripFooter>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="8,0,12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Click="{x:Bind ToggleDetailPaneDock}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind DockToggleTooltip, Mode=OneTime}">
                            <FontIcon Glyph="{x:Bind DockToggleGlyph, Mode=OneTime}" FontSize="12"/>
                        </Button>
                        <Button Click="{x:Bind CloseDetailPane}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </TabView.TabStripFooter>

                <TabViewItem Header="Members" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Padding="8,4,16,4"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource TabCommandButtonStyle}"
                                    Click="OnMembersBackClick"
                                    IsEnabled="{x:Bind ViewModel.Symbols.CanGoBackMembers, Mode=OneWay}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Back">
                                <FontIcon Glyph="&#xE72B;" FontSize="12"/>
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Margin="4,0,0,1"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind ViewModel.Symbols.MembersClassName, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2"
                                       Margin="10,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind ViewModel.Symbols.MembersSummary, Mode=OneWay}"/>
                        </Grid>

                        <AutoSuggestBox x:Name="MembersSearchBox"
                                        Grid.Row="1"
                                        Margin="0,0,0,4"
                                        PlaceholderText="Search"
                                        QueryIcon="Find"
                                        TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Height="28"
                                        TextChanged="OnMembersSearchTextChanged"/>

                        <TextBlock Grid.Row="2"
                                   Text="{x:Bind ViewModel.Symbols.MembersMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.Symbols.MembersMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                   FontSize="12"
                                   Margin="12,8,12,8"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>

                        <ListView Grid.Row="2"
                                  ItemsSource="{x:Bind ViewModel.Symbols.FilteredMembers, Mode=OneWay}"
                                  ItemTemplate="{StaticResource MemberRowTemplate}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="22"/>
                                    <Setter Property="Padding" Value="12,0,12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel Grid.Row="2"
                                    Orientation="Vertical"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.Symbols.IsMembersLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.Symbols.IsMembersLoading, Mode=OneWay}"
                                          HorizontalAlignment="Center"/>
                            <TextBlock Text="Loading..." HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Symbols" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <AutoSuggestBox x:Name="SymbolSearchBox"
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            PlaceholderText="Search"
                                            QueryIcon="Find"
                                            TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                                            BorderThickness="0"
                                            FontSize="12"
                                            Height="28"
                                            TextMemberPath="Term"
                                            GotFocus="OnSymbolSearchGotFocus"
                                            TextChanged="OnSymbolSearchTextChanged">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate x:DataType="callstack:SymbolSearchSuggestion">
                                        <TextBlock Text="{x:Bind Display}" FontSize="12"/>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Margin="6,0,8,0"
                                        VerticalAlignment="Center">
                                <ToggleButton Content="Module"
                                              Tag="Module"
                                              FontSize="11"
                                              Padding="6,2,6,3"
                                              BorderThickness="0"
                                              Checked="OnSymbolFieldToggled"
                                              Unchecked="OnSymbolFieldToggled"/>
                                <ToggleButton Content="Class"
                                              Tag="Class"
                                              FontSize="11"
                                              Padding="6,2,6,3"
                                              BorderThickness="0"
                                              Checked="OnSymbolFieldToggled"
                                              Unchecked="OnSymbolFieldToggled"/>
                                <ToggleButton Content="Signature"
                                              Tag="Signature"
                                              FontSize="11"
                                              Padding="6,2,6,3"
                                              BorderThickness="0"
                                              Checked="OnSymbolFieldToggled"
                                              Unchecked="OnSymbolFieldToggled"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind ViewModel.Symbols.SymbolSearchMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.Symbols.SymbolSearchMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                   FontSize="12"
                                   Margin="12,8,12,8"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>

                        <muxc:TreeView x:Name="SymbolTree"
                                       Grid.Row="1"
                                       ItemTemplateSelector="{StaticResource SymbolTreeTemplateSelector}"
                                       SelectionMode="None"
                                       CanDragItems="False"
                                       CanReorderItems="False"
                                       Background="{ThemeResource LayerFillColorDefaultBrush}"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.HorizontalScrollMode="Enabled">
                            <muxc:TreeView.ItemContainerStyle>
                                <Style TargetType="muxc:TreeViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="MinHeight" Value="22"/>
                                </Style>
                            </muxc:TreeView.ItemContainerStyle>
                        </muxc:TreeView>

                        <StackPanel Grid.Row="1"
                                    Orientation="Vertical"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.Symbols.IsSymbolSearchLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="{x:Bind ViewModel.Symbols.IsSymbolSearchLoading, Mode=OneWay}"
                                          HorizontalAlignment="Center"/>
                            <TextBlock Text="Searching..." HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</UserControl>
