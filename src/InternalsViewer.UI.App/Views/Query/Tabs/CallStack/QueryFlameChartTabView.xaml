<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.QueryFlameChartTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:flameChart="using:InternalsViewer.UI.App.Controls.FlameChart"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:InternalsViewer.UI.App.Views.Query.Tabs.CallStack"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StackSplitterRow" Height="0"/>
            <RowDefinition x:Name="StackRow" Height="0"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SearchRow"
              Grid.Row="0"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <callStack:CallSearchBar x:Name="SearchBar"
                                     Grid.Column="0"
                                     CallStack="{x:Bind ViewModel.CallStack, Mode=OneWay}"
                                     KeyDown="OnSearchKeyDown"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="0,2,8,0"
                        Spacing="2">
                <Button Style="{StaticResource TabCommandButtonStyle}"
                        ToolTipService.ToolTip="Previous Match"
                        Click="OnPreviousMatchClick">
                    <FontIcon Glyph="&#xE892;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TabCommandButtonStyle}"
                        ToolTipService.ToolTip="Next Match"
                        Click="OnNextMatchClick">
                    <FontIcon Glyph="&#xE893;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <flameChart:FlameChartControl x:Name="FlameChart"
                                      Grid.Row="1"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      Timeline="{x:Bind ViewModel.FlameChart, Mode=OneWay}"
                                      FullTimeline="{x:Bind ViewModel.FullFlameChart, Mode=OneWay}"
                                      HiddenCategories="{x:Bind Settings.CallTreeHiddenCategorySet, Mode=OneWay}"
                                      PrunedCategories="{x:Bind Settings.CallTreePrunedCategorySet, Mode=OneWay}"
                                      GrantedMemory="{x:Bind ViewModel.GrantedMemory, Mode=OneWay}"
                                      ShowMemory="{x:Bind Settings.FlameChartShowMemory, Mode=OneWay}"
                                      ShowCallStack="{x:Bind Settings.FlameChartShowCallStack, Mode=OneWay}"
                                      MemoryMode="{x:Bind Settings.FlameChartMemoryMode, Mode=TwoWay}"
                                      ColourProvider="{x:Bind ViewModel.EventColours, Mode=OneWay}"
                                      SelectedNode="{x:Bind ViewModel.SelectedCallNode, Mode=OneWay}"
                                      SelectedCall="{x:Bind ViewModel.Arguments.SelectedCallReference, Mode=OneWay}"
                                      CurrentEventLink="{x:Bind ViewModel.CurrentEventLink, Mode=OneWay}"
                                      SweepBetweenEvents="{x:Bind ViewModel.IsTimelinePlaying, Mode=OneWay}"/>

        <toolkit:GridSplitter x:Name="StackSplitter"
                              Grid.Row="2"
                              Height="4"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed"/>

        <local:FlameChartCallStackView x:Name="StackView"
                                       Grid.Row="3"
                                       Visibility="Collapsed"
                                       DataContext="{x:Bind ViewModel.PlayheadStack, Mode=OneWay}"/>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Spacing="8"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsTraceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsTraceLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.TraceStatus, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
