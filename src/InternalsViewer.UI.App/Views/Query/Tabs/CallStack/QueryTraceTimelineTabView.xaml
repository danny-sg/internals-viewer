<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.QueryTraceTimelineTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:trace="using:InternalsViewer.UI.App.Controls.Trace"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:InternalsViewer.UI.App.Views.Query.Tabs.CallStack"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StackSplitterRow" Height="0"/>
            <RowDefinition x:Name="StackRow" Height="0"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid x:Name="SearchRow"
                  Visibility="Collapsed">
                <callStack:CallSearchBar x:Name="SearchBar"
                                         MatchCount="{x:Bind TraceTimeline.SearchMatchCount, Mode=OneWay}"
                                         KeyDown="OnSearchKeyDown">
                    <callStack:CallSearchBar.Commands>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource TabCommandButtonStyle}"
                                    ToolTipService.ToolTip="Previous Match (Shift+Enter)"
                                    IsEnabled="{x:Bind TraceTimeline.HasSearchMatches, Mode=OneWay}"
                                    Click="OnPreviousMatchClick">
                                <FontIcon Glyph="&#xE892;" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource TabCommandButtonStyle}"
                                    ToolTipService.ToolTip="Next Match (Enter)"
                                    IsEnabled="{x:Bind TraceTimeline.HasSearchMatches, Mode=OneWay}"
                                    Click="OnNextMatchClick">
                                <FontIcon Glyph="&#xE893;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </callStack:CallSearchBar.Commands>
                </callStack:CallSearchBar>
            </Grid>

            <callStack:CategoryFilterPanel x:Name="CategoryFilter"
                                           CallStack="{x:Bind ViewModel.CallStack, Mode=OneWay}"/>
        </StackPanel>

        <trace:TraceTimelineControl x:Name="TraceTimeline"
                                      Grid.Row="1"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      Timeline="{x:Bind ViewModel.TraceTimeline, Mode=OneWay}"
                                      FullTimeline="{x:Bind ViewModel.FullTraceTimeline, Mode=OneWay}"
                                      Memory="{x:Bind ViewModel.TraceMemory, Mode=OneWay}"
                                      Lifetimes="{x:Bind ViewModel.TraceLifetimes, Mode=OneWay}"
                                      RowReturnMarks="{x:Bind ViewModel.RowReturnMarks, Mode=OneWay}"
                                      TickTracks="{x:Bind ViewModel.TickTracks, Mode=OneWay}"
                                      HiddenTickTracks="{x:Bind Settings.TraceTimelineHiddenTickTrackSet, Mode=OneWay}"
                                      ColourProvider="{x:Bind ViewModel.EventColours, Mode=OneWay}"
                                      StatementName="{x:Bind ViewModel.StatementName, Mode=OneWay}"
                                      MemoryBlocks="{x:Bind ViewModel.MemoryHistory.MemoryBlocks, Mode=OneWay}"
                                      HiddenCategories="{x:Bind Settings.CallTreeHiddenCategorySet, Mode=OneWay}"
                                      PrunedCategories="{x:Bind Settings.CallTreePrunedCategorySet, Mode=OneWay}"
                                      GrantedMemory="{x:Bind ViewModel.GrantedMemory, Mode=OneWay}"
                                      ShowMemory="{x:Bind Settings.TraceTimelineShowMemory, Mode=TwoWay}"
                                      ShowCallStack="{x:Bind Settings.TraceTimelineShowCallStack, Mode=OneWay}"
                                      MemoryMode="{x:Bind Settings.TraceTimelineMemoryMode, Mode=TwoWay}"
                                      SelectedNode="{x:Bind ViewModel.SelectedCallNode, Mode=OneWay}"
                                      SelectedCall="{x:Bind ViewModel.Arguments.SelectedCallReference, Mode=OneWay}"/>

        <toolkit:GridSplitter x:Name="StackSplitter"
                              Grid.Row="2"
                              Height="4"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed"/>

        <Grid x:Name="StackArea"
              Grid.Row="3"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StackColumn" Width="*"/>
                <ColumnDefinition x:Name="MemorySplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="MemoryColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <local:TraceTimelineCallStackView x:Name="StackView"
                                           Grid.Column="0"
                                           Visibility="Collapsed"
                                           DataContext="{x:Bind ViewModel.PlayheadStack, Mode=OneWay}"/>

            <toolkit:GridSplitter x:Name="MemorySplitter"
                                  Grid.Column="1"
                                  Width="4"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  Visibility="Collapsed"/>

            <local:TraceTimelineMemoryView x:Name="MemoryView"
                                        Grid.Column="2"
                                        Visibility="Collapsed"
                                        DataContext="{x:Bind ViewModel.PlayheadMemory, Mode=OneWay}"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Spacing="8"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsTraceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsTraceLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.TraceStatus, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
