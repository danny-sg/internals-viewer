<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.TraceTimelineCallStackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:callStack="using:InternalsViewer.UI.App.Controls.CallStack">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,0,4,0"
                BorderThickness="0,1,0,1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid MinHeight="32">
                <TextBlock Text="Call Stack"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <callStack:DecodeToggle Margin="0,0,6,0"/>
                    <Button Style="{StaticResource TabCommandButtonStyle}"
                            ToolTipService.ToolTip="Previous Frame"
                            Click="OnStepBackClick">
                        <FontIcon Glyph="&#xE892;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource TabCommandButtonStyle}"
                            ToolTipService.ToolTip="Next Frame"
                            Click="OnStepForwardClick">
                        <FontIcon Glyph="&#xE893;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource TabCommandButtonStyle}"
                            Margin="6,0,0,0"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <callStack:CallStackControl x:Name="Stack" Grid.Row="1"/>
    </Grid>
</UserControl>
