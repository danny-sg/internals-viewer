<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallStack.TraceTimelineMemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hexView="using:InternalsViewer.UI.App.Controls.HexView">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,0,4,0"
                BorderThickness="0,1,0,1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid MinHeight="32" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.ObjectName, Mode=OneWay}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ObjectDetail, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Style="{StaticResource TabCommandButtonStyle}"
                        ToolTipService.ToolTip="Close"
                        Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </Grid>
        </Border>

        <hexView:HexViewControl Grid.Row="1"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                Data="{x:Bind ViewModel.Data, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.Markers, Mode=OneWay}"
                                Watches="{x:Bind ViewModel.Watches, Mode=TwoWay}"
                                IsChangeNavigationEnabled="True"
                                ChangeNavigationRequested="OnChangeNavigationRequested"/>
    </Grid>
</UserControl>
