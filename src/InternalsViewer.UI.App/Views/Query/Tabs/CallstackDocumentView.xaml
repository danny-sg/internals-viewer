<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.CallstackDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:callstack="using:InternalsViewer.Query.Callstack"
    mc:Ignorable="d">

    <!-- The whole query's call stacks merged into one tree: each node is a function, its children the functions it
         called. Infrastructure frames are hidden; the Start dropdown chooses where the tree roots. Populated
         node-first in code-behind so the path to a selected event can be expanded and selected; starts collapsed. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Start root selector (left) -->
            <CommandBar IsOpen="False"
                        Padding="0"
                        VerticalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Top"
                        MinHeight="0"
                        OverflowButtonVisibility="Collapsed"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">
                <AppBarElementContainer VerticalContentAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Start:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="StartCombo"
                                  MinWidth="140"
                                  FontSize="11"
                                  SelectionChanged="OnStartChanged">
                            <!-- Tag is the symbol to root at; empty roots at the (post-infrastructure) top. -->
                            <ComboBoxItem Content="Execute" Tag="CSQLSource::Execute"/>
                            <ComboBoxItem Content="User Thread" Tag=""/>
                        </ComboBox>
                    </StackPanel>
                </AppBarElementContainer>
            </CommandBar>

            <!-- Filter toggles (right): each narrows the tree to a node type. -->
            <CommandBar IsOpen="False"
                        Padding="0"
                        VerticalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalContentAlignment="Top"
                        MinHeight="0"
                        OverflowButtonVisibility="Collapsed"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">
                <AppBarElementContainer VerticalContentAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton x:Name="QueryOperatorsToggle"
                                  BorderThickness="0"
                                  Click="OnFilterChanged">
                        <TextBlock Text="Query Operators" VerticalAlignment="Center"/>
                    </ToggleButton>
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <muxc:TreeView x:Name="Tree"
                       Grid.Row="1"
                       SelectionMode="Single"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- Stretch each row's content to the full item width so the histogram can pin to the right edge. -->
            <muxc:TreeView.ItemContainerStyle>
                <Style TargetType="muxc:TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </muxc:TreeView.ItemContainerStyle>
            <muxc:TreeView.ItemTemplate>
                <DataTemplate x:DataType="muxc:TreeViewNode">
                    <Grid HorizontalAlignment="Stretch" RightTapped="OnNodeRightTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Expand All" Click="OnExpandAllClick"/>
                                <MenuFlyoutItem Text="Collapse All" Click="OnCollapseAllClick"/>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Category | Operator badge: a single pill; when the frame is a plan operator a second
                                 tone (the operator name) is appended, otherwise the category badge stands alone. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{x:Bind ((callstack:CallStackNode)Content).CategoryColour, Converter={StaticResource HexColorToBrushConverter}}"
                                        CornerRadius="{x:Bind ((callstack:CallStackNode)Content).HasOperator, Converter={StaticResource CategoryBadgeCornerConverter}}"
                                        Padding="5,2,5,3">
                                    <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Category}"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="0,3,3,0"
                                        Padding="5,2,5,3"
                                        Background="#4A4A55"
                                        Visibility="{x:Bind ((callstack:CallStackNode)Content).HasOperator, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Operator}"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ((callstack:CallStackNode)Content).Symbol}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Activity histogram: right-aligned, shown only on the selected node — its subtree activity
                             over the query window (taller = hotter), with the selected event's time bucket highlighted,
                             the rest grey. The white background spans the full window so the chart's range (the whole
                             query life) is visible even where buckets are empty. -->
                        <Border Grid.Column="1"
                                Background="White"
                                CornerRadius="2"
                                Padding="1"
                                Margin="10,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ((callstack:CallStackNode)Content).HasHistogram, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{x:Bind ((callstack:CallStackNode)Content).DisplayBars}"
                                          Height="14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="callstack:ActivityBar">
                                        <Rectangle Width="3"
                                                   Height="{x:Bind Height}"
                                                   Margin="0,0,1,0"
                                                   VerticalAlignment="Bottom"
                                                   Fill="{x:Bind Colour, Converter={StaticResource HexColorToBrushConverter}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </DataTemplate>
            </muxc:TreeView.ItemTemplate>
        </muxc:TreeView>
    </Grid>
</UserControl>
