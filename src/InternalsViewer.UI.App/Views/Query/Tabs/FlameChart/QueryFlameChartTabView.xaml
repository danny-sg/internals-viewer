<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.FlameChart.QueryFlameChartTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:flameChart="using:InternalsViewer.UI.App.Controls.FlameChart"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        PlaceholderText="Search Functions"
                        QueryIcon="Find"
                        TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                        BorderThickness="0"
                        FontSize="12"
                        Height="28"
                        Margin="8,4,8,4"
                        TextChanged="OnSearchTextChanged"
                        KeyDown="OnSearchKeyDown"/>

        <flameChart:FlameChartControl x:Name="FlameChart"
                                      Grid.Row="1"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      Timeline="{x:Bind ViewModel.FlameChart, Mode=OneWay}"
                                      GrantedMemory="{x:Bind ViewModel.GrantedMemory, Mode=OneWay}"
                                      ColourProvider="{x:Bind ViewModel.EventColours, Mode=OneWay}"
                                      RootNode="{x:Bind ViewModel.SelectedCallNode, Mode=OneWay}"
                                      SelectedCall="{x:Bind ViewModel.Arguments.SelectedCallReference, Mode=OneWay}"/>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Spacing="8"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsFullTraceLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsFullTraceLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.FullTraceStatus, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
