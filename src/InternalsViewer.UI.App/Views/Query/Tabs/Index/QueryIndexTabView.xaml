<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Index.QueryIndexTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:index="using:InternalsViewer.UI.App.Controls.Index"
    xmlns:predicates="using:InternalsViewer.UI.App.Controls.Predicates"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:accessSteps="using:InternalsViewer.UI.App.Controls.AccessSteps"
    mc:Ignorable="d">
    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--Top Command Bar-->
        <CommandBar Grid.Row="0"
                    IsOpen="False"
                    Padding="12,0,0,0"
                    DefaultLabelPosition="Right"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center"
                                    
                                    Name="PredicateElementContainer">

                <StackPanel Orientation="Horizontal" >
                    <Image Source="{x:Bind ViewModel.IconSource}"
                           Name="NodeImage"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.PlanNode.LogicalOperator}" Padding="0,0,8,0"/>
                    <predicates:PredicateTextBox x:Name="PredicateTextBox"
                                                 Visibility="{x:Bind ViewModel.HasPredicate,
                                                 Mode=OneWay,
                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Text="{x:Bind ViewModel.PredicateText, Mode=OneWay}" />

                </StackPanel>


            </AppBarElementContainer>
            <AppBarButton Label="Step" Command="{x:Bind ViewModel.ToggleStepCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarElementContainer>
                <allocation:AllocationUnitSummaryControl AllocationUnit="{x:Bind ViewModel.AllocationUnit, Mode=OneWay}"
                                                          IsIndex="True" />
            </AppBarElementContainer>
        </CommandBar>

        <CommandBar Grid.Row="0"
                    Grid.Column="1"
                        IsOpen="False"
                        VerticalAlignment="Center"
                        DefaultLabelPosition="Right"
                        HorizontalAlignment="Right"
                        VerticalContentAlignment="Top"
                        MinHeight="0"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        Background="Transparent"
                        BorderThickness="0,0,0,1">
            <CommandBar.SecondaryCommands>

                    <AppBarToggleButton
                        Label="Zoom to fit"
                        IsChecked="{x:Bind ViewModel.IsZoomToFit, Mode=TwoWay}" />
                    <AppBarToggleButton
                        Label="Details"
                        IsChecked="{x:Bind ViewModel.IsDetailPaneVisible, Mode=TwoWay}" />

            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Name="BodyGrid" 
              Grid.Row="1" 
              Grid.Column="0" 
              Grid.ColumnSpan="2" 
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.BodyColumnWidth, Mode=OneWay}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind ViewModel.DetailColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <StackPanel Padding="10"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Visibility="{x:Bind ViewModel.IsInitialized,
                                Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter},
                                ConverterParameter=True}">
                <TextBlock HorizontalAlignment="Center"
                           Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}"/>
                <ProgressBar Width="300"
                             Margin="0,10,0,0"
                             Visibility="{x:Bind ViewModel.IsProgressVisible,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                             Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                             Value="{x:Bind ViewModel.LoadedPageCount, Mode=OneWay}"/>
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.IsProgressVisible,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
            </StackPanel>

            <index:IndexControl x:Name="IndexControl"
                                Grid.Column="0"
                                Background="Transparent"
                                Visibility="{x:Bind ViewModel.IsInitialized,
                                                Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                Nodes="{x:Bind ViewModel.Nodes, Mode=OneWay}"
                                Zoom="{x:Bind ViewModel.Zoom, Mode=TwoWay}"
                                IsZoomToFit="{x:Bind ViewModel.IsZoomToFit, Mode=TwoWay}"
                                IsTooltipEnabled="{x:Bind ViewModel.IsTooltipEnabled, Mode=OneWay}"
                                PageSpans="{x:Bind ViewModel.PageSpans, Mode=OneWay}"
                                PlayheadTimeUs="{x:Bind ViewModel.PlayheadTimeUs, Mode=OneWay}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch" />

            <controls:GridSplitter Grid.Column="1"
                                    Width="4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ResizeBehavior="PreviousAndNext"
                                    ResizeDirection="Columns"
                                    Visibility="{x:Bind ViewModel.DetailSplitterVisibility, Mode=OneWay}"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Column="2"
                  Visibility="{x:Bind ViewModel.DetailSplitterVisibility, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Padding="8,4,4,4"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="4,0,0,1" Text="{x:Bind ViewModel.PlanNode.LogicalOperator}"/>
                        <Button Command="{x:Bind ViewModel.StartStepCommand}">Start</Button>
                        <Button Command="{x:Bind ViewModel.StepNextCommand}">Next</Button>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="{x:Bind CloseDetailPane}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <accessSteps:AccessStepsControl  Grid.Row="1" StepHistory="{x:Bind ViewModel.StepHistory, Mode=OneWay}" CurrentStep="{x:Bind ViewModel.CurrentStep, Mode=OneWay}" />
                <index:RecordGrid Grid.Row="2"
                                  x:Name="RecordGrid"
                                  Records="{x:Bind ViewModel.Records, Mode=OneWay}"
                                  BorderThickness="0" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsRecordsLoading,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsRecordsLoading, Mode=OneWay}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">Loading...</TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
