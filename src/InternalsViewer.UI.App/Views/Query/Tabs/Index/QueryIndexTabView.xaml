<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Index.QueryIndexTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:index="using:InternalsViewer.UI.App.Controls.Index"
    xmlns:predicates="using:InternalsViewer.UI.App.Controls.Predicates"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" IsInverse="True" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">

        <Grid Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.BodyColumnWidth, Mode=OneWay}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind ViewModel.DetailColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <StackPanel Padding="10"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Visibility="{x:Bind ViewModel.IsInitialized,
                                Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter},
                                ConverterParameter=True}">
                <TextBlock HorizontalAlignment="Center"
                           Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}"/>
                <ProgressBar Width="300"
                             Margin="0,10,0,0"
                             Visibility="{x:Bind ViewModel.IsProgressVisible,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                             Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                             Value="{x:Bind ViewModel.LoadedPageCount, Mode=OneWay}"/>
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.IsProgressVisible,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
            </StackPanel>

            <!--Index View-->
            <index:IndexControl x:Name="IndexControl"
                                Grid.Column="0"
                                SelectChildPath="False"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                Visibility="{x:Bind ViewModel.IsInitialized,
                                                Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                Nodes="{x:Bind ViewModel.Nodes, Mode=OneWay}"
                                Zoom="{x:Bind ViewModel.Zoom, Mode=TwoWay}"
                                IsZoomToFit="{x:Bind ViewModel.IsZoomToFit, Mode=TwoWay}"
                                ZoomToSelectedPageAddress="{x:Bind ZoomToPageTarget(ViewModel.IsZoomToPage), Mode=OneWay}"
                                IsTooltipEnabled="{x:Bind ViewModel.IsTooltipEnabled, Mode=OneWay}"
                                IsLevelsVisible="{x:Bind ViewModel.IsLevelsVisible, Mode=OneWay}"
                                PageSpans="{x:Bind ViewModel.PageSpans, Mode=OneWay}"
                                HighlightedPageAddresses="{x:Bind ViewModel.HighlightedPages, Mode=OneWay}"
                                PlayheadTimeUs="{x:Bind ViewModel.PlayheadTimeUs, Mode=OneWay}"
                                SelectedPageAddress="{x:Bind ViewModel.SelectedPageAddress, Mode=TwoWay}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch" 
                                SelectedSlot="{x:Bind ViewModel.SelectedSlot, Mode=OneWay}"/>

            <controls:GridSplitter Grid.Column="1"
                                   Width="4"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Columns"
                                   Visibility="{x:Bind ViewModel.DetailSplitterVisibility, Mode=OneWay}"
                                   Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Column="2"
                  Visibility="{x:Bind ViewModel.DetailSplitterVisibility, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <TabView VerticalAlignment="Stretch"
                         IsAddTabButtonVisible="False"
                         CanReorderTabs="False"
                         TabWidthMode="SizeToContent"
                         CanDragTabs="False">
                    <TabView.TabItems>
                        <TabViewItem Header="Page Data" IsClosable="False">
                            <Grid Opacity="{x:Bind StaleOpacity(ViewModel.IsRecordsStale), Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Padding="8,4,4,4"
                                      
                                      BorderThickness="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                    
                                                   Text="{x:Bind FormatPageAddress(ViewModel.SelectedPageAddress), Mode=OneWay}" />
                                        <Border CornerRadius="4"
                                                Padding="6,0,6,1"
                                                VerticalAlignment="Center"
                                                Background="#5A5A5A"
                                                Visibility="{x:Bind PageTypeVisibility(ViewModel.SelectedPageType), Mode=OneWay}">
                                            <TextBlock Foreground="White"
                                                       FontSize="11"
                                                       Text="{x:Bind ViewModel.SelectedPageType, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Margin="4,0,0,1" Style="{StaticResource LabelTextBlockStyle}">Previous Page</TextBlock>
                                        <HyperlinkButton x:Name="PreviousPageAddressLink"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource PageAddressStyle}"
                                                         IsEnabled="{x:Bind IsPageLinkEnabled(ViewModel.SelectedPreviousPage), Mode=OneWay}"
                                                         Content="{x:Bind ViewModel.SelectedPreviousPage, Mode=OneWay, FallbackValue='(0:0)'}" />
                                        <TextBlock Margin="4,0,0,1" Style="{StaticResource LabelTextBlockStyle}">Next Page</TextBlock>
                                        <HyperlinkButton x:Name="NextPageAddressLink"
                                                         Margin="4,0,0,0"
                                                         Style="{StaticResource PageAddressStyle}"
                                                         IsEnabled="{x:Bind IsPageLinkEnabled(ViewModel.SelectedNextPage), Mode=OneWay}"
                                                         Content="{x:Bind ViewModel.SelectedNextPage, Mode=OneWay, FallbackValue='(0:0)'}" />
                                    </StackPanel>
                                </Grid>
                                <index:RecordGrid Grid.Row="1"
                                                  x:Name="RecordGrid"
                                                  Records="{x:Bind ViewModel.Records, Mode=OneWay}"
                                                  SelectedSlot="{x:Bind ViewModel.SelectedSlot, Mode=OneWay}"
                                                  BorderThickness="0" />
                            </Grid>
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsRecordsLoading,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsRecordsLoading, Mode=OneWay}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">Loading...</TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
