<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.InstructionsDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        <Style TargetType="NavigationViewItem">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <NavigationView x:Name="TopicsNavigation"
                    PaneDisplayMode="Left"
                    IsPaneToggleButtonVisible="False"
                    OpenPaneLength="180"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    AlwaysShowHeader="False"
PaneTitle=""
                    SelectionChanged="TopicsNavigation_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Getting Started"
                                Tag="GettingStarted"
                                IsSelected="True" />
            <NavigationViewItem Content="SQL Editor"
                                Tag="SqlEditor" />
            <NavigationViewItem Content="Choosing Events"
                                Tag="ChoosingEvents" />
            <NavigationViewItem Content="Timeline"
                                Tag="Timeline" />
            <NavigationViewItem Content="Events"
                                Tag="Events" />
            <NavigationViewItem Content="Allocations"
                                Tag="Allocations" />
            <NavigationViewItem Content="Execution Plan"
                                Tag="ExecutionPlan" />
            <NavigationViewItem Content="Call Stack"
                                Tag="CallStack" />
            <NavigationViewItem Content="Log Records"
                                Tag="LogRecords" />
        </NavigationView.MenuItems>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <controls1:MarkdownTextBlock x:Name="MarkdownTextBlock"
                                         Margin="16,8,16,16"
                                         UseAutoLinks="True"
                                         UseEmphasisExtras="True"
                                         UseListExtras="True"
                                         UsePipeTables="True"
                                         UseTaskLists="True"
                                         OnLinkClicked="MarkdownTextBlock_OnLinkClicked" />
        </ScrollViewer>
    </NavigationView>

</UserControl>
