<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.QueryPlanTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plan="using:InternalsViewer.UI.App.Controls.Plan"
    xmlns:plans="using:InternalsViewer.Query.Parsing.Plans"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StackLayout Orientation="Vertical" Spacing="24" x:Key="PlanStackLayout" />
        <DataTemplate x:Key="ExecutionPlanTemplate" x:DataType="plans:ExecutionPlan">
            <plan:ExecutionPlanControl Plan="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0"
                    IsOpen="False"
                    Padding="0"
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right"
                    HorizontalAlignment="Right"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                <ToggleButton Margin="12,0,0,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind HasFlameGraph, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.QueryOptions.IncludeCallStack, Mode=OneWay}">
                    <TextBlock Text="Flame Graph" VerticalAlignment="Center" />
                </ToggleButton>
                    <ToggleButton Margin="12,0,0,0"
                                  BorderThickness="0"
                                  IsChecked="{x:Bind IsPropertiesPaneVisible, Mode=TwoWay}">
                        <TextBlock Text="Properties" VerticalAlignment="Center" />
                    </ToggleButton>
                </StackPanel>
            </AppBarElementContainer>
        </CommandBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind BodyColumnWidth, Mode=OneWay}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind DetailColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.25"
                          MaxZoomFactor="2.0"
                          Background="White"
                          Padding="8">
                <ItemsRepeater x:Name="PlanRepeater"
                               ItemsSource="{x:Bind ViewModel.ExecutionPlans, Mode=OneWay}"
                               Layout="{StaticResource PlanStackLayout}"
                               ItemTemplate="{StaticResource ExecutionPlanTemplate}" />
            </ScrollViewer>

            <controls:GridSplitter Grid.Column="1"
                                   Width="4"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Columns"
                                   Visibility="{x:Bind DetailSplitterVisibility, Mode=OneWay}"
                                   Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Column="2"
                  Visibility="{x:Bind DetailSplitterVisibility, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Padding="8,4,16,4"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="4,0,0,1"
                               VerticalAlignment="Center"
                               Text="Properties" />
                    <Button Grid.Column="1"
                            Click="{x:Bind CloseDetailPane}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <plan:PlanNodePropertiesView Grid.Row="1"
                                             Node="{x:Bind ViewModel.SelectedPlanNode, Mode=OneWay}"
                                             EventStatistics="{x:Bind ViewModel.SelectedPlanNodeEventStatistics, Mode=OneWay}"
                                             Expressions="{x:Bind ViewModel.SelectedPlanExpressions, Mode=OneWay}"
                                             ScanMode="{x:Bind ViewModel.SelectedPlanNodeScanMode, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>

</UserControl>
