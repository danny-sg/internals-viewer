<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.QueryAllocationTabCommands"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Spacing="4">
        <ToggleButton x:Name="BufferPoolToggle"
                      Style="{StaticResource TabCommandToggleStyle}"
                      IsChecked="{x:Bind ViewModel.ShowBufferPool, Mode=OneWay}"
                      Command="{x:Bind ViewModel.ToggleBufferPoolCommand}"
                      CommandParameter="{x:Bind BufferPoolToggle.IsChecked, Mode=OneWay}">
            <TextBlock Text="Buffer Pool" VerticalAlignment="Center" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabCommandToggleStyle}"
                      IsChecked="{x:Bind ViewModel.IsPfsVisible, Mode=TwoWay}">
            <TextBlock Text="PFS" VerticalAlignment="Center" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabCommandToggleStyle}"
                      IsChecked="{x:Bind ViewModel.IsHeatmap, Mode=TwoWay}">
            <TextBlock Text="Heatmap" VerticalAlignment="Center" />
        </ToggleButton>
        <ToggleButton Style="{StaticResource TabCommandToggleStyle}"
                      IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}">
            <TextBlock Text="Auto-Scroll" VerticalAlignment="Center" />
        </ToggleButton>
    </StackPanel>
</UserControl>
