<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.QueryAllocationTabView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:models="using:InternalsViewer.UI.App.Models"
    xmlns:accessSteps="using:InternalsViewer.UI.App.Controls.AccessSteps"
    xmlns:index="using:InternalsViewer.UI.App.Controls.Index"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:InternalsViewer.UI.App.Helpers.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StackLayout Orientation="Vertical" x:Key="VerticalStackLayout" />
        <converters:BoolToVisibilityConverter x:Key="TraceInverseBoolToVisibilityConverter" IsInverse="True" />
        <DataTemplate x:Key="AllocationFileTemplate" x:DataType="models:DatabaseFile">
            <Grid>
                <allocation:AllocationControl IsTooltipEnabled="{x:Bind Parent.IsTooltipEnabled, Mode=OneWay}"
                                              AutoScroll="{Binding ViewModel.AutoScroll, ElementName=Root, Mode=OneWay}"
                                              IsHeatmap="{Binding ViewModel.IsHeatmap, ElementName=Root, Mode=OneWay}"
                                              Height="{x:Bind Parent.AllocationMapHeight, Mode=OneWay}"
                                              ExtentCount="{x:Bind Parent.ExtentCount, Mode=OneWay}"
                                              Layers="{x:Bind Parent.AllocationLayers, Mode=OneWay}"
                                              Borders="{x:Bind Parent.AllocationBorders, Mode=OneWay}"
                                              FileId="{x:Bind FileId, Mode=OneWay}"
                                              BorderColor="{ThemeResource CardStrokeColorDefault}"
                                              GridColor="{ThemeResource AllocationBorderColor}"
                                              PfsChain="{x:Bind Parent.PfsChain, Mode=OneWay}"
                                              IsPfsVisible="{x:Bind Parent.IsPfsVisible, Mode=OneWay}"
                                              PlayheadTimeUs="{x:Bind Parent.PlayheadTimeUs, Mode=OneWay}"
                                              PageClicked="OnPageSelected"
                                              x:Name="AllocationControl"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CommandBar IsOpen="False"
                    Padding="0"            
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    Grid.Row="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">

            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Margin="12,0,0,0"
                              BorderThickness="0"
                              x:Name="BufferPoolToggle"
                              IsChecked="{x:Bind ViewModel.ShowBufferPool, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ToggleBufferPoolCommand}"
                              CommandParameter="{x:Bind BufferPoolToggle.IsChecked, Mode=OneWay}" >
                        <TextBlock Text="Buffer Pool" VerticalAlignment="Center" />
                    </ToggleButton>
                    <ToggleButton Margin="12,0,12,0"
                              BorderThickness="0"
                              x:Name="PfsToggle"
                              IsChecked="{x:Bind ViewModel.IsPfsVisible, Mode=TwoWay}">
                        <TextBlock Text="PFS" VerticalAlignment="Center" />
                    </ToggleButton>
                </StackPanel>
            </AppBarElementContainer>
        </CommandBar>
        <CommandBar IsOpen="False"
                    Padding="0"            
                    VerticalAlignment="Center"
                    DefaultLabelPosition="Right"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    Grid.Row="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Background="Transparent">

            <AppBarElementContainer VerticalContentAlignment="Center">
                <ToggleButton Margin="12,0,12,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.IsHeatmap, Mode=TwoWay}">
                    <TextBlock Text="Heatmap" VerticalAlignment="Center" />
                </ToggleButton>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ToggleButton Margin="0,0,12,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}">
                    <TextBlock Text="Auto-Scroll" VerticalAlignment="Center" />
                </ToggleButton>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ToggleButton Margin="0,0,12,0"
                              BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.AllocationTrace.IsTraceVisible, Mode=TwoWay}">
                    <TextBlock Text="Trace" VerticalAlignment="Center" />
                </ToggleButton>
            </AppBarElementContainer>


        </CommandBar>
        <Grid Grid.Row="1"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.AllocationTrace.BodyColumnWidth, Mode=OneWay}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind ViewModel.AllocationTrace.TraceColumnWidth, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <ItemsRepeater x:Name="AllocationItemRepeater"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Grid.Column="0"
                           ItemsSource="{x:Bind ViewModel.DatabaseFiles, Mode=OneWay}"
                           Layout="{StaticResource VerticalStackLayout}"
                           ItemTemplate="{StaticResource AllocationFileTemplate}" />

            <controls:GridSplitter Grid.Column="1"
                                   Width="4"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ResizeBehavior="PreviousAndNext"
                                   ResizeDirection="Columns"
                                   Visibility="{x:Bind ViewModel.AllocationTrace.TraceVisibility, Mode=OneWay}"
                                   Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                <controls:GridSplitter.Template>
                    <ControlTemplate TargetType="controls:GridSplitter">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </controls:GridSplitter.Template>
            </controls:GridSplitter>

            <Grid Grid.Column="2"
                  Visibility="{x:Bind ViewModel.AllocationTrace.TraceVisibility, Mode=OneWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CommandBar Grid.Column="0"
                                IsOpen="False"
                                Padding="12,0,0,0"
                                DefaultLabelPosition="Right"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Top"
                                MinHeight="0"
                                OverflowButtonVisibility="Collapsed"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CommandBarBackground}">
                        <AppBarButton Label="{x:Bind RunLabel(ViewModel.AllocationTrace.IsRunning), Mode=OneWay}"
                                      Command="{x:Bind ViewModel.AllocationTrace.RunCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="{x:Bind RunGlyph(ViewModel.AllocationTrace.IsRunning), Mode=OneWay}" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Step" Command="{x:Bind ViewModel.AllocationTrace.StepNextCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B5;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Run to End" Command="{x:Bind ViewModel.AllocationTrace.RunToEndCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE893;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Reset" Command="{x:Bind ViewModel.AllocationTrace.ResetStepCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <Button Grid.Column="1"
                            Click="{x:Bind CloseTracePane}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,0,16,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <accessSteps:AccessStepsControl Grid.Row="1"
                                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                                Visibility="{x:Bind ViewModel.AllocationTrace.IsRunningToEnd, Mode=OneWay,
                                                        Converter={StaticResource TraceInverseBoolToVisibilityConverter}}"
                                                StepHistory="{x:Bind ViewModel.AllocationTrace.StepHistory, Mode=OneWay}"
                                                CurrentStep="{x:Bind ViewModel.AllocationTrace.CurrentStep, Mode=OneWay}" />
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind EmptyStepsVisibility(ViewModel.AllocationTrace.StepHistory.Count, ViewModel.AllocationTrace.IsRunningToEnd), Mode=OneWay}"
                           Text="Select Run/Step/Run to end to start trace" />
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.AllocationTrace.IsRunningToEnd,
                                    Mode=OneWay,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.AllocationTrace.IsRunningToEnd, Mode=OneWay}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">Running</TextBlock>
                </StackPanel>

                <controls:GridSplitter Grid.Row="2"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       ResizeBehavior="PreviousAndNext"
                                       ResizeDirection="Rows"
                                       Background="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <controls:GridSplitter.Template>
                        <ControlTemplate TargetType="controls:GridSplitter">
                            <Grid Background="{TemplateBinding Background}" Height="4" />
                        </ControlTemplate>
                    </controls:GridSplitter.Template>
                </controls:GridSplitter>

                <TabView Grid.Row="3"
                         VerticalAlignment="Stretch"
                         IsAddTabButtonVisible="False"
                         CanReorderTabs="False"
                         TabWidthMode="SizeToContent"
                         CanDragTabs="False">
                    <TabView.TabItems>
                        <TabViewItem Header="Description" IsClosable="False">
                            <accessSteps:SeekDescriptionPanel FontSize="12"
                                                              Strategy="{x:Bind ViewModel.AllocationTrace.SeekDescription, Mode=OneWay}"
                                                              PhysicalOperator="{x:Bind ViewModel.AllocationTrace.PlanNode.PhysicalOperator, Mode=OneWay}"
                                                              LogicalOperator="{x:Bind ViewModel.AllocationTrace.PlanNode.LogicalOperator, Mode=OneWay}"
                                                              IsOrdered="{x:Bind ViewModel.AllocationTrace.PlanNode.ScanInfo.IsOutputOrdered, Mode=OneWay}"
                                                              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"/>
                        </TabViewItem>
                        <TabViewItem Header="Results" IsClosable="False">
                            <index:RecordGrid HideSlotColumn="True"
                                              Records="{x:Bind ViewModel.AllocationTrace.ResultRecords, Mode=OneWay}"
                                              BorderThickness="0" />
                        </TabViewItem>
                        <TabViewItem Header="Strategy" IsClosable="False">
                            <accessSteps:AccessStrategyPanel FontSize="12"
                                                           Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                                           Strategy="{x:Bind ViewModel.AllocationTrace.Strategy, Mode=OneWay}"
                                                           CurrentPhase="{x:Bind ViewModel.AllocationTrace.CurrentPhase, Mode=OneWay}"
                                                           Counters="{x:Bind ViewModel.AllocationTrace.CurrentCounters, Mode=OneWay}"
                                                           IsWalkActive="{x:Bind ViewModel.AllocationTrace.IsWalkInProgress, Mode=OneWay}" />
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
