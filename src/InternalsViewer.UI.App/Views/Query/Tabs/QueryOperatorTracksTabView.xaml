<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.QueryOperatorTracksTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,8,8,0">
            <Button Content="Add" Click="OnAddClick"/>

            <Button Content="Import" Command="{x:Bind ViewModel.OperatorTracks.ImportCommand, Mode=OneWay}"/>

            <Button Content="Export"
                    Command="{x:Bind ViewModel.OperatorTracks.ExportCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.OperatorTracks.HasTracks, Mode=OneWay}"/>

            <Button Content="Clear All"
                    Command="{x:Bind ViewModel.OperatorTracks.ClearCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.OperatorTracks.HasTracks, Mode=OneWay}"/>
        </StackPanel>

        <results:ResultsGridControl x:Name="TracksGrid"
                                    Grid.Row="1"
                                    ResultSet="{x:Bind ViewModel.OperatorTracks.TracksTable, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.OperatorTracks.SelectedTrackRow, Mode=TwoWay}"
                                    RowName="track"/>
    </Grid>
</UserControl>
