<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.QuerySqlTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sqlEditor="using:InternalsViewer.UI.App.Controls.SqlEditor"
    mc:Ignorable="d">
    <sqlEditor:SqlEditorControl x:Name="SqlEditor"
                                IsExecuting="{x:Bind ViewModel.ExecuteQueryCommand.IsRunning, Mode=OneWay}"
                                ExecuteCommand="{x:Bind ViewModel.ExecuteQueryCommand, Mode=OneWay}"
                                CancelCommand="{x:Bind ViewModel.ExecuteQueryCancelCommand, Mode=OneWay}"
                                TraceCommand="{x:Bind ViewModel.OpenTraceCommand, Mode=OneWay}"
                                TrackQuery="{x:Bind ViewModel.TrackQuery, Mode=TwoWay}"
                                History="{x:Bind ViewModel.History, Mode=OneWay}"
                                IsHistoryVisible="{x:Bind ViewModel.IsSqlHistoryVisible, Mode=TwoWay}"
                                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                                IsError="{x:Bind ViewModel.IsError, Mode=OneWay}"
                                Schema="{x:Bind ViewModel.Schema, Mode=OneWay}"
                                ResultSet="{x:Bind ViewModel.ActiveResultSet, Mode=OneWay}"
                                IsResultsVisible="{x:Bind ViewModel.IsSqlResultsVisible, Mode=TwoWay}"
                                IsMessagesVisible="{x:Bind ViewModel.IsSqlMessagesVisible, Mode=TwoWay}"
                                Theme="vs-light">

        <sqlEditor:SqlEditorControl.AdditionalContent>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Padding="8,6">
                <Button Content="Allocations" Click="OnOpenAllocations"/>
                <Button Content="Execution Plan" Click="OnOpenPlan"/>
                <Button Content="Events" Click="OnOpenEvents"/>
            </StackPanel>
        </sqlEditor:SqlEditorControl.AdditionalContent>
    </sqlEditor:SqlEditorControl>
</UserControl>
