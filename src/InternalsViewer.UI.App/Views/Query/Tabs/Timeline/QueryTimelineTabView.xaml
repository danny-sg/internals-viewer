<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Timeline.QueryTimelineTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:timeline="using:InternalsViewer.UI.App.Controls.Timeline"
    mc:Ignorable="d">
    <timeline:EventTimelineControl x:Name="EventTimeline"
                                   VerticalAlignment="Stretch"
                                   HorizontalAlignment="Stretch"
                                   ColourProvider="{x:Bind ViewModel.EventColours, Mode=OneWay}"
                                   ShowLocks="{x:Bind ViewModel.QueryOptions.ShowLocks, Mode=OneWay}"
                                   ShowLatches="{x:Bind ViewModel.QueryOptions.ShowLatches, Mode=OneWay}"
                                   ShowWaits="{x:Bind ViewModel.QueryOptions.ShowWaits, Mode=OneWay}"
                                   Events="{x:Bind ViewModel.FilteredEvents, Mode=OneWay}" />
</UserControl>
