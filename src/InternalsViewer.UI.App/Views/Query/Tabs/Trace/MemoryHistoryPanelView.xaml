<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Trace.MemoryHistoryPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    IsOpen="False"
                    DefaultLabelPosition="Right"
                    OverflowButtonVisibility="Collapsed"
                    HorizontalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    MinHeight="0"
                    Padding="8,0,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <TextBox Width="180"
                         Margin="0,4,0,4"
                         PlaceholderText="Function"
                         Style="{StaticResource FilterTextBoxStyle}"
                         Text="{x:Bind ViewModel.Writes.FunctionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </AppBarElementContainer>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <TextBox Width="170"
                         Margin="6,4,0,4"
                         PlaceholderText="Address"
                         FontFamily="{StaticResource MonospaceFontFamily}"
                         Style="{StaticResource FilterTextBoxStyle}"
                         Text="{x:Bind ViewModel.Writes.AddressFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </AppBarElementContainer>
            <AppBarButton Label="Clear"
                          Margin="4,0,0,0"
                          Click="OnClearClick">
            </AppBarButton>
        </CommandBar>

        <results:ResultsGridControl Grid.Row="1"
                                    ResultSet="{x:Bind ViewModel.Writes.Table, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.Writes.SelectedRow, Mode=TwoWay}"
                                    CellHovered="OnCellHovered"
                                    RowName="write"/>
    </Grid>
</UserControl>
