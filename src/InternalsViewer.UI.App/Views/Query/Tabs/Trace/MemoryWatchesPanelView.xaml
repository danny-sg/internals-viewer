<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Trace.MemoryWatchesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:trace="using:InternalsViewer.UI.App.ViewModels.Query.Trace">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="8,6,8,2"
              ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Label" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="Type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="2" Text="Value" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.WatchList.Rows, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,2,8,2"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="trace:MemoryWatchRowViewModel">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FilterTextBoxStyle}"
                                 PlaceholderText="{x:Bind Range}"
                                 Text="{x:Bind Label, Mode=TwoWay}"/>

                        <ComboBox Grid.Column="1"
                                  FontSize="12"
                                  MinHeight="26"
                                  Padding="8,2,0,2"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Bytes"
                                  ItemsSource="{x:Bind DataTypes, Mode=OneWay}"
                                  SelectedItem="{x:Bind DataType, Mode=TwoWay}"/>

                        <TextBlock Grid.Column="2"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource MonospaceFontFamily}"
                                   Text="{x:Bind Value, Mode=OneWay}"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource TabCommandButtonStyle}"
                                ToolTipService.ToolTip="Clear"
                                Click="{x:Bind Clear}">
                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
