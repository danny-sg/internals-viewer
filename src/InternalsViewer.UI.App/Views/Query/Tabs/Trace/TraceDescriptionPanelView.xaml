<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Trace.TraceDescriptionPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:accessSteps="using:InternalsViewer.UI.App.Controls.Trace.Steps"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    mc:Ignorable="d">

    <StackPanel 
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
        <!--<allocation:AllocationUnitSummaryControl AllocationUnit="{x:Bind ViewModel.AllocationUnit, Mode=OneWay}"
                                                 IsIndex="True" />-->

    <accessSteps:SeekDescriptionPanel FontSize="12"
                                      Strategy="{x:Bind ViewModel.SeekDescription, Mode=OneWay}"
                                      PhysicalOperator="{x:Bind ViewModel.PlanNode.PhysicalOperator, Mode=OneWay}"
                                      LogicalOperator="{x:Bind ViewModel.PlanNode.LogicalOperator, Mode=OneWay}"
                                      IsOrdered="{x:Bind ViewModel.PlanNode.ScanInfo.IsOutputOrdered, Mode=OneWay}"
                                      Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
    </StackPanel>
</UserControl>
