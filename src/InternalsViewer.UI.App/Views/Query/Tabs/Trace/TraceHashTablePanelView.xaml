<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Trace.TraceHashTablePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:trace="using:InternalsViewer.UI.App.Controls.Trace"
    mc:Ignorable="d">

    <trace:HashTableGrid Buckets="{x:Bind ViewModel.HashBuckets, Mode=OneWay}"
                         Columns="{x:Bind ViewModel.HashColumns, Mode=OneWay}"
                         Summary="{x:Bind ViewModel.HashTableSummary, Mode=OneWay}"
                         BucketCount="{x:Bind ViewModel.HashBucketCount, Mode=TwoWay}" />
</UserControl>
