<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Tabs.Trace.TraceTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:allocation="using:InternalsViewer.UI.App.Controls.Allocation"
    xmlns:docking="using:InternalsViewer.UI.App.Controls.Docking"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <CommandBar Grid.Row="0"
                    IsOpen="False"
                    Padding="8,0,0,0"
                    DefaultLabelPosition="Right"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{x:Bind ViewModel.IconSource, Mode=OneWay}"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.PlanNode.PhysicalOperator, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Padding="4,0,8,0" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton Label="Step" Command="{x:Bind ViewModel.StepNextCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B5;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="{x:Bind RunLabel(ViewModel.IsRunning), Mode=OneWay}"
                          Command="{x:Bind ViewModel.RunCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind RunGlyph(ViewModel.IsRunning), Mode=OneWay}" />
                </AppBarButton.Icon>
            </AppBarButton>
    
            <AppBarButton Label="{x:Bind RunToEndLabel(ViewModel.IsRunningToEnd), Mode=OneWay}"
                          Command="{x:Bind ViewModel.RunToEndCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE893;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Reset" Command="{x:Bind ViewModel.ResetStepCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <CommandBar Grid.Row="0"
                    Grid.Column="1"
                    IsOpen="False"
                    Padding="0,0,0,0"
                    DefaultLabelPosition="Right"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
            <AppBarElementContainer VerticalContentAlignment="Center">
                <ToggleButton Margin="4,0,4,0"
                       BorderThickness="0"
                       Width="140"
                       IsChecked="{x:Bind ViewModel.IsResultsVisible, Mode=TwoWay}">
                    <TextBlock Text="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}" VerticalAlignment="Center" />
                </ToggleButton>
            </AppBarElementContainer>
        </CommandBar>

        <docking:DockHost Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Layout="{x:Bind ViewModel.Dock, Mode=OneWay}" />
    </Grid>
</UserControl>
