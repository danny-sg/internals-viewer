<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.MemoryTree.QueryMemoryTreeTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:memoryTree="using:InternalsViewer.UI.App.Models.Query.Trace.MemoryTree">

    <UserControl.Resources>
        <MenuFlyout x:Key="NodeMenu">
            <MenuFlyoutItem Text="Open Memory" Tag="Object" Click="OnOpenMemoryClick"/>
            <MenuFlyoutItem Text="Object Graph" Tag="Object" Click="OnObjectGraphClick"/>
            <MenuFlyoutItem Text="Open Hash Table" Tag="HashTable" Click="OnHashTableClick"/>
        </MenuFlyout>

        <DataTemplate x:Key="NodeTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Background="Transparent"
                        RightTapped="OnNodeRightTapped"
                        ContextFlyout="{StaticResource NodeMenu}">
                <TextBlock Text="{x:Bind ((memoryTree:MemoryTreeNode)Content).Name}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ((memoryTree:MemoryTreeNode)Content).Detail}"
                           FontSize="12"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="NodeItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="8,0,8,0"
              ColumnSpacing="8"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,4,0,4"
                     VerticalAlignment="Center"
                     PlaceholderText="Name or Address"
                     Style="{StaticResource FilterTextBoxStyle}"
                     Text="{x:Bind ViewModel.MemoryTree.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <ToggleButton Grid.Column="1"
                          Content="Stack Objects"
                          Style="{StaticResource TabCommandToggleStyle}"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="Show objects on the stack as well as on the heap"
                          IsChecked="{x:Bind ViewModel.MemoryTree.IsStackVisible, Mode=TwoWay}"/>

            <TextBlock Grid.Column="2"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.MemoryTree.Status, Mode=OneWay}"/>
        </Grid>

        <muxc:TreeView x:Name="ObjectTree"
                       Grid.Row="1"
                       ItemTemplate="{StaticResource NodeTemplate}"
                       ItemContainerStyle="{StaticResource NodeItemStyle}"
                       SelectionMode="Single"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Expanding="OnTreeExpanding"
                       Collapsed="OnTreeCollapsed"
                       ItemInvoked="OnTreeItemInvoked"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollMode="Enabled"/>

        <TextBlock Grid.Row="1"
                   Margin="12,8,12,8"
                   FontSize="12"
                   VerticalAlignment="Top"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   IsHitTestVisible="False"
                   Text="{x:Bind ViewModel.MemoryTree.EmptyText, Mode=OneWay}"/>

        <ProgressRing Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.MemoryTree.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.MemoryTree.IsLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
