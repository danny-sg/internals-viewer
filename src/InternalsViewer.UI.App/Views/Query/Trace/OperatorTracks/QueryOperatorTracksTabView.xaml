<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.OperatorTracks.QueryOperatorTracksTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    IsOpen="False"
                    Padding="8,0,0,0"
                    DefaultLabelPosition="Right"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Top"
                    MinHeight="0"
                    OverflowButtonVisibility="Collapsed"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="Transparent">
            <AppBarButton Label="Add" Icon="Add" Click="OnAddClick"/>

            <AppBarButton Label="Import" Command="{x:Bind ViewModel.OperatorTracks.ImportCommand, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B5;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton Label="Export" Command="{x:Bind ViewModel.OperatorTracks.ExportCommand, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xEDE1;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <AppBarButton Label="Clear Added"
                          Icon="Delete"
                          Command="{x:Bind ViewModel.OperatorTracks.ClearCommand, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.OperatorTracks.HasAddedTracks, Mode=OneWay}"/>

            <AppBarButton Label="Reset Predefined" Command="{x:Bind ViewModel.OperatorTracks.ResetCommand, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7A7;"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <results:ResultsGridControl x:Name="TracksGrid"
                                    Grid.Row="1"
                                    ResultSet="{x:Bind ViewModel.OperatorTracks.TracksTable, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.OperatorTracks.SelectedTrackRow, Mode=TwoWay}"
                                    RowName="rule"/>
    </Grid>
</UserControl>
