<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Summary.QueryTraceSummaryTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:summary="using:InternalsViewer.UI.App.ViewModels.Query.Trace.Summary">

    <UserControl.Resources>
        <DataTemplate x:Key="PaneHeaderTemplate" x:DataType="summary:TraceSummaryPaneViewModel">
            <Border BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="8,8,8,8"
                        CornerRadius="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="{x:Bind Toggle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE70D;"
                                  FontSize="10"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind IsExpanded, Mode=OneWay}"/>

                        <FontIcon Glyph="&#xE76C;"
                                  FontSize="10"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind IsExpanded, Mode=OneWay,
                                               Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Title}"/>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PaneGrid"/>
</UserControl>
