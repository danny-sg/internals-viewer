<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.MemoryDetailsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:models="using:InternalsViewer.UI.App.Models.Query.Trace.Timeline">

    <UserControl.Resources>
        <Style x:Key="DetailNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="12,8,12,8">
        <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" Style="{StaticResource DetailNameStyle}"/>
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{x:Bind ViewModel.Details.Address, Mode=OneWay}"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       Style="{StaticResource DetailValueStyle}"
                       ContextRequested="OnAddressContextRequested"/>
            <controls:CopyButton Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.Address, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" Style="{StaticResource DetailNameStyle}"/>
            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="{x:Bind ViewModel.Details.Type, Mode=OneWay}"
                       Style="{StaticResource DetailValueStyle}"
                       ContextRequested="OnTypeContextRequested"/>
            <controls:CopyButton Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.Type, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Length" Style="{StaticResource DetailNameStyle}"/>
            <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="{x:Bind ViewModel.Details.Length, Mode=OneWay}"
                       Style="{StaticResource DetailValueStyle}"/>
            <controls:CopyButton Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.Length, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lifetime" Style="{StaticResource DetailNameStyle}"/>
            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <HyperlinkButton Content="{x:Bind ViewModel.Details.InitialisedAtText, Mode=OneWay}"
                                 Style="{StaticResource DetailLinkStyle}"
                                 Click="OnInitialisedClick"
                                 ContextRequested="OnInitialisedContextRequested"
                                 PointerEntered="OnInitialisedPointerEntered"
                                 PointerExited="OnMarkPointerExited"/>
                <TextBlock Text="-" Style="{StaticResource DetailValueStyle}"/>
                <HyperlinkButton Content="{x:Bind ViewModel.Details.DestroyedAtText, Mode=OneWay}"
                                 Style="{StaticResource DetailLinkStyle}"
                                 IsEnabled="{x:Bind ViewModel.Details.IsDestroyed, Mode=OneWay}"
                                 Click="OnDestroyedClick"
                                 ContextRequested="OnDestroyedContextRequested"
                                 PointerEntered="OnDestroyedPointerEntered"
                                 PointerExited="OnMarkPointerExited"/>
            </StackPanel>
            <controls:CopyButton Grid.Row="3"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.LifetimeText, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Initialised By" Style="{StaticResource DetailNameStyle}"/>
            <HyperlinkButton Grid.Row="4" Grid.Column="2"
                             HorizontalAlignment="Left"
                             Content="{x:Bind ViewModel.Details.InitialisedBy, Mode=OneWay}"
                             Style="{StaticResource DetailLinkStyle}"
                             Click="OnInitialisedClick"
                             ContextRequested="OnInitialisedByContextRequested"
                             PointerEntered="OnInitialisedPointerEntered"
                             PointerExited="OnMarkPointerExited"/>
            <controls:CopyButton Grid.Row="4"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.InitialisedBy, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Updates" Style="{StaticResource DetailNameStyle}"/>
            <TextBlock Grid.Row="5" Grid.Column="2"
                       Text="{x:Bind ViewModel.Details.UpdateCount, Mode=OneWay}"
                       Style="{StaticResource DetailValueStyle}"/>
            <controls:CopyButton Grid.Row="5"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.UpdateCount, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Updated By" Style="{StaticResource DetailNameStyle}" VerticalAlignment="Top"/>
            <ItemsControl Grid.Row="6" Grid.Column="2" ItemsSource="{x:Bind ViewModel.Details.Writers, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MemoryWriterSummary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Colour, Converter={StaticResource ColorToSolidColorBrushValueConverter}}"/>
                            <HyperlinkButton Content="{x:Bind Label}"
                                             Style="{StaticResource DetailLinkStyle}"
                                             Click="OnWriterClick"
                                             ContextRequested="OnWriterContextRequested"
                                             PointerEntered="OnWriterPointerEntered"
                                             PointerExited="OnWriterPointerExited"/>
                            <TextBlock Text="{x:Bind Count}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:CopyButton Grid.Row="6"
                                 Grid.Column="1"
                                 Style="{StaticResource DetailCopyButtonStyle}"
                                 Tag="{x:Bind ViewModel.Details.WritersText, Mode=OneWay}"
                                 Click="OnCopyValueClick"/>
        </Grid>
    </ScrollViewer>
</UserControl>
