<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.MemoryHistoryPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="8,0,4,0"
              ColumnSpacing="6"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="0,2,0,2"
                     VerticalAlignment="Center"
                     PlaceholderText="Function"
                     Style="{StaticResource FilterTextBoxStyle}"
                     Text="{x:Bind ViewModel.Writes.FunctionFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBox Grid.Column="1"
                     Margin="0,2,0,2"
                     VerticalAlignment="Center"
                     PlaceholderText="Address"
                     FontFamily="{StaticResource MonospaceFontFamily}"
                     Style="{StaticResource FilterTextBoxStyle}"
                     Text="{x:Bind ViewModel.Writes.AddressFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="2"
                    Content="Clear"
                    Style="{StaticResource TabCommandButtonStyle}"
                    Click="OnClearClick"/>
        </Grid>

        <results:ResultsGridControl Grid.Row="1"
                                    ResultSet="{x:Bind ViewModel.Writes.Table, Mode=OneWay}"
                                    SelectedRow="{x:Bind ViewModel.Writes.SelectedRow, Mode=TwoWay}"
                                    CellHovered="OnCellHovered"
                                    CallClicked="OnCallClicked"
                                    CellMenuOpening="OnCellMenuOpening"
                                    SortRequested="OnSortRequested"
                                    RowName="write"/>
    </Grid>
</UserControl>
