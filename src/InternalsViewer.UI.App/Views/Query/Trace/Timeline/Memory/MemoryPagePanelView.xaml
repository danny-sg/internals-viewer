<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.MemoryPagePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InternalsViewer.UI.App.Controls"
    xmlns:page="using:InternalsViewer.UI.App.Controls.Page"
    xmlns:results="using:InternalsViewer.UI.App.Controls.Results">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <page:PageSlotListControl Grid.Column="0"
                                  Margin="8,8,0,8"
                                  Slots="{x:Bind ViewModel.WorkfilePage.Slots, Mode=OneWay}"
                                  SelectedSlot="{x:Bind ViewModel.WorkfilePage.SelectedSlot, Mode=TwoWay}"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabView Grid.Row="0"
                     Margin="8,4,8,0"
                     HorizontalAlignment="Stretch"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent"
                     SelectedIndex="{x:Bind ViewModel.WorkfilePage.SelectedTab, Mode=TwoWay}">
                <TabViewItem IsClosable="False" Header="{x:Bind ViewModel.WorkfilePage.MarkerTabName, Mode=OneWay}"/>
                <TabViewItem IsClosable="False"
                             Header="Data"
                             Visibility="{x:Bind ViewModel.WorkfilePage.IsDataTabVisible, Mode=OneWay}"/>
            </TabView>

            <Grid Grid.Row="1" Margin="8,0,8,8">
                <controls:MarkerTreeView Visibility="{x:Bind GetTabVisibility(ViewModel.WorkfilePage.SelectedTab, 0), Mode=OneWay}"
                                         Markers="{x:Bind ViewModel.WorkfilePage.Markers, Mode=OneWay}"
                                         SelectedMarker="{x:Bind ViewModel.WorkfilePage.SelectedMarker, Mode=TwoWay}"/>

                <results:ResultsGridControl Visibility="{x:Bind GetTabVisibility(ViewModel.WorkfilePage.SelectedTab, 1), Mode=OneWay}"
                                            ResultSet="{x:Bind ViewModel.WorkfilePage.Records, Mode=OneWay}"
                                            SelectedRow="{x:Bind ViewModel.WorkfilePage.SelectedRecordRow, Mode=TwoWay}"
                                            RowName="record"/>
            </Grid>
        </Grid>

        <TextBlock Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.WorkfilePage.EmptyText, Mode=OneWay}"/>

        <ProgressRing Grid.ColumnSpan="2"
                      Canvas.ZIndex="10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.WorkfilePage.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.WorkfilePage.IsLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
