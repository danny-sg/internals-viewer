<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.MemoryReferenceGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:memory="using:InternalsViewer.UI.App.Controls.Query.Trace.Memory"
    xmlns:models="using:InternalsViewer.UI.App.Models.Query.Trace.Timeline">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CommandBar IsOpen="False"
                        DefaultLabelPosition="Right"
                        HorizontalAlignment="Left"
                        Background="Transparent">
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="12,0,18,0">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </AppBarElementContainer>
            </CommandBar>

            <ProgressRing Grid.Column="1"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="2"
                            Width="260"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            PlaceholderText="Search Names and Addresses"
                            QueryIcon="Find"
                            FontSize="12"
                            UpdateTextOnSelect="False"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:MemoryReferenceGraphSearchResult">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Address}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <memory:MemoryReferenceGraphControl x:Name="GraphControl"
                                            Grid.Row="1"
                                            Graph="{x:Bind ViewModel.Graph, Mode=OneWay}"
                                            Progress="{x:Bind ViewModel.Progress, Mode=OneWay}"/>
    </Grid>
</UserControl>
