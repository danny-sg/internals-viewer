<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.MemoryReferencesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:timeline="using:InternalsViewer.UI.App.Models.Query.Trace.Timeline"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <UserControl.Resources>
        <DataTemplate x:Key="ReferenceTemplate" x:DataType="muxc:TreeViewNode">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="{x:Bind ((timeline:MemoryReferenceNode)Content).ValueText}">
                <TextBlock Text="{x:Bind ((timeline:MemoryReferenceNode)Content).OffsetText}"
                           FontSize="12"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <HyperlinkButton Style="{StaticResource DetailLinkStyle}"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Content="{x:Bind ((timeline:MemoryReferenceNode)Content).TargetText}"
                                 IsEnabled="{x:Bind ((timeline:MemoryReferenceNode)Content).CanOpen}"
                                 Click="OnTargetClick"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ReferenceItemStyle" TargetType="muxc:TreeViewItem">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <muxc:TreeView x:Name="ReferenceTree"
                       ItemTemplate="{StaticResource ReferenceTemplate}"
                       ItemContainerStyle="{StaticResource ReferenceItemStyle}"
                       SelectionMode="Single"
                       CanDragItems="False"
                       CanReorderItems="False"
                       Expanding="OnReferenceTreeExpanding"
                       Collapsed="OnReferenceTreeCollapsed"
                       ItemInvoked="OnReferenceTreeItemInvoked"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollMode="Enabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollMode="Enabled"/>

        <TextBlock Text="{x:Bind ViewModel.References.EmptyText, Mode=OneWay}"
                   FontSize="12"
                   Margin="12,8,12,8"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
