<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory.TraceTimelineMemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hexView="using:InternalsViewer.UI.App.Controls.HexView"
    xmlns:local="using:InternalsViewer.UI.App.Views.Query.Trace.Timeline.Memory"
    SizeChanged="OnSizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HexColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Padding="12,8"
                    Orientation="Horizontal"
                    Spacing="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{x:Bind ViewModel.IsHashTableVisible, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="Hash Table"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"/>
            <HyperlinkButton Content="{x:Bind ViewModel.HashTableText, Mode=OneWay}"
                             FontSize="12"
                             FontFamily="{StaticResource MonospaceFontFamily}"
                             Style="{StaticResource DetailLinkStyle}"
                             VerticalAlignment="Center"
                             ToolTipService.ToolTip="Open Hash Table"
                             Click="OnHashTableClick"/>
            <TextBlock Text="{x:Bind ViewModel.HashTablePartText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <hexView:HexViewControl Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
                                Data="{x:Bind ViewModel.Data, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.Markers, Mode=OneWay}"
                                Links="{x:Bind ViewModel.Links, Mode=OneWay}"
                                Watches="{x:Bind ViewModel.Watches, Mode=TwoWay}"
                                SelectedChangeSpan="{x:Bind ViewModel.SelectedChangeSpan, Mode=OneWay}"
                                ScrollToOffset="{x:Bind ViewModel.ScrollToOffset, Mode=OneWay}"
                                IsChangeNavigationEnabled="True"
                                ChangeNavigationRequested="OnChangeNavigationRequested"
                                OffsetClicked="OnOffsetClicked"/>

        <Grid x:Name="Details"
              Grid.Row="1"
              Grid.Column="1"
              Visibility="Collapsed">

            <TabView VerticalAlignment="Stretch"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent"
                     SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}">
                <TabViewItem Header="Details" IsClosable="False">
                    <local:MemoryDetailsPanelView/>
                </TabViewItem>
                <TabViewItem Header="Writes" IsClosable="False">
                    <local:MemoryWritesPanelView/>
                </TabViewItem>
                <TabViewItem Header="Reads" IsClosable="False">
                    <local:MemoryReadsPanelView/>
                </TabViewItem>
                <TabViewItem Header="Watches" IsClosable="False">
                    <local:MemoryWatchesPanelView/>
                </TabViewItem>
                <TabViewItem Header="References" IsClosable="False">
                    <local:MemoryReferencesPanelView/>
                </TabViewItem>
                <TabViewItem Header="BUF"
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.Buffer.IsAvailable, Mode=OneWay}">
                    <local:MemoryBufferPanelView/>
                </TabViewItem>
                <TabViewItem Header="{x:Bind ViewModel.Batch.Title, Mode=OneWay}"
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.Batch.IsAvailable, Mode=OneWay}">
                    <local:MemoryBatchPartPanelView/>
                </TabViewItem>
                <TabViewItem Header="Vectors"
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.Batch.IsVectorsAvailable, Mode=OneWay}">
                    <local:MemoryBatchPanelView/>
                </TabViewItem>
                <TabViewItem Header="{x:Bind ViewModel.WorkfilePage.Title, Mode=OneWay}"
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.WorkfilePage.IsAvailable, Mode=OneWay}">
                    <local:MemoryPagePanelView DataContext="{x:Bind ViewModel.WorkfilePage, Mode=OneWay}"/>
                </TabViewItem>
                <TabViewItem Header="Bindings"
                             IsClosable="False"
                             Visibility="{x:Bind ViewModel.Bindings.IsAvailable, Mode=OneWay}">
                    <local:MemoryBindingsPanelView/>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</UserControl>
