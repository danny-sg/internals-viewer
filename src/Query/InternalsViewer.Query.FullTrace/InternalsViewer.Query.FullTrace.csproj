<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InternalsViewer.Query\InternalsViewer.Query.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
        <InternalsVisibleTo Include="InternalsViewer.Mcp" />
        <InternalsVisibleTo Include="InternalsViewer.Mcp.Tests" />
        <InternalsVisibleTo Include="InternalsViewer.Query.FullTrace.InstructionHistory" />
    </ItemGroup>

    <ItemGroup>
        <!-- Callstack category mappings: the core file ships embedded with the app (a downloadable update file may
             override it from the user's app-data folder later). Matched by file name at load, not by resource path. -->
        <EmbeddedResource Include="Symbols\Categories\Mappings\*.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\runtimes\win-x64\native\*.*">
            <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
