<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
        <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\InternalsViewer.Internals\InternalsViewer.Internals.csproj" />
        <ProjectReference Include="..\..\InternalsViewer.TransactionLog\InternalsViewer.TransactionLog.csproj" />
        <ProjectReference Include="..\..\InternalsViewer.Execution\InternalsViewer.Execution.csproj" />
        <ProjectReference Include="..\InternalsViewer.Query.SourceGenerators\InternalsViewer.Query.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
        <InternalsVisibleTo Include="$(AssemblyName).FullTrace" />
        <InternalsVisibleTo Include="$(AssemblyName).FullTrace.Tests" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Locks\**" />
      <EmbeddedResource Remove="Locks\**" />
      <None Remove="Locks\**" />
    </ItemGroup>

</Project>
